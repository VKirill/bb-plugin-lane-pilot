{
  "id": "lp.jev-labels",
  "startedBy": "jev-labels-nightly",
  "name": {
    "en": "Nightly Jev judge labeling",
    "ru": "Ночная разметка судей Jev"
  },
  "description": {
    "en": "Writes labels onto Jev judgment receipts: outcome labels from the pipeline's own later truth, then model labels where a second judge of another family re-answers sampled receipts blind. Ends with the labels receipt line.",
    "ru": "Проставляет метки на квитанции судей Jev: метки исходов по поздней истине конвейера, затем метки модели — второй судья другого семейства отвечает на выборку квитанций вслепую. Завершается строкой-отчётом о метках."
  },
  "status": "published",
  "tags": [
    "jev",
    "night",
    "labels"
  ],
  "triggers": [
    "manual",
    "schedule"
  ],
  "inputs": {
    "project_id": {
      "type": "string",
      "default": "*"
    }
  },
  "outputs": {
    "status": "string",
    "summary": "string"
  },
  "budget": {
    "max_minutes": 60
  },
  "nodes": [
    {
      "id": "outcome",
      "type": "action",
      "action": "lp.jev_labels_outcome",
      "title": {
        "en": "Write outcome labels from pipeline truth",
        "ru": "Проставить метки исходов по истине конвейера"
      },
      "out": {
        "status": "string",
        "counts": "object",
        "labeled": "int"
      },
      "guards": {
        "timeoutMin": 10
      }
    },
    {
      "id": "model",
      "type": "action",
      "action": "lp.jev_labels_model",
      "title": {
        "en": "Relabel sampled receipts with a second judge",
        "ru": "Переразметить выборку квитанций вторым судьёй"
      },
      "out": {
        "status": "string",
        "results": "array",
        "labeled": "int"
      },
      "guards": {
        "timeoutMin": 50
      }
    },
    {
      "id": "report",
      "type": "action",
      "action": "lp.jev_labels_report",
      "title": {
        "en": "Write the labels receipt line",
        "ru": "Записать строку-отчёт о метках"
      },
      "out": {
        "status": "string",
        "summary": "string",
        "judgments_at_50": "int"
      },
      "guards": {
        "timeoutMin": 5
      }
    },
    {
      "id": "done",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "report.status",
        "summary": "report.summary"
      }
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "outcome"
    },
    {
      "from": "outcome",
      "to": "model"
    },
    {
      "from": "model",
      "to": "report"
    },
    {
      "from": "report",
      "to": "done"
    }
  ],
  "test": {
    "id": "jev-labels-1",
    "sim": {
      "input": {
        "project_id": "*"
      },
      "stubs": {
        "outcome": {
          "status": "done",
          "counts": { "critique.screen": 2 },
          "labeled": 2
        },
        "model": {
          "status": "done",
          "results": [],
          "labeled": 1
        },
        "report": {
          "status": "done",
          "summary": "labels: 2 outcome, 1 model, 0 judgments now ≥ 50 labels",
          "judgments_at_50": 0
        }
      },
      "expect_path": [
        "outcome",
        "model",
        "report",
        "done"
      ],
      "expect_output": {
        "status": "done"
      }
    },
    "live": "the jev-labels-nightly cron (03:45 UTC), or a manual run of lp.jev-labels"
  },
  "goal_check": "artifact"
}
