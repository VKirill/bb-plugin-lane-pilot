{
  "compilerOptions": {
    "strict": true,
    "isolatedModules": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./*"],
      // node_modules is a symlink to the main checkout in worktrees; pin workspace packages edited across branches so new exports typecheck before merge.
      "@lane-pilot/contracts": ["./packages/contracts/src/index.ts"],
      "@lane-pilot/i18n": ["./packages/i18n/src/index.ts"],
      "@lane-pilot/memory-core": ["./packages/memory-core/src/index.ts"],
      "@lane-pilot/settings-catalog": ["./packages/settings-catalog/src/index.ts"],
      "@lane-pilot/workflow-engine": ["./packages/workflow-engine/src/index.ts"],
      "@lane-pilot/workflow-engine/ui": ["./packages/workflow-engine/src/ui.ts"],
      "elkjs/lib/elk.bundled.js": ["./src/rooms/workflow/ui/elk-shim.d.ts"]
    },
    "noEmit": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "skipLibCheck": false
  },
  "include": ["server.ts", "host.ts", "app.tsx", "src", "tests", "packages", "scripts/lp_drill/scenes"]
}
