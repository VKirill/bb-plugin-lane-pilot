{
  "id": "spike",
  "name": {
    "en": "Spike (time-boxed experiment)",
    "ru": "Спайк (эксперимент с рамкой)"
  },
  "description": {
    "en": "Answers one technical question by a throw-away experiment inside a time box: the question, the experiment, the result and the decision in .agents/planning/spikes/; a finished spike can be wrapped into a skill draft.",
    "ru": "Отвечает на один технический вопрос одноразовым экспериментом в рамке времени: вопрос, опыт, результат и решение в .agents/planning/spikes/; готовый спайк можно свернуть в черновик скилла."
  },
  "examples": {
    "ru": [
      "Сделай спайк: потянет ли SQLite такой поиск",
      "Проверь быстро, работает ли этот подход, код выкинем",
      "Эксперимент на час: ленивая загрузка фото",
      "Спайк и потом сверни его в скилл"
    ],
    "en": [
      "Spike: can SQLite handle this search",
      "Quickly check if this approach works, throw the code away",
      "One-hour experiment: lazy photo loading",
      "Spike it and wrap it into a skill"
    ]
  },
  "not_for": [
    "analyze-code",
    "debug"
  ],
  "status": "published",
  "inputs": {
    "question": {
      "type": "string",
      "required": true
    },
    "box_minutes": {
      "type": "int",
      "default": 60
    },
    "wrap_skill": {
      "type": "string"
    }
  },
  "outputs": {
    "status": "answered|inconclusive",
    "decision": "string",
    "spike_path": "string",
    "skill_draft": "string",
    "skill_path": "string"
  },
  "quality_mode": {
    "default": "standard"
  },
  "requires": {
    "plugins": [
      "lane-pilot"
    ]
  },
  "budget": {
    "max_minutes": 120
  },
  "entry": "spike_new",
  "nodes": [
    {
      "id": "spike_new",
      "type": "action",
      "action": "lp.spike_new",
      "title": {
        "en": "Open the spike file",
        "ru": "Открыть файл спайка"
      },
      "params": {
        "question": "{{$inputs.question}}"
      },
      "out": {
        "spike_path": "string"
      }
    },
    {
      "id": "experiment",
      "type": "agent",
      "role": "analyst",
      "title": {
        "en": "Experiment",
        "ru": "Эксперимент"
      },
      "prompt": "Inside the time box: the smallest experiment that answers the question, in a throwaway copy (never the project's main code). The spike file {{spike_new.spike_path}} is already open with the question — return the result and the decision in document; the code-owned writer appends it to that file. If wrap_skill is given and the decision is made, return skill_draft too — the raw SKILL.md the code-owned writer persists under .agents/forge/skills/. This read-only helper does not write files and runs no lane-plan commands.",
      "out": {
        "answered": "bool",
        "decision": "string",
        "document": "string",
        "skill_draft": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 90
      },
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ]
    },
    {
      "id": "answered",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "answered",
        "decision": "experiment.decision",
        "spike_path": "write_spike.spike_path",
        "skill_draft": "experiment.skill_draft",
        "skill_path": "write_skill.skill_path"
      }
    },
    {
      "id": "inconclusive",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "inconclusive",
        "decision": "experiment.decision",
        "spike_path": "write_spike.spike_path",
        "skill_draft": "''",
        "skill_path": "''"
      }
    },
    {
      "id": "goal_check",
      "type": "action",
      "action": "deliverable.validate",
      "title": {
        "en": "Check the goal was met",
        "ru": "Проверить, что цель достигнута"
      },
      "rule": "validateDeliverable on the artifact the run produced: the deliverable/validator/brief inputs name what to check; a fail means the goal is not met",
      "out": {
        "ok": "bool",
        "verdict": "pass|rework|fail",
        "reason": "string",
        "details": "object"
      }
    },
    {
      "id": "write_spike",
      "type": "action",
      "action": "fs.write",
      "params": {
        "path": "{{spike_new.spike_path}}",
        "contents": "{{experiment.document}}",
        "mode": "append"
      },
      "out": {
        "spike_path": "string"
      },
      "title": {
        "en": "Write the spike file",
        "ru": "Записать файл спайка"
      },
      "skip_when": "!experiment.document",
      "skip_out": {
        "spike_path": "{{spike_new.spike_path}}"
      }
    },
    {
      "id": "skill_dir",
      "type": "action",
      "action": "lp.doc_path",
      "params": {
        "dir": ".agents/forge/skills",
        "doc": "{{$inputs.wrap_skill}}"
      },
      "out": {
        "path": "string"
      },
      "title": {
        "en": "Validate the wrap-skill folder",
        "ru": "Проверить папку навыка"
      },
      "skip_when": "!$inputs.wrap_skill",
      "skip_out": {
        "path": ""
      }
    },
    {
      "id": "write_skill",
      "type": "action",
      "action": "fs.write",
      "title": {
        "en": "Persist the skill draft",
        "ru": "Сохранить черновик скилла"
      },
      "params": {
        "path": "{{skill_dir.path}}/SKILL.md",
        "contents": "{{experiment.skill_draft}}",
        "mode": "non_overwrite"
      },
      "out": {
        "skill_path": "string"
      },
      "skip_when": "!experiment.answered || !experiment.skill_draft || !$inputs.wrap_skill",
      "skip_out": {
        "skill_path": ""
      }
    }
  ],
  "edges": [
    {
      "from": "spike_new",
      "to": "experiment"
    },
    {
      "from": "experiment",
      "to": "write_spike",
      "pass": "artifact"
    },
    {
      "from": "write_spike",
      "to": "skill_dir"
    },
    {
      "from": "write_skill",
      "to": "goal_check",
      "pass": "artifact",
      "when": "experiment.answered",
      "with": {
        "path": "write_spike.spike_path"
      }
    },
    {
      "from": "write_skill",
      "to": "inconclusive",
      "pass": "artifact"
    },
    {
      "from": "goal_check",
      "to": "answered",
      "when": "goal_check.ok != false"
    },
    {
      "from": "goal_check",
      "to": "inconclusive"
    },
    {
      "from": "skill_dir",
      "to": "write_skill"
    }
  ],
  "test": {
    "id": "sp-1",
    "sim": {
      "input": {
        "question": "can sqlite fts handle 1M rows"
      },
      "stubs": {
        "experiment": {
          "answered": true,
          "decision": "yes",
          "document": "# SPIKE\n",
          "skill_draft": ""
        },
        "spike_new": {
          "spike_path": ".agents/planning/spikes/can-sqlite-fts-handle-1m-rows-2026-01-01.md"
        },
        "write_skill": {
          "skill_path": ""
        }
      },
      "expect_path": [
        "spike_new",
        "experiment",
        "write_spike",
        "skill_dir",
        "write_skill",
        "goal_check",
        "answered"
      ],
      "expect_outputs": [
        "status == 'answered'"
      ]
    }
  },
  "goal_check": "validate"
}
