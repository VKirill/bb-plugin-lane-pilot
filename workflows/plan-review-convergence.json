{
  "id": "plan-review-convergence",
  "name": {
    "en": "Plan review convergence",
    "ru": "Сходимость ревью плана"
  },
  "description": {
    "en": "Reviews a plan with two critics of different models, merges their findings, and repeats up to three rounds until both approve or the rounds run out; the phase driver gets the converged decision.",
    "ru": "Ревьюит план двумя критиками разных моделей, сводит их находки и повторяет до трёх раундов, пока оба не одобрят или раунды не кончатся; водитель фазы получает сошедшееся решение."
  },
  "examples": {
    "ru": [
      "Пусть две модели проверят план до согласия",
      "Сходимость ревью плана фазы",
      "Проверь план внешними ИИ",
      "Ревью плана в несколько раундов"
    ],
    "en": [
      "Have two models review the plan until they agree",
      "Converge the phase plan review",
      "Bounce the plan off external AIs",
      "Multi-round plan review"
    ]
  },
  "not_for": [
    "grill-plan",
    "plan-only"
  ],
  "status": "published",
  "inputs": {
    "phase_id": {
      "type": "string",
      "required": true
    },
    "machine": {
      "type": "boolean"
    }
  },
  "outputs": {
    "status": "approve|changes_requested",
    "findings": "Finding[]",
    "rounds": "int"
  },
  "quality_mode": {
    "default": "standard"
  },
  "requires": {
    "plugins": [
      "lane-pilot"
    ]
  },
  "budget": {
    "max_minutes": 60
  },
  "entry": "phase_status",
  "nodes": [
    {
      "id": "phase_status",
      "type": "action",
      "action": "lp.phase_status",
      "out": {
        "status": "any"
      }
    },
    {
      "id": "proof",
      "type": "subworkflow",
      "workflow": "plan-review-convergence-proof",
      "inputs": {
        "phase_id": "$inputs.phase_id",
        "plan_sha": "{{phase_status.status.plan.sha}}",
        "phase_status": "{{phase_status.status}}"
      },
      "out": {
        "decision": "string",
        "findings": "Finding[]",
        "rounds": "int",
        "plan_sha": "string",
        "plan_verdict": "string",
        "status": "string"
      }
    },
    {
      "id": "approve",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "approve",
        "findings": "proof.findings",
        "rounds": "proof.rounds"
      }
    },
    {
      "id": "phase_check",
      "type": "action",
      "action": "lp.phase_plan_check",
      "skip_when": "$inputs.machine == true",
      "skip_out": {
        "status": "skipped",
        "phase_id": "$inputs.phase_id",
        "decision": "machine"
      },
      "out": {
        "status": "string",
        "phase_id": "string",
        "decision": "string"
      }
    },
    {
      "id": "changes",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "changes_requested",
        "findings": "proof.findings",
        "rounds": "proof.rounds"
      }
    }
  ],
  "edges": [
    {
      "from": "phase_status",
      "to": "proof",
      "pass": "artifact"
    },
    {
      "from": "proof",
      "to": "phase_check",
      "pass": "artifact"
    },
    {
      "from": "phase_check",
      "to": "approve",
      "pass": "artifact",
      "when": "proof.decision == 'approve'"
    },
    {
      "from": "phase_check",
      "to": "changes",
      "pass": "artifact"
    }
  ],
  "test": {
    "id": "prc-1",
    "sim": {
      "input": {
        "phase_id": "ph_sample01"
      },
      "stubs": {
        "proof": {
          "decision": "approve",
          "findings": [],
          "rounds": 1,
          "plan_sha": "stub",
          "plan_verdict": "pass",
          "status": "ok"
        }
      },
      "expect_path": [
        "phase_status",
        "proof",
        "phase_check",
        "approve"
      ],
      "expect_outputs": [
        "status == 'approve'"
      ]
    }
  },
  "goal_check": "artifact"
}
