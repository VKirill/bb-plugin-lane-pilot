{
  "id": "lp.graph-evolve-nightly",
  "name": {
    "en": "Nightly workflow graph evolution",
    "ru": "Ночная эволюция графов воркфлоу"
  },
  "description": {
    "en": "Collects daily Pilot digests, errand episode clusters, and unprocessed trajectory deltas, runs a 4-model evolution pipeline (planner -> plan-critic -> workflow-architect -> auditor), validates and stub-tests subworkflow suites in topological order, and auto-publishes minor patches or approved suites.",
    "ru": "Собирает дневные разборы чатов, кластеры эпизодов и необработанные траекторные дельты, запускает 4-модельный конвейер эволюции (planner -> plan-critic -> workflow-architect -> auditor), валидирует и прогоняет симуляции сьютов в топологическом порядке и автопубликует минорные патчи или одобренные сьюты."
  },
  "examples": {
    "en": [
      "Run nightly workflow evolution on project trajectories"
    ],
    "ru": [
      "Запусти эволюцию графов воркфлоу по чатам проекта"
    ]
  },
  "not_for": [
    "general coding tasks",
    "ordinary PM chat routing — started by nightly cron or explicit workflow_run"
  ],
  "status": "published",
  "tags": [
    "night",
    "graph-evolve",
    "workflows"
  ],
  "triggers": [
    "manual",
    "schedule"
  ],
  "inputs": {
    "project_id": {
      "type": "string",
      "default": "",
      "description": "Optional project ID filter (empty = all active projects)"
    },
    "lookback_days": {
      "type": "int",
      "default": 1,
      "description": "Lookback window in days for chat/episode digestion (1..90)"
    },
    "publish_approved_suite": {
      "type": "bool",
      "default": false,
      "description": "Publish auditor-approved and sim-tested suite immediately to global workflows"
    }
  },
  "outputs": {
    "status": "done|empty|noop|held",
    "publishedCount": "int",
    "proposedCount": "int",
    "rejectedCount": "int",
    "summary": "string"
  },
  "budget": {
    "max_minutes": 60
  },
  "goal_audit": "exempt",
  "goal_check": "artifact",
  "nodes": [
    {
      "id": "digest",
      "type": "action",
      "action": "lp.graph_evolve_digest",
      "title": {
        "en": "Digest daily Pilot chats and outcomes",
        "ru": "Разобрать дневные чаты и исходы Пилота"
      },
      "out": {
        "status": "done",
        "picked": "int",
        "digested": "int",
        "deltasRecorded": "int",
        "skipped": "int",
        "failed": "int"
      },
      "guards": {
        "timeoutMin": 20
      }
    },
    {
      "id": "collect",
      "type": "action",
      "action": "lp.graph_evolve_collect",
      "title": {
        "en": "Collect clusters and trajectory deltas",
        "ru": "Собрать кластеры и траекторные дельты"
      },
      "out": {
        "status": "ready|empty",
        "clustersCount": "int",
        "deltasCount": "int",
        "payload_json": "string"
      },
      "guards": {
        "timeoutMin": 10
      }
    },
    {
      "id": "empty_done",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "empty",
        "publishedCount": 0,
        "proposedCount": 0,
        "rejectedCount": 0,
        "summary": "'graph-evolve: nothing to process'"
      }
    },
    {
      "id": "plan_blueprint",
      "type": "action",
      "action": "lp.graph_evolve_plan",
      "title": {
        "en": "Plan process evolution blueprint",
        "ru": "Спланировать чертёж эволюции процесса"
      },
      "out": {
        "decision": "noop|minor_patch|suite_or_structural",
        "graphsCount": "int",
        "blueprint_json": "string"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 15
      }
    },
    {
      "id": "noop_done",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "noop",
        "publishedCount": 0,
        "proposedCount": 0,
        "rejectedCount": 0,
        "summary": "'graph-evolve: planner decided noop'"
      }
    },
    {
      "id": "critique_plan",
      "type": "action",
      "action": "lp.graph_evolve_critique",
      "title": {
        "en": "Critique evolution blueprint",
        "ru": "Проверить чертёж эволюции критиком"
      },
      "out": {
        "verdict": "pass|rework",
        "mustFixCount": "int",
        "critique_json": "string"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 10
      }
    },
    {
      "id": "synthesize",
      "type": "action",
      "action": "lp.graph_evolve_synthesize",
      "title": {
        "en": "Synthesize universal graph candidates",
        "ru": "Синтезировать кандидатов универсальных графов"
      },
      "out": {
        "candidatesCount": "int",
        "candidates_json": "string"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 25
      }
    },
    {
      "id": "audit_suite",
      "type": "action",
      "action": "lp.graph_evolve_audit",
      "title": {
        "en": "Audit synthesized workflow suite",
        "ru": "Аудит синтезированного сьюта графов"
      },
      "out": {
        "verdict": "pass|rework",
        "mustFixCount": "int",
        "audit_json": "string"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 10
      }
    },
    {
      "id": "apply",
      "type": "action",
      "action": "lp.graph_evolve_apply",
      "title": {
        "en": "De-projectize, test and apply candidates",
        "ru": "Депроектизировать, протестировать и применить кандидатов"
      },
      "out": {
        "status": "done|held",
        "publishedCount": "int",
        "proposedCount": "int",
        "rejectedCount": "int",
        "summary": "string"
      },
      "guards": {
        "timeoutMin": 20
      }
    },
    {
      "id": "done",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "apply.status",
        "publishedCount": "apply.publishedCount",
        "proposedCount": "apply.proposedCount",
        "rejectedCount": "apply.rejectedCount",
        "summary": "apply.summary"
      }
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "digest"
    },
    {
      "from": "digest",
      "to": "collect"
    },
    {
      "from": "collect",
      "to": "empty_done",
      "when": "collect.status == 'empty'"
    },
    {
      "from": "collect",
      "to": "plan_blueprint"
    },
    {
      "from": "plan_blueprint",
      "to": "noop_done",
      "when": "plan_blueprint.decision == 'noop'"
    },
    {
      "from": "plan_blueprint",
      "to": "critique_plan"
    },
    {
      "from": "critique_plan",
      "to": "plan_blueprint",
      "when": "critique_plan.verdict == 'rework' && visits('plan_blueprint') < 2"
    },
    {
      "from": "critique_plan",
      "to": "synthesize"
    },
    {
      "from": "synthesize",
      "to": "audit_suite"
    },
    {
      "from": "audit_suite",
      "to": "synthesize",
      "when": "audit_suite.verdict == 'rework' && visits('synthesize') < 2"
    },
    {
      "from": "audit_suite",
      "to": "apply"
    },
    {
      "from": "apply",
      "to": "done"
    }
  ],
  "test": {
    "id": "graph-evolve-1",
    "sim": {
      "input": {},
      "stubs": {
        "digest": {
          "status": "done",
          "picked": 2,
          "digested": 2,
          "deltasRecorded": 1,
          "skipped": 0,
          "failed": 0
        },
        "collect": {
          "status": "ready",
          "clustersCount": 2,
          "deltasCount": 3,
          "payload_json": "{\"status\":\"ready\"}"
        },
        "plan_blueprint": {
          "decision": "suite_or_structural",
          "graphsCount": 2,
          "blueprint_json": "{\"decision\":\"suite_or_structural\"}"
        },
        "critique_plan": {
          "verdict": "pass",
          "mustFixCount": 0,
          "critique_json": "{\"verdict\":\"pass\",\"findings\":[],\"mustFix\":[]}"
        },
        "synthesize": {
          "candidatesCount": 2,
          "candidates_json": "[{\"workflowId\":\"universal-phase-1\"},{\"workflowId\":\"universal-orchestrator\"}]"
        },
        "audit_suite": {
          "verdict": "pass",
          "mustFixCount": 0,
          "audit_json": "{\"verdict\":\"pass\",\"findings\":[],\"mustFix\":[]}"
        },
        "apply": {
          "status": "done",
          "publishedCount": 2,
          "proposedCount": 0,
          "rejectedCount": 0,
          "summary": "graph-evolve: 2 auto-published, 0 proposed, 0 rejected"
        }
      },
      "expect_path": [
        "digest",
        "collect",
        "plan_blueprint",
        "critique_plan",
        "synthesize",
        "audit_suite",
        "apply",
        "done"
      ],
      "expect_output": {
        "status": "done",
        "publishedCount": 2,
        "proposedCount": 0,
        "rejectedCount": 0,
        "summary": "graph-evolve: 2 auto-published, 0 proposed, 0 rejected"
      },
      "variant_empty": {
        "stubs": {
          "digest": {
            "status": "done",
            "picked": 0,
            "digested": 0,
            "deltasRecorded": 0,
            "skipped": 0,
            "failed": 0
          },
          "collect": {
            "status": "empty",
            "clustersCount": 0,
            "deltasCount": 0,
            "payload_json": "{\"status\":\"empty\"}"
          }
        },
        "expect_path": [
          "digest",
          "collect",
          "empty_done"
        ],
        "expect_output": {
          "status": "empty",
          "publishedCount": 0,
          "proposedCount": 0,
          "rejectedCount": 0,
          "summary": "graph-evolve: nothing to process"
        }
      },
      "variant_noop": {
        "stubs": {
          "plan_blueprint": {
            "decision": "noop",
            "graphsCount": 0,
            "blueprint_json": "{\"decision\":\"noop\",\"graphs\":[]}"
          }
        },
        "expect_path": [
          "digest",
          "collect",
          "plan_blueprint",
          "noop_done"
        ],
        "expect_output": {
          "status": "noop",
          "publishedCount": 0,
          "proposedCount": 0,
          "rejectedCount": 0,
          "summary": "graph-evolve: planner decided noop"
        }
      },
      "variant_rework": {
        "stubs": {
          "critique_plan": [
            {
              "verdict": "rework",
              "mustFixCount": 1,
              "critique_json": "{\"verdict\":\"rework\",\"findings\":[\"missing gate\"],\"mustFix\":[\"add gate\"]}"
            },
            {
              "verdict": "pass",
              "mustFixCount": 0,
              "critique_json": "{\"verdict\":\"pass\",\"findings\":[],\"mustFix\":[]}"
            }
          ],
          "audit_suite": [
            {
              "verdict": "rework",
              "mustFixCount": 1,
              "audit_json": "{\"verdict\":\"rework\",\"findings\":[\"missing mcp\"],\"mustFix\":[\"add metamcp\"]}"
            },
            {
              "verdict": "pass",
              "mustFixCount": 0,
              "audit_json": "{\"verdict\":\"pass\",\"findings\":[],\"mustFix\":[]}"
            }
          ]
        },
        "expect_path": [
          "digest",
          "collect",
          "plan_blueprint",
          "critique_plan",
          "plan_blueprint",
          "critique_plan",
          "synthesize",
          "audit_suite",
          "synthesize",
          "audit_suite",
          "apply",
          "done"
        ],
        "expect_output": {
          "status": "done",
          "publishedCount": 2,
          "proposedCount": 0,
          "rejectedCount": 0,
          "summary": "graph-evolve: 2 auto-published, 0 proposed, 0 rejected"
        }
      },
      "variant_held": {
        "stubs": {
          "synthesize": {
            "candidatesCount": 1,
            "candidates_json": "[{\"workflowId\":\"rejected-candidate\"}]"
          },
          "apply": {
            "status": "held",
            "publishedCount": 0,
            "proposedCount": 0,
            "rejectedCount": 1,
            "summary": "graph-evolve: 0 auto-published, 0 proposed, 1 rejected"
          }
        },
        "expect_path": [
          "digest",
          "collect",
          "plan_blueprint",
          "critique_plan",
          "synthesize",
          "audit_suite",
          "apply",
          "done"
        ],
        "expect_output": {
          "status": "held",
          "publishedCount": 0,
          "proposedCount": 0,
          "rejectedCount": 1,
          "summary": "graph-evolve: 0 auto-published, 0 proposed, 1 rejected"
        }
      }
    },
    "live": "the graph-evolve-nightly cron (04:50 UTC), or a manual run of lp.graph-evolve-nightly"
  }
}
