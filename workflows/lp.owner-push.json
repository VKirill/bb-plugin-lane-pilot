{
  "id": "lp.owner-push",
  "startedBy": "owner-push",
  "name": {
    "en": "Owner Waiting Telegram Push",
    "ru": "Уведомления владельцу в Telegram"
  },
  "description": {
    "en": "Scheduled service workflow that collects unannounced wake items from the owner-waiting queue and delivers them to the owner's Telegram topic.",
    "ru": "Регулярный сервисный граф для рассылки новых срочных вопросов «Ждут владельца» в Telegram-топик владельца с отметкой доставленных ключей."
  },
  "category": "service",
  "status": "published",
  "version": 1,
  "tags": [
    "schedule",
    "telegram",
    "owner-waiting"
  ],
  "triggers": [
    {
      "type": "manual"
    }
  ],
  "scope": {
    "level": "builtin"
  },
  "outputs": {
    "sent": "boolean",
    "reason": "string"
  },
  "goal_audit": "exempt",
  "budget": {
    "max_minutes": 5,
    "max_usd": 0.01
  },
  "guards": {
    "maxSteps": 4,
    "maxFanOut": 1
  },
  "nodes": [
    {
      "id": "push",
      "type": "action",
      "label": "Deliver unannounced wake items to Telegram",
      "uses": "lp.owner_push",
      "timeoutSec": 120,
      "output": [
        {
          "name": "sent",
          "type": "boolean"
        },
        {
          "name": "reason",
          "type": "string",
          "required": false
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "push"
    },
    {
      "from": "push",
      "to": "end",
      "with": {
        "sent": "push.sent",
        "reason": "push.reason"
      }
    }
  ]
}
