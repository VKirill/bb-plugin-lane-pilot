{
  "id": "debug",
  "name": {
    "en": "Debug (diagnosis only)",
    "ru": "Отладка (только диагноз)"
  },
  "description": {
    "en": "Finds the root cause of a failure by the scientific method - hypotheses with predictions, evidence log, backward tracing, at most 3 refuted hypotheses - and returns the diagnosis and fix directions without touching the code.",
    "ru": "Находит корневую причину сбоя научным методом - гипотезы с предсказаниями, журнал улик, обратная трассировка, не более 3 опровергнутых гипотез - и возвращает диагноз и направления починки, не трогая код."
  },
  "examples": {
    "ru": [
      "Почему падает импорт CSV? Найди причину, ничего не меняй",
      "Разберись, откуда утечка памяти, диагноз без правок",
      "Тесты нестабильно падают раз в пару запусков, найди первопричину",
      "Приложение зависает при сохранении, выясни почему",
      "Найди корневую причину ошибки 500 на странице заказа",
      "Что сломалось после последнего деплоя? Нужна причина, а не заплатка"
    ],
    "en": [
      "Why does the CSV import crash? Find the cause, don't change anything",
      "Figure out where the memory leak comes from, diagnosis only",
      "Tests fail intermittently every few runs, find the root cause",
      "The app freezes on save, find out why",
      "Find the root cause of the 500 error on the order page",
      "What broke after the last deploy? I need the cause, not a patch"
    ]
  },
  "not_for": [
    "issue-quick",
    "analyze-plan-execute",
    "review-fix"
  ],
  "status": "published",
  "tags": [
    "code",
    "diagnosis"
  ],
  "inputs": {
    "symptom": {
      "type": "string|Finding[]",
      "note": "что ожидалось / что случилось / ошибка / с какого момента / как воспроизвести; текстовый симптом - список провалов для mode=from_failures передаётся в `failures`"
    },
    "failures": {
      "type": "Finding[]",
      "note": "mode=from_failures: список провалов/пробелов, по одному отладчику на каждый; текстовый симптом остаётся на пути investigate"
    },
    "mode": {
      "type": "standalone|from_failures",
      "default": "standalone"
    },
    "scope": {
      "type": "string"
    },
    "auto_fix": {
      "type": "bool",
      "default": false,
      "note": "предложить analyze-plan-execute после подтверждённой причины"
    },
    "session": {
      "type": "string",
      "note": "a slug naming this investigation's session file .agents/planning/debug/<slug>.md; an existing one is resumed, a new one is written with status open"
    }
  },
  "outputs": {
    "status": "confirmed|partial|inconclusive|proposed",
    "root_cause": "string",
    "confidence": "int",
    "affected_files": "string[]",
    "fix_direction": "string",
    "regression_tests": "string[]",
    "risks": "string[]",
    "evidence_path": "string",
    "fix_directions": "string[]",
    "diagnosis": "string",
    "diagnoses": "{gap, root_cause, confidence}[]"
  },
  "quality_mode": {
    "default": "standard",
    "effect": "quick - 2 гипотезы и без второго мнения; full - + независимое подтверждение причины вторым агентом"
  },
  "requires": {
    "plugins": [
      "lane-pilot"
    ],
    "machines": [
      "project host (read-only",
      "throwaway worktree for reproduction)"
    ],
    "project": {
      "git": true
    }
  },
  "budget": {
    "max_minutes": 90
  },
  "entry": "ask_symptoms",
  "nodes": [
    {
      "id": "ask_symptoms",
      "type": "human",
      "role": "owner",
      "title": {
        "en": "Symptoms",
        "ru": "Симптомы"
      },
      "skip_when": "$inputs.mode == 'from_failures' || $inputs.symptom.length >= 40 || $inputs.session",
      "skip_out": {
        "answer": "$inputs.symptom",
        "answer_kind": "given"
      },
      "src": "maestro-flow:workflows/debug.md (symptoms)",
      "prompt": "Five questions in one form - what was expected, what happened, the exact error text, since when (last good version if known), steps to reproduce. Anything not in the form the agent finds in git log -10 and git diff --stat HEAD~3.",
      "out": {
        "answer": "any",
        "answer_kind": "given|answered|timeout"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 120
      }
    },
    {
      "id": "session",
      "type": "action",
      "action": "lp.debug_session",
      "title": {
        "en": "The debug session file",
        "ru": "Файл сессии отладки"
      },
      "rule": "runs only when input `session` is set: reads .agents/planning/debug/<session>.md on the PM checkout; a new run starts the file with the symptom and status open",
      "with": {
        "session": "{{$inputs.session}}"
      },
      "out": {
        "found": "bool",
        "path": "string",
        "evidence_path": "string"
      },
      "guards": {
        "maxVisits": 1
      }
    },
    {
      "id": "ask_symptoms_new",
      "type": "human",
      "role": "owner",
      "title": {
        "en": "Symptoms (new session)",
        "ru": "Симптомы (новая сессия)"
      },
      "src": "maestro-flow:workflows/debug.md (symptoms)",
      "prompt": "Five questions in one form - what was expected, what happened, the exact error text, since when (last good version if known), steps to reproduce. Anything not in the form the agent finds in git log -10 and git diff --stat HEAD~3.",
      "out": {
        "answer": "any",
        "answer_kind": "given|answered|timeout"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 120
      }
    },
    {
      "id": "investigate",
      "consumes": [
        {
          "kind": "report",
          "version": 1,
          "from": "verify_cause",
          "required": false
        }
      ],
      "produces": [
        {
          "kind": "diagnosis",
          "version": 1
        }
      ],
      "gates": [
        "investigate.confidence >= 0 && investigate.confidence <= 100"
      ],
      "type": "agent",
      "role": "debugger",
      "title": {
        "en": "Investigate",
        "ru": "Расследовать"
      },
      "src": "maestro-flow:ref/scientific-debug.md, workflows/debug.md",
      "prompt": "SCIENTIFIC_DEBUG_METHOD. Read-only on the repository; reproduction only in a throwaway copy. Loop: FORM a hypothesis, PREDICT what you would observe, TEST it (change one variable at a time), DECIDE. Return session_entry as one Markdown block for the session file and evidence_entry as one JSON object line for evidence.ndjson; the code-owned fs.write nodes append them, so this helper never writes files.\nRoot cause is confirmed only with a reproduction or file:line plus the mechanism. Red flags: \"probably\", \"let me just try changing this\", \"works on my machine\". Trace backward from the symptom to the first bad state, following data, not control flow.\nAfter 3 refuted hypotheses on one surface re-read the module boundaries and doubt the \"unchanged\" assumptions; do not raise a 4th hypothesis on your own - return inconclusive with what you learned.\nconfidence from reproduction reliability, directness of the evidence chain, whether the predicted fix was tested. Before declaring a cause: evidence_completeness >= 40%, a pressure pass done (strongest counter-argument answered), no contradicting evidence, fix_direction names concrete files.\n\nSession file: when input `session` is set, read .agents/planning/debug/<session>.md — an existing file is where you resume (skip asking the symptoms again); describe the append block in session_entry and the evidence line in evidence_entry.\n",
      "out": {
        "status": "confirmed|partial|inconclusive",
        "root_cause": "string",
        "mechanism": "string",
        "confidence": "int",
        "hypotheses_total": "int",
        "refuted": "int",
        "evidence_path": "string",
        "affected_files": "string[]",
        "fix_direction": "string",
        "regression_tests": "string[]",
        "risks": "string[]",
        "pressure_pass": "bool",
        "contradictions": "int",
        "session_entry": "string",
        "evidence_entry": "string"
      },
      "guards": {
        "maxVisits": 3,
        "timeoutMin": 40
      }
    },
    {
      "id": "normalize",
      "type": "action",
      "action": "debug.failures",
      "title": {
        "en": "Failure list",
        "ru": "Список провалов"
      },
      "out": {
        "failures": "Finding[]"
      }
    },
    {
      "id": "diagnose",
      "type": "parallel",
      "for_each": "normalize.failures",
      "max_fan_out": 6,
      "onOverflow": "truncate",
      "title": {
        "en": "Debuggers per gap",
        "ru": "Отладчик на каждый пробел"
      },
      "child": {
        "type": "agent",
        "role": "debugger",
        "session": "new",
        "prompt": "SCIENTIFIC_DEBUG_METHOD, read-only. One acceptance gap only: {{item}}. Form hypotheses, predict, test in a throwaway copy, record verdicts in evidence.ndjson; root cause is confirmed only with a reproduction or file:line plus the mechanism; at most 3 refuted hypotheses, then inconclusive.",
        "out": {
          "status": "confirmed|partial|inconclusive",
          "root_cause": "string",
          "confidence": "int",
          "fix_direction": "string",
          "affected_files": "string[]"
        },
        "produces": [
          {
            "kind": "diagnosis",
            "version": 1
          }
        ]
      },
      "join": {
        "policy": "all",
        "uses": "reduce.debug.diagnose",
        "out": {
          "diagnoses": "any"
        }
      }
    },
    {
      "id": "verify_cause",
      "consumes": [
        {
          "kind": "diagnosis",
          "version": 1,
          "from": "investigate"
        }
      ],
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "debugger",
      "session": "new",
      "title": {
        "en": "Independent confirmation",
        "ru": "Независимое подтверждение"
      },
      "applicable_modes": [
        "full"
      ],
      "skip_out": {
        "confirmed": true,
        "objections": "[]",
        "session_entry": "",
        "evidence_entry": ""
      },
      "prompt": "Fresh agent re-checks the claimed cause from the evidence log and the code only; try to refute it with one cheaper explanation; report confirmed or the objection with file:line. Return session_entry as one Markdown block and evidence_entry as one JSON object line; the code-owned fs.write nodes append them, so this read-only helper never writes files.\nSession file: when input `session` is set, read .agents/planning/debug/<session>.md — describe the append block in session_entry and the evidence line in evidence_entry.\n",
      "out": {
        "confirmed": "bool",
        "objections": "string[]",
        "session_entry": "string",
        "evidence_entry": "string"
      },
      "guards": {
        "maxVisits": 3,
        "timeoutMin": 25
      }
    },
    {
      "id": "write_investigation_session",
      "type": "action",
      "action": "fs.write",
      "skip_when": "!$inputs.session || !investigate.session_entry",
      "skip_out": {
        "session_path": ""
      },
      "path": "{{session.path}}",
      "mode": "append",
      "contents": "{{investigate.session_entry}}",
      "out": {
        "session_path": "string"
      }
    },
    {
      "id": "write_investigation_evidence",
      "type": "action",
      "action": "fs.write",
      "skip_when": "!$inputs.session || !investigate.evidence_entry",
      "skip_out": {
        "evidence_path": ""
      },
      "path": "{{session.evidence_path}}",
      "mode": "append",
      "contents": "{{investigate.evidence_entry}}\n",
      "out": {
        "evidence_path": "string"
      }
    },
    {
      "id": "write_verification_session",
      "type": "action",
      "action": "fs.write",
      "skip_when": "!$inputs.session || !verify_cause.session_entry",
      "skip_out": {
        "session_path": ""
      },
      "path": "{{session.path}}",
      "mode": "append",
      "contents": "{{verify_cause.session_entry}}",
      "out": {
        "session_path": "string"
      }
    },
    {
      "id": "write_verification_evidence",
      "type": "action",
      "action": "fs.write",
      "skip_when": "!$inputs.session || !verify_cause.evidence_entry",
      "skip_out": {
        "evidence_path": ""
      },
      "path": "{{session.evidence_path}}",
      "mode": "append",
      "contents": "{{verify_cause.evidence_entry}}\n",
      "out": {
        "evidence_path": "string"
      }
    },
    {
      "id": "ask_more",
      "type": "human",
      "role": "owner",
      "title": {
        "en": "Need more information",
        "ru": "Нужны данные"
      },
      "prompt": "Three hypotheses were refuted. Say what was ruled out and ask for the one thing that would help most (a log, a stack trace, an exact repro, access to a service); options - provide, continue anyway, stop.",
      "out": {
        "answer": "string",
        "answer_kind": "provide|continue|stop|timeout"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 480
      }
    },
    {
      "id": "propose_fix",
      "type": "action",
      "action": "lp.propose_workflow",
      "workflow": "analyze-plan-execute",
      "inputs": {
        "goal": "{{investigate.fix_direction}}",
        "scope": "{{investigate.affected_files}}"
      }
    },
    {
      "id": "confirmed",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "confirmed",
        "root_cause": "investigate.root_cause",
        "confidence": "investigate.confidence",
        "affected_files": "investigate.affected_files",
        "fix_direction": "investigate.fix_direction",
        "regression_tests": "investigate.regression_tests",
        "risks": "investigate.risks",
        "evidence_path": "write_investigation_evidence.evidence_path",
        "fix_directions": "[investigate.fix_direction]",
        "diagnosis": "investigate.mechanism"
      }
    },
    {
      "id": "proposed",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "proposed",
        "root_cause": "investigate.root_cause",
        "confidence": "investigate.confidence",
        "affected_files": "investigate.affected_files",
        "fix_direction": "investigate.fix_direction",
        "regression_tests": "investigate.regression_tests",
        "risks": "investigate.risks",
        "evidence_path": "write_investigation_evidence.evidence_path",
        "diagnosis": "investigate.mechanism"
      }
    },
    {
      "id": "partial",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "partial",
        "root_cause": "investigate.root_cause",
        "confidence": "investigate.confidence",
        "evidence_path": "write_investigation_evidence.evidence_path",
        "diagnosis": "investigate.mechanism"
      }
    },
    {
      "id": "inconclusive",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "inconclusive",
        "evidence_path": "write_investigation_evidence.evidence_path",
        "diagnosis": "investigate.mechanism",
        "confidence": "investigate.confidence"
      }
    },
    {
      "id": "diagnosed",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "'confirmed'",
        "diagnoses": "diagnose.diagnoses"
      }
    }
  ],
  "edges": [
    {
      "from": "ask_symptoms",
      "to": "session",
      "pass": "artifact",
      "when": "$inputs.session"
    },
    {
      "from": "ask_symptoms",
      "to": "normalize",
      "pass": "artifact",
      "when": "$inputs.mode == 'from_failures'"
    },
    {
      "from": "ask_symptoms",
      "to": "investigate",
      "pass": "artifact"
    },
    {
      "from": "session",
      "to": "normalize",
      "pass": "artifact",
      "when": "$inputs.mode == 'from_failures'"
    },
    {
      "from": "session",
      "to": "investigate",
      "pass": "artifact",
      "when": "session.found"
    },
    {
      "from": "session",
      "to": "ask_symptoms_new",
      "pass": "artifact",
      "when": "$inputs.mode != 'from_failures' && (!$inputs.symptom || $inputs.symptom.length < 40)"
    },
    {
      "from": "normalize",
      "to": "diagnose",
      "pass": "artifact",
      "when": "normalize.failures.length > 0"
    },
    {
      "from": "normalize",
      "to": "investigate",
      "pass": "artifact"
    },
    {
      "from": "session",
      "to": "investigate",
      "pass": "artifact"
    },
    {
      "from": "ask_symptoms_new",
      "to": "investigate",
      "pass": "artifact"
    },
    {
      "from": "diagnose",
      "to": "diagnosed",
      "pass": "artifact"
    },
    {
      "from": "investigate",
      "to": "write_investigation_session",
      "pass": "artifact"
    },
    {
      "from": "write_investigation_session",
      "to": "write_investigation_evidence",
      "pass": "artifact"
    },
    {
      "from": "write_investigation_evidence",
      "to": "verify_cause",
      "pass": "read-prior-session",
      "when": "investigate.status == 'confirmed' && investigate.confidence >= 40 && investigate.pressure_pass && investigate.contradictions == 0 && investigate.affected_files.length > 0"
    },
    {
      "from": "write_investigation_evidence",
      "to": "investigate",
      "pass": "same-session",
      "when": "investigate.status == 'confirmed' && visits('investigate') < 2",
      "label": "gate not met - gather more evidence"
    },
    {
      "from": "write_investigation_evidence",
      "to": "ask_more",
      "pass": "artifact",
      "when": "investigate.status == 'inconclusive' && investigate.refuted >= 3 && visits('ask_more') == 0"
    },
    {
      "from": "write_investigation_evidence",
      "to": "partial",
      "pass": "artifact",
      "when": "investigate.status == 'partial'"
    },
    {
      "from": "write_investigation_evidence",
      "to": "inconclusive",
      "pass": "artifact"
    },
    {
      "from": "verify_cause",
      "to": "write_verification_session",
      "pass": "artifact"
    },
    {
      "from": "write_verification_session",
      "to": "write_verification_evidence",
      "pass": "artifact"
    },
    {
      "from": "write_verification_evidence",
      "to": "propose_fix",
      "pass": "artifact",
      "when": "verify_cause.confirmed && $inputs.auto_fix"
    },
    {
      "from": "write_verification_evidence",
      "to": "confirmed",
      "pass": "artifact",
      "when": "verify_cause.confirmed"
    },
    {
      "from": "write_verification_evidence",
      "to": "investigate",
      "pass": "same-session",
      "when": "visits('investigate') < 3",
      "label": "objection"
    },
    {
      "from": "write_verification_evidence",
      "to": "partial",
      "pass": "artifact"
    },
    {
      "from": "ask_more",
      "to": "investigate",
      "pass": "same-session",
      "when": "ask_more.answer_kind in ['provide','continue']",
      "with": {
        "answer": "ask_more.answer"
      }
    },
    {
      "from": "ask_more",
      "to": "inconclusive",
      "pass": "artifact"
    },
    {
      "from": "propose_fix",
      "to": "proposed",
      "pass": "artifact"
    }
  ],
  "test": {
    "id": "dbg-1",
    "sim": {
      "input": {
        "symptom": "CSV import crashes with 'Cannot read properties of undefined (reading split)' on files with an empty last line; started after v2.3",
        "scope": "src/import",
        "session": ""
      },
      "stubs": {
        "investigate": {
          "status": "confirmed",
          "confidence": 82,
          "pressure_pass": true,
          "contradictions": 0,
          "affected_files": [
            "src/import/csv.ts:48"
          ],
          "refuted": 1,
          "root_cause": "last empty line yields undefined row",
          "fix_direction": "skip empty trailing rows in parseCsv"
        },
        "verify_cause": {
          "confirmed": true
        }
      },
      "expect_path": [
        "ask_symptoms",
        "investigate",
        "verify_cause",
        "confirmed"
      ],
      "expect_outputs": [
        "status == 'confirmed'",
        "affected_files.length >= 1",
        "confidence > 70"
      ],
      "expect_no_repo_edits": true,
      "variant_from_failures": {
        "input": {
          "mode": "from_failures",
          "failures": [
            "check p1 red: lint fails",
            "check p2 red: test fails"
          ],
          "session": ""
        },
        "stubs": {
          "diagnose": {
            "status": "confirmed",
            "root_cause": "stubbed cause",
            "confidence": 80,
            "fix_direction": "fix"
          }
        },
        "expect_path": [
          "ask_symptoms",
          "normalize",
          "diagnose",
          "diagnosed"
        ]
      }
    },
    "live": "песочница: заведомый баг (пустая последняя строка); ответ содержит file:line и механизм, evidence.ndjson есть, изменений в репозитории нет (repo_edited = 0)"
  },
  "goal_check": "artifact"
}
