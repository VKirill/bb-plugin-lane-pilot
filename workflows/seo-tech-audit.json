{
  "id": "seo-tech-audit",
  "name": {
    "en": "SEO technical audit",
    "ru": "Технический SEO-аудит"
  },
  "description": {
    "en": "Full technical audit of a site: GSC baseline, a JS-rendering crawl and Googlebot log checks in parallel, then a per-area specialist audit (index, robots, sitemap, canonical, parameters, pagination, rendering, CWV, hreflang, traps, duplicates). Everything lands in a Master Audit Matrix and a prioritized root-cause backlog with a definition of done per ticket; the tickets become release items for seo-release.",
    "ru": "Полный технический аудит сайта: базовая линия GSC, краул с JS-рендерингом и проверка логов Googlebot параллельно, затем специализированный аудит по каждой области (индекс, robots, карта, canonical, параметры, пагинация, рендеринг, CWV, hreflang, ловушки, дубли). Всё сводится в Master Audit Matrix и приоритизированный бэклог первопричин с definition of done по каждому тикету; тикеты становятся релизными элементами для seo-release."
  },
  "examples": {
    "ru": [
      "Проведи полный технический аудит сайта",
      "Собери Master Audit Matrix и бэклог дефектов",
      "Аудит индексации, canonical и краулингового бюджета"
    ],
    "en": [
      "Run a full technical audit of the site",
      "Build the Master Audit Matrix and the defect backlog",
      "Audit indexation, canonicals and crawl budget"
    ]
  },
  "not_for": [
    "seo-ai-visibility: AI citation share and the audience question panel (this audit runs only the 19 AI-bot checks)",
    "mkt-tracking-setup: analytics counters, goals and UTM — «счётчик не работает» is not a crawl problem",
    "seo-drop-diagnosis: explaining a confirmed traffic drop",
    "seo-monitor: the weekly report",
    "seo-release: shipping the fixes"
  ],
  "status": "published",
  "tags": [
    "seo",
    "drmax"
  ],
  "inputs": {
    "site_url": {
      "type": "string",
      "required": true
    },
    "project_passport_path": {
      "type": "string",
      "default": ""
    },
    "template_list_path": {
      "type": "string",
      "default": "",
      "note": "список CMS-шаблонов, если есть"
    }
  },
  "outputs": {
    "status": "done|partial|blocked",
    "matrix_path": "string?",
    "backlog_path": "string?",
    "release_items": "string[]?",
    "agent_ready_score": "number?",
    "dispatched_count": "int?"
  },
  "requires": {
    "plugins": [
      "lane-pilot"
    ],
    "skills": [
      "seo-agent",
      "google",
      "yandex",
      "seo-tech-audit-kit",
      "seo-evidence-contract",
      "seo-ai-visibility",
      "tavily"
    ],
    "browserSession": true
  },
  "budget": {
    "max_minutes": 240,
    "max_usd": 15
  },
  "entry": "access",
  "nodes": [
    {
      "id": "access",
      "type": "human",
      "role": "owner",
      "title": {
        "en": "Logs and crawl export",
        "ru": "Логи и выгрузка краула"
      },
      "prompt": "Provide server logs for 14-30 days and any crawl export (paths or empty). Log-dependent branches are skipped without logs.",
      "out": {
        "logs_path": "string",
        "crawl_path": "string",
        "answer_kind": "given|timeout"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 240
      }
    },
    {
      "id": "intake",
      "type": "parallel",
      "for_each": [
        "gsc",
        "crawl",
        "logs"
      ],
      "title": {
        "en": "Intake streams",
        "ru": "Входные потоки"
      },
      "child": {
        "type": "agent",
        "role": "specialist:seo-specialist",
        "profile": {
          "skills": [
            "seo-tech-audit-kit",
            "google",
            "seo-evidence-contract"
          ]
        },
        "prompt": "Intake {{item}} for {{$inputs.site_url}}: gsc = technical baseline per template; crawl = JS-rendering crawl with crawl-budget leaks (use {{access.crawl_path}} when given); logs = verified Googlebot patterns and phantom URLs (skipped when {{access.logs_path}} is empty). Cross-check with the sitemap. Return findings_paths, defects, skipped and skipped_branches. Before any crawl plan, apply the large-site protocol of references/screaming-frog-llm-embeddings-playbook.md §2: sites over 100k URL get a scouting crawl (≤ 50k URL or 1 h) plus List mode of URLs with impressions; a full crawl is proposed only with a stated reason. JS rendering is enabled per template only after a raw/rendered diff on a sample (§3).",
        "out": {
          "findings_paths": "string[]",
          "defects": "Finding[]",
          "skipped": "bool",
          "skipped_branches": "string[]"
        },
        "produces": [
          {
            "kind": "report",
            "version": 1
          }
        ]
      },
      "join": {
        "policy": "all",
        "out": {
          "findings_paths": "string[]",
          "defects": "Finding[]",
          "skipped_branches": "string[]"
        }
      },
      "concurrency": 3
    },
    {
      "id": "agent_ready",
      "type": "action",
      "action": "sp.run_script",
      "title": {
        "en": "19 Agent Ready checks ($0)",
        "ru": "19 проверок Agent Ready ($0)"
      },
      "skill": "seo-ai-visibility",
      "script": "agent_ready_audit.py",
      "args": {
        "site": "{{$inputs.site_url}}"
      },
      "timeoutSec": 120,
      "out": {
        "score": "number",
        "blockers": "int",
        "report_path": "string"
      }
    },
    {
      "id": "specialists",
      "type": "parallel",
      "for_each": [
        "index",
        "robots",
        "sitemap",
        "canonical",
        "parameters",
        "pagination",
        "rendering",
        "dom_diff",
        "cwv",
        "hreflang",
        "traps",
        "duplicates"
      ],
      "title": {
        "en": "Specialist audits",
        "ru": "Аудиты по областям"
      },
      "child": {
        "type": "agent",
        "role": "specialist:seo-specialist",
        "profile": {
          "skills": [
            "seo-tech-audit-kit",
            "seo-agent",
            "seo-evidence-contract"
          ]
        },
        "prompt": "Audit area {{item}} of {{$inputs.site_url}}: index hygiene, robots.txt, sitemap, canonical alignment, parameter registry, pagination, rendering and mobile parity, DOM diff, CWV, hreflang, spider traps or duplicates — one defect table per template, grounded or marked not-measured. Return findings_paths, defects, skipped and skipped_branches.",
        "out": {
          "findings_paths": "string[]",
          "defects": "Finding[]",
          "skipped": "bool",
          "skipped_branches": "string[]"
        },
        "produces": [
          {
            "kind": "report",
            "version": 1
          }
        ]
      },
      "join": {
        "policy": "all",
        "out": {
          "findings_paths": "string[]",
          "defects": "Finding[]",
          "skipped_branches": "string[]"
        }
      },
      "concurrency": 4
    },
    {
      "id": "matrix",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "profile": {
        "skills": [
          "seo-tech-audit-kit",
          "seo-evidence-contract"
        ]
      },
      "title": {
        "en": "Master Audit Matrix",
        "ru": "Master Audit Matrix"
      },
      "prompt": "Procedure master-audit-matrix: join every defect row into the matrix with conflict flags and the three-cohort crawl distribution. Return matrix_path and rows. Add the Agent Ready rows from {{agent_ready.report_path}} (score {{agent_ready.score}}, blockers {{agent_ready.blockers}}) as their own area. Add an area 'semantic duplicates' from the embeddings report (clean-area vectors only): pairs with cosine ≥ 0.95 are candidates; a pair becomes a ticket only if GSC query×page (byPage) shows shared queries with impressions for both URLs.",
      "out": {
        "matrix_path": "string",
        "rows": "int"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 25
      }
    },
    {
      "id": "backlog",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "profile": {
        "skills": [
          "seo-tech-audit-kit",
          "seo-evidence-contract"
        ]
      },
      "title": {
        "en": "Root-cause backlog",
        "ru": "Бэклог первопричин"
      },
      "prompt": "Procedure defect-backlog-prioritization: aggregate matrix rows into root-cause tickets with a definition of done and verification method, prioritize and route to teams; each ticket is a release item for seo-release. Critical and medium tickets also become code_tasks: ActionOrder objects of kind code_task whose task is a TaskV2 contract with exact owns_paths, acceptance and focused verification, reason_code seo_tech_blocker, entity_ids, touches_scopes, an interval forecast and risk low | medium | high, plus one order of kind schedule for seo-release with mode template_cohort after the merges. Return backlog_path, tickets, release_items and code_tasks.",
      "out": {
        "backlog_path": "string",
        "tickets": "int",
        "release_items": "string[]",
        "code_tasks": "ActionOrder[]"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 25
      }
    },
    {
      "id": "critic",
      "produces": [
        {
          "kind": "verdict",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "plan-critic",
      "session": "new",
      "title": {
        "en": "Backlog critique",
        "ru": "Критика бэклога"
      },
      "prompt": "Every ticket has evidence rows, a scope, a definition of done and a verification method; reject row-level noise that is not a defect. Status pass | rework | block; findings cite the ticket, severity one of critical, high, medium, low, info.",
      "out": {
        "status": "pass|rework|block",
        "findings": "Finding[]"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 25
      }
    },
    {
      "id": "commit_intents",
      "type": "action",
      "action": "sp.commit_memory",
      "title": {
        "en": "Backlog tickets as writer tasks (one transaction)",
        "ru": "Тикеты бэклога как задачи писателю (одна транзакция)"
      },
      "phase": "intents",
      "domain": "seo",
      "orders": "{{backlog.code_tasks}}",
      "ownerAnswer": "none",
      "artifacts": [
        "{{matrix.matrix_path}}",
        "{{backlog.backlog_path}}",
        "{{agent_ready.report_path}}"
      ],
      "out": {
        "intents": "int"
      }
    },
    {
      "id": "drain_outbox",
      "type": "action",
      "action": "sp.dispatch_tasks",
      "title": {
        "en": "Dispatch writer tasks (idempotent)",
        "ru": "Поставить задачи писателю (идемпотентно)"
      },
      "domain": "seo",
      "sourceGraph": "seo-tech-audit",
      "out": {
        "dispatched_count": "int",
        "dispatched_ids": "string[]"
      }
    },
    {
      "id": "package",
      "type": "action",
      "action": "fs.write",
      "path": ".agents/seo/tech-audit/{{date}}/",
      "files": [
        "matrix.csv",
        "backlog.md",
        "robots.diff",
        "sitemap-plan.md",
        "release-items.json"
      ],
      "note": "the matrix, the prioritized backlog and the change sets; release items go to seo-release, the graph itself changes no site",
      "out": {
        "package_path": "string"
      }
    },
    {
      "id": "done",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "done",
        "matrix_path": "matrix.matrix_path",
        "backlog_path": "backlog.backlog_path",
        "release_items": "backlog.release_items",
        "agent_ready_score": "agent_ready.score",
        "dispatched_count": "drain_outbox.dispatched_count"
      }
    },
    {
      "id": "blocked",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "blocked"
      }
    }
  ],
  "edges": [
    {
      "from": "access",
      "to": "intake",
      "pass": "artifact"
    },
    {
      "from": "specialists",
      "to": "matrix",
      "pass": "artifact"
    },
    {
      "from": "matrix",
      "to": "backlog",
      "pass": "artifact"
    },
    {
      "from": "backlog",
      "to": "critic",
      "pass": "artifact"
    },
    {
      "from": "critic",
      "to": "backlog",
      "pass": "same-session",
      "when": "critic.status == 'rework' && visits('critic') < 2",
      "label": "rework backlog"
    },
    {
      "from": "critic",
      "to": "blocked",
      "pass": "artifact"
    },
    {
      "from": "package",
      "to": "done",
      "pass": "artifact"
    },
    {
      "from": "intake",
      "to": "agent_ready",
      "pass": "artifact"
    },
    {
      "from": "agent_ready",
      "to": "specialists",
      "pass": "artifact"
    },
    {
      "from": "critic",
      "to": "commit_intents",
      "pass": "artifact",
      "when": "critic.status == 'pass'"
    },
    {
      "from": "commit_intents",
      "to": "drain_outbox",
      "pass": "artifact"
    },
    {
      "from": "drain_outbox",
      "to": "package",
      "pass": "artifact"
    }
  ],
  "test": {
    "id": "sta-1",
    "sim": {
      "input": {
        "site_url": "https://example.ru"
      },
      "stubs": {
        "intake": {
          "findings_paths": [
            "gsc.md",
            "crawl.md"
          ],
          "defects": [],
          "skipped_branches": [
            "logs"
          ]
        },
        "specialists": {
          "findings_paths": [
            "index.md",
            "canonical.md"
          ],
          "defects": [],
          "skipped_branches": []
        },
        "matrix": {
          "matrix_path": "matrix.csv",
          "rows": 24
        },
        "backlog": {
          "backlog_path": "backlog.md",
          "tickets": 6,
          "release_items": [
            ".agents/seo/release/r1/item.json"
          ],
          "code_tasks": []
        },
        "critic": {
          "status": "pass",
          "findings": []
        },
        "package": {
          "package_path": ".agents/seo/tech-audit/2026-11-06/"
        },
        "agent_ready": {
          "score": 14,
          "blockers": 2,
          "report_path": "agent-ready.json"
        },
        "commit_intents": {
          "intents": 1
        },
        "drain_outbox": {
          "dispatched_count": 1,
          "dispatched_ids": [
            "lptask_tech_1"
          ]
        }
      },
      "expect_path": [
        "access",
        "intake",
        "agent_ready",
        "specialists",
        "matrix",
        "backlog",
        "critic",
        "commit_intents",
        "drain_outbox",
        "package",
        "done"
      ],
      "expect_outputs": [
        "status == 'done'",
        "backlog_path != ''"
      ],
      "human_answers": {
        "access": {
          "logs_path": "",
          "crawl_path": "",
          "answer_kind": "given"
        }
      },
      "expect_output": {
        "status": "done",
        "agent_ready_score": 14,
        "dispatched_count": 1
      }
    },
    "live": "полный техаудит по паспорту проекта или по сигналу seo-monitor",
    "note": "Tested on stubs. Log branches skip without the owner's logs; the graph writes a backlog, seo-release ships the fixes."
  },
  "goal_check": "artifact"
}
