{
  "id": "seo-drop-diagnosis",
  "name": {
    "en": "SEO drop diagnosis",
    "ru": "Диагноз SEO-просадки"
  },
  "description": {
    "en": "Diagnosis of a traffic drop or a post-core-update loss: aligned comparison windows, a mechanism label per cohort, the scope (page, template or site), parallel layer checks, scored hypothesis cards with falsifiers, an independent falsification attempt and an owner-approved staged recovery pilot. Fixes run in other graphs.",
    "ru": "Диагноз просадки трафика или потерь после core-апдейта: выровненные окна сравнения, метка механизма по когортам, область просадки (страница, шаблон или сайт), параллельные проверки слоёв, оценённые карты гипотез с фальсификатором, независимая попытка опровержения и поэтапный пилот восстановления, который утверждает владелец. Исправления выполняют другие графы."
  },
  "examples": {
    "ru": [
      "Разбери, почему сайт просел после апдейта",
      "Диагноз падения трафика по GSC",
      "Что сломалось: просадка на шаблоне каталога"
    ],
    "en": [
      "Diagnose why the site dropped after the update",
      "Traffic-drop diagnosis from GSC",
      "What broke: a drop on the catalog template"
    ]
  },
  "not_for": [
    "mkt-pulse-monitor: a drop in paid Direct/Telegram clicks, spend or product conversions",
    "mkt-tracking-setup: «Метрика перестала считать» — a counter or tag outage, not lost rankings",
    "seo-tech-audit: a full technical audit without a drop",
    "seo-monitor: the weekly report that detects drops"
  ],
  "status": "published",
  "tags": [
    "seo",
    "drmax"
  ],
  "inputs": {
    "site_url": {
      "type": "string",
      "required": true
    },
    "affected_urls": {
      "type": "string[]",
      "note": "затронутые URL или когорты из seo-monitor",
      "default": []
    },
    "update_window": {
      "type": "string",
      "default": "",
      "note": "T_start/T_end завершившегося апдейта, если известно"
    },
    "project_passport_path": {
      "type": "string",
      "default": ""
    }
  },
  "outputs": {
    "status": "done|partial|frozen|blocked|seasonal|handed_off",
    "diagnosis_path": "string?",
    "hypotheses_path": "string?",
    "pilot_path": "string?",
    "freeze_due": "string?",
    "dispatched_count": "int?"
  },
  "requires": {
    "plugins": [
      "lane-pilot"
    ],
    "skills": [
      "google",
      "seo-tools",
      "seo-agent",
      "seo-update-forensics",
      "seo-measurement-loop",
      "seo-evidence-contract",
      "mkt-end-to-end-analytics"
    ],
    "browserSession": true
  },
  "budget": {
    "max_minutes": 120,
    "max_usd": 10
  },
  "entry": "intake",
  "nodes": [
    {
      "id": "intake",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "profile": {
        "skills": [
          "seo-update-forensics",
          "seo-measurement-loop"
        ]
      },
      "title": {
        "en": "Update window and clean comparison",
        "ru": "Окно апдейта и чистое сравнение"
      },
      "prompt": "Procedure core-update-response: check the Search Status Dashboard for {{$inputs.site_url}}. If an update is still rolling out, set the freeze flag and a due date of T_end+7 and return status frozen. Otherwise build aligned clean comparison windows, the observation log and the top-3 competitor gap. Return status proceed | frozen, freeze_due, log_path and windows_path.",
      "out": {
        "status": "proceed|frozen",
        "freeze_due": "string",
        "log_path": "string",
        "windows_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 20
      }
    },
    {
      "id": "window_split",
      "type": "action",
      "action": "sp.run_script",
      "title": {
        "en": "Aligned windows with demand control ($0)",
        "ru": "Выровненные окна с контролем спроса ($0)"
      },
      "skill": "seo-update-forensics",
      "script": "drop_window_split.py",
      "args": {
        "windows": "{{intake.windows_path}}",
        "affected": "{{$inputs.affected_urls}}",
        "impressions_ratio_lt": 0.82,
        "abs_pos_delta_lt": 0.5,
        "calendar": "calendar-ru"
      },
      "timeoutSec": 120,
      "out": {
        "drop_confirmed": "bool",
        "seasonality": "bool",
        "split_path": "string"
      }
    },
    {
      "id": "channel_isolation",
      "type": "action",
      "action": "sp.run_script",
      "title": {
        "en": "Channel isolation: organic, paid, direct, tracking ($0)",
        "ru": "Изоляция канала: органика, платный, прямой, трекинг ($0)"
      },
      "skill": "seo-update-forensics",
      "script": "channel_isolation.py",
      "args": {
        "split": "{{window_split.split_path}}"
      },
      "timeoutSec": 120,
      "out": {
        "cause_channel": "organic|paid|tracking|mixed",
        "report_path": "string"
      }
    },
    {
      "id": "mkt_handoff",
      "type": "action",
      "action": "sp.commit_memory",
      "title": {
        "en": "Hand the paid/tracking cause to marketing",
        "ru": "Передать платную/трекинговую причину маркетингу"
      },
      "phase": "intents",
      "domain": "seo",
      "ownerAnswer": "none",
      "orders": [
        {
          "kind": "sub_graph",
          "workflow_id": "mkt-tracking-setup",
          "inputs": {
            "site_url": "{{$inputs.site_url}}"
          },
          "reason_code": "tracking_gap",
          "entity_ids": [
            "site:{{$inputs.site_url}}"
          ],
          "touches_scopes": [
            "tracking_tags"
          ],
          "forecast": {
            "metric": "attributed_sessions_share",
            "point": 0.95,
            "lo80": 0.9,
            "hi80": 0.99,
            "horizon_days": 7
          },
          "risk": "low"
        }
      ],
      "evidence": "{{channel_isolation.report_path}}",
      "out": {
        "intents": "int"
      }
    },
    {
      "id": "mkt_drain",
      "type": "action",
      "action": "sp.dispatch_tasks",
      "domain": "seo",
      "sourceGraph": "seo-drop-diagnosis",
      "title": {
        "en": "Start the marketing graph",
        "ru": "Запустить маркетинговый граф"
      },
      "out": {
        "dispatched_count": "int",
        "dispatched_ids": "string[]"
      }
    },
    {
      "id": "mechanism",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "profile": {
        "skills": [
          "seo-update-forensics"
        ]
      },
      "title": {
        "en": "Drop mechanism",
        "ru": "Механизм просадки"
      },
      "prompt": "Procedure gsc-drop-mechanism-classification: label the mechanism per affected cohort (ranking loss, SERP capture, demand contraction, noise); for pages whose clicks the SERP captured, add zero-click recovery tasks. Return mechanism_path and labels.",
      "out": {
        "mechanism_path": "string",
        "labels": "string[]"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 20
      }
    },
    {
      "id": "scope",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "profile": {
        "skills": [
          "seo-update-forensics",
          "seo-tools"
        ]
      },
      "title": {
        "en": "Drop scope",
        "ru": "Область просадки"
      },
      "prompt": "Procedure drop-scope-cohort-audit: merge GSC and crawl data, label the scope page | template | site and write the bucket specs for developers. Return scope and scope_path.",
      "out": {
        "scope": "page|template|site",
        "scope_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 20
      }
    },
    {
      "id": "layers",
      "type": "parallel",
      "for_each": [
        "demand",
        "serp_layout",
        "index_canonical",
        "crawl",
        "bloat",
        "content",
        "trust",
        "ux_cwv",
        "architecture",
        "freshness"
      ],
      "title": {
        "en": "Layer checks",
        "ru": "Проверки слоёв"
      },
      "child": {
        "type": "agent",
        "role": "specialist:seo-specialist",
        "profile": {
          "skills": [
            "seo-update-forensics",
            "seo-tech-audit-kit",
            "seo-evidence-contract"
          ]
        },
        "prompt": "Layer {{item}} of the post-update drop diagnosis for {{$inputs.site_url}}: run the check of this layer only, every claim grounded in the pull data or marked not-measured. Return findings_paths, defects, skipped (true when the layer needs data the owner did not give) and skipped_branches.",
        "out": {
          "findings_paths": "string[]",
          "defects": "Finding[]",
          "skipped": "bool",
          "skipped_branches": "string[]"
        },
        "produces": [
          {
            "kind": "report",
            "version": 1
          }
        ]
      },
      "join": {
        "policy": "all",
        "out": {
          "findings_paths": "string[]",
          "defects": "Finding[]",
          "skipped_branches": "string[]"
        }
      },
      "concurrency": 4
    },
    {
      "id": "contour",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "profile": {
        "skills": [
          "seo-update-forensics"
        ]
      },
      "title": {
        "en": "Fix contour",
        "ru": "Контур исправления"
      },
      "prompt": "Procedure defect-scope-diagnosis: pick the fix contour from the layer findings — single_url | template | device | geo | fact | role_decay. Return contour and contour_path.",
      "out": {
        "contour": "single_url|template|device|geo|fact|role_decay",
        "contour_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 15
      }
    },
    {
      "id": "hypotheses",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "profile": {
        "skills": [
          "seo-update-forensics",
          "seo-measurement-loop",
          "seo-evidence-contract"
        ]
      },
      "title": {
        "en": "Hypothesis cards and pilot",
        "ru": "Карты гипотез и пилот"
      },
      "prompt": "Procedures seo-hypothesis-card and post-update-recovery-pilot: hypothesis cards scored with evidence and a falsifier each, then a staged recovery pilot plan. Then followup_orders by diagnosis: broken code, render or redirect -> code_task (urgent, owns_paths); commercial or E-E-A-T signals -> sub_graph seo-trust; pages lost on intent -> sub_graph seo-page-refresh; each an ActionOrder with reason_code, entity_ids, touches_scopes, an interval forecast and risk low | medium | high. Return hypotheses_path, pilot_path, top_count, followup_orders.",
      "out": {
        "hypotheses_path": "string",
        "pilot_path": "string",
        "top_count": "int",
        "followup_orders": "ActionOrder[]"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 25
      }
    },
    {
      "id": "critic",
      "produces": [
        {
          "kind": "verdict",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "auditor",
      "session": "new",
      "title": {
        "en": "Falsify the hypotheses",
        "ru": "Фальсификация гипотез"
      },
      "prompt": "Try to falsify every top hypothesis using only the data in the package; a hypothesis the data cannot kill stays. Status pass | rework | block; findings cite the card and the evidence, severity one of critical, high, medium, low, info.",
      "out": {
        "status": "pass|rework|block",
        "findings": "Finding[]"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 25
      }
    },
    {
      "id": "review",
      "type": "human",
      "role": "owner",
      "title": {
        "en": "Approve the recovery pilot",
        "ru": "Утверждение пилота восстановления"
      },
      "prompt": "Choose which staged recovery pilot runs; decline sends the diagnosis back without a pilot.",
      "out": {
        "answer": "string",
        "answer_kind": "approved|declined|timeout"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 240
      }
    },
    {
      "id": "package",
      "type": "action",
      "action": "fs.write",
      "path": ".agents/seo/drop-diagnosis/{{date}}/",
      "files": [
        "diagnosis.md",
        "hypotheses.md",
        "pilot.md"
      ],
      "note": "diagnosis log by segment and layer, scored hypothesis cards, the approved pilot; route follow-ups to seo-page-refresh / seo-tech-audit / seo-structure-audit / seo-trust",
      "out": {
        "diagnosis_path": "string"
      }
    },
    {
      "id": "followups",
      "type": "action",
      "action": "sp.commit_memory",
      "title": {
        "en": "Treatment orders from the approved pilot",
        "ru": "Приказы лечения по утверждённому пилоту"
      },
      "phase": "intents",
      "domain": "seo",
      "orders": "{{hypotheses.followup_orders}}",
      "ownerAnswer": "{{review.answer_kind}}",
      "out": {
        "intents": "int"
      }
    },
    {
      "id": "followups_drain",
      "type": "action",
      "action": "sp.dispatch_tasks",
      "domain": "seo",
      "sourceGraph": "seo-drop-diagnosis",
      "title": {
        "en": "Start treatment graphs and urgent code tasks",
        "ru": "Запустить лечебные графы и срочные код-задачи"
      },
      "out": {
        "dispatched_count": "int",
        "dispatched_ids": "string[]"
      }
    },
    {
      "id": "seasonal",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "seasonal",
        "diagnosis_path": "window_split.split_path"
      }
    },
    {
      "id": "handed_off",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "handed_off",
        "diagnosis_path": "channel_isolation.report_path",
        "dispatched_count": "mkt_drain.dispatched_count"
      }
    },
    {
      "id": "done",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "done",
        "diagnosis_path": "package.diagnosis_path",
        "hypotheses_path": "hypotheses.hypotheses_path",
        "pilot_path": "hypotheses.pilot_path",
        "dispatched_count": "followups_drain.dispatched_count"
      }
    },
    {
      "id": "partial",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "partial"
      }
    },
    {
      "id": "frozen",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "frozen",
        "freeze_due": "intake.freeze_due"
      }
    },
    {
      "id": "blocked",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "blocked"
      }
    }
  ],
  "edges": [
    {
      "from": "intake",
      "to": "frozen",
      "pass": "artifact",
      "when": "intake.status == 'frozen'"
    },
    {
      "from": "intake",
      "to": "window_split",
      "pass": "artifact"
    },
    {
      "from": "window_split",
      "to": "seasonal",
      "pass": "artifact",
      "when": "window_split.seasonality == true && window_split.drop_confirmed == false"
    },
    {
      "from": "window_split",
      "to": "channel_isolation",
      "pass": "artifact"
    },
    {
      "from": "channel_isolation",
      "to": "mkt_handoff",
      "pass": "artifact",
      "when": "channel_isolation.cause_channel in ['paid', 'tracking']"
    },
    {
      "from": "channel_isolation",
      "to": "mechanism",
      "pass": "artifact"
    },
    {
      "from": "mkt_handoff",
      "to": "mkt_drain",
      "pass": "artifact"
    },
    {
      "from": "mkt_drain",
      "to": "handed_off",
      "pass": "artifact"
    },
    {
      "from": "mechanism",
      "to": "scope",
      "pass": "artifact"
    },
    {
      "from": "scope",
      "to": "layers",
      "pass": "artifact"
    },
    {
      "from": "layers",
      "to": "contour",
      "pass": "artifact"
    },
    {
      "from": "contour",
      "to": "hypotheses",
      "pass": "artifact"
    },
    {
      "from": "hypotheses",
      "to": "critic",
      "pass": "artifact"
    },
    {
      "from": "critic",
      "to": "hypotheses",
      "pass": "same-session",
      "when": "critic.status == 'rework' && visits('critic') < 2",
      "label": "rework hypotheses"
    },
    {
      "from": "critic",
      "to": "review",
      "pass": "artifact",
      "when": "critic.status == 'pass'"
    },
    {
      "from": "critic",
      "to": "blocked",
      "pass": "artifact"
    },
    {
      "from": "review",
      "to": "package",
      "pass": "artifact",
      "when": "review.answer_kind == 'approved'"
    },
    {
      "from": "review",
      "to": "partial",
      "pass": "artifact"
    },
    {
      "from": "package",
      "to": "followups",
      "pass": "artifact"
    },
    {
      "from": "followups",
      "to": "followups_drain",
      "pass": "artifact"
    },
    {
      "from": "followups_drain",
      "to": "done",
      "pass": "artifact"
    }
  ],
  "test": {
    "id": "sdd-1",
    "sim": {
      "input": {
        "site_url": "https://example.ru",
        "affected_urls": [
          "/catalog/a"
        ]
      },
      "stubs": {
        "intake": {
          "status": "proceed",
          "freeze_due": "",
          "log_path": "log.md",
          "windows_path": "windows.md"
        },
        "mechanism": {
          "mechanism_path": "mechanism.md",
          "labels": [
            "ranking"
          ]
        },
        "scope": {
          "scope": "template",
          "scope_path": "scope.md"
        },
        "layers": {
          "findings_paths": [
            "layer.md"
          ],
          "defects": [],
          "skipped_branches": []
        },
        "contour": {
          "contour": "template",
          "contour_path": "contour.md"
        },
        "hypotheses": {
          "hypotheses_path": "hypotheses.md",
          "pilot_path": "pilot.md",
          "top_count": 3,
          "followup_orders": []
        },
        "critic": {
          "status": "pass",
          "findings": []
        },
        "package": {
          "diagnosis_path": ".agents/seo/drop-diagnosis/2026-11-06/diagnosis.md"
        },
        "window_split": {
          "drop_confirmed": true,
          "seasonality": false,
          "split_path": "split.json"
        },
        "channel_isolation": {
          "cause_channel": "organic",
          "report_path": "channels.json"
        },
        "followups": {
          "intents": 1
        },
        "followups_drain": {
          "dispatched_count": 1,
          "dispatched_ids": [
            "wfrun_refresh_7"
          ]
        }
      },
      "expect_path": [
        "intake",
        "window_split",
        "channel_isolation",
        "mechanism",
        "scope",
        "layers",
        "contour",
        "hypotheses",
        "critic",
        "review",
        "package",
        "followups",
        "followups_drain",
        "done"
      ],
      "expect_outputs": [
        "status == 'done'",
        "hypotheses_path != ''"
      ],
      "human_answers": {
        "review": {
          "answer": "pilot A",
          "answer_kind": "approved"
        }
      },
      "expect_output": {
        "status": "done",
        "dispatched_count": 1
      },
      "variant_seasonal": {
        "stubs": {
          "window_split": {
            "drop_confirmed": false,
            "seasonality": true,
            "split_path": "split.json"
          }
        },
        "expect_path": [
          "intake",
          "window_split",
          "seasonal"
        ],
        "expect_output": {
          "status": "seasonal"
        }
      },
      "variant_paid_cause": {
        "stubs": {
          "channel_isolation": {
            "cause_channel": "tracking",
            "report_path": "channels.json"
          },
          "mkt_handoff": {
            "intents": 1
          },
          "mkt_drain": {
            "dispatched_count": 1,
            "dispatched_ids": [
              "wfrun_tracking_9"
            ]
          }
        },
        "expect_path": [
          "intake",
          "window_split",
          "channel_isolation",
          "mkt_handoff",
          "mkt_drain",
          "handed_off"
        ],
        "expect_output": {
          "status": "handed_off",
          "dispatched_count": 1
        }
      }
    },
    "live": "прогон диагноза по завершившемуся апдейту или ведру drop из seo-monitor",
    "note": "Tested on stubs. During an active core update the intake freezes the run until T_end+7; fixes run in other graphs."
  },
  "goal_check": "artifact"
}
