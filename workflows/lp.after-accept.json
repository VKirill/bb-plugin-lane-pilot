{
  "schemaVersion": 1,
  "id": "lp.after-accept",
  "startedBy": "merge",
  "name": {
    "en": "After acceptance",
    "ru": "После приёмки"
  },
  "description": {
    "en": "What Lane Pilot does once a task is accepted: the memory maintainer keeps what the task taught. A failure leaves the accepted task as it is.",
    "ru": "Что Lane Pilot делает после приёмки задачи: хранитель памяти записывает то, чему задача научила. Сбой не трогает принятую задачу."
  },
  "category": "service",
  "not_for": [
    "anything a person asks for: Lane Pilot starts this itself when a task is merged"
  ],
  "inputs": [
    {
      "name": "run_id",
      "type": "string"
    },
    {
      "name": "task_id",
      "type": "string"
    },
    {
      "name": "pm_thread_id",
      "type": "string"
    }
  ],
  "outputs": [
    {
      "name": "memory_state",
      "type": "string"
    }
  ],
  "status": "published",
  "version": 1,
  "guards": {
    "maxSteps": 10,
    "maxFanOut": 1
  },
  "triggers": [
    {
      "type": "manual"
    }
  ],
  "scope": {
    "level": "builtin"
  },
  "nodes": [
    {
      "id": "memory",
      "type": "agent",
      "label": "Memory maintenance",
      "role": "memory-maintainer",
      "uses": "lp.memory-maintenance",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "proof": {
        "kind": "receipt",
        "check": "the stage receipt memory-maintenance holds the verdict of the maintainer thread and the records it stored"
      },
      "output": [
        {
          "name": "state",
          "type": "string"
        },
        {
          "name": "reason",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "id": "gather",
      "type": "action",
      "action": "lp.after-accept.join",
      "label": "Done",
      "output": [
        {
          "name": "memory_state",
          "type": "string"
        }
      ]
    },
    {
      "id": "done",
      "type": "action",
      "action": "emit",
      "map": {
        "memory_state": "gather.memory_state"
      }
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "memory"
    },
    {
      "from": "memory",
      "to": "gather",
      "with": {
        "memory_state": "memory.state",
        "memory_reason": "memory.reason"
      }
    },
    {
      "from": "gather",
      "to": "done"
    }
  ]
}
