    "./judgments/host-command": "./src/judgments/host-command.ts",
    "./judgments/citation-check": "./src/judgments/citation-check.ts",
    "./judgments/memory-rerank": "./src/judgments/memory-rerank.ts",
    "./judgments/invoice-scan": "./src/judgments/invoice-scan.ts",
    "./judgments/log-find": "./src/judgments/log-find.ts",
    "./judgments/skill-tree-pick": "./src/judgments/skill-tree-pick.ts",
    "./judgments/accept-composite": "./src/judgments/accept-composite.ts",
