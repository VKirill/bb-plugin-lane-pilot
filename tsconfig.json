{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./*"],
      "elkjs/lib/elk.bundled.js": ["./src/rooms/workflow/ui/elk-shim.d.ts"],
      "@lane-pilot/harness-core": ["./packages/harness-core/src/index.ts"],
      "@lane-pilot/settings-catalog": ["./packages/settings-catalog/src/index.ts"],
      "@lane-pilot/i18n": ["./packages/i18n/src/index.ts"]
    },
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": false
  },
  "include": ["server.ts", "host.ts", "app.tsx", "src", "tests", "packages"]
}
