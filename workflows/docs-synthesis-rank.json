{
  "id": "docs-synthesis-rank",
  "internal": true,
  "status": "published",
  "goal_check": "validate",
  "name": {
    "en": "Count a precedence entry",
    "ru": "Учесть запись приоритета"
  },
  "description": {
    "en": "Internal subworkflow that evaluates and echoes one document precedence kind for docs-synthesis conflict resolution.",
    "ru": "Внутренний подграф, который оценивает и возвращает тип приоритета документа при разрешении конфликтов в docs-synthesis."
  },
  "category": "docs",
  "inputs": {
    "kind": {
      "type": "string",
      "required": true
    }
  },
  "outputs": {
    "kind": "string"
  },
  "nodes": [
    {
      "id": "echo",
      "type": "action",
      "action": "emit",
      "map": {
        "kind": "$inputs.kind"
      },
      "out": {
        "kind": "string"
      }
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "echo"
    }
  ],
  "not_for": [
    "docs-synthesis",
    "docs-synthesis-check"
  ]
}
