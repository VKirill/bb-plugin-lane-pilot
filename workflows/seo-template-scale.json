{
  "id": "seo-template-scale",
  "name": {
    "en": "SEO template scale",
    "ru": "SEO-масштаб шаблонов"
  },
  "description": {
    "en": "Template-level work for catalogs and service/geo matrices: page-type passports, the facet whitelist and stock-driven indexation rules, a commercial investigation chain, the service hierarchy and Difference Map for geo pages, the proof layer, and batch meta and alt generation. The critic samples the result, the owner approves the pilot cohort, and every rollout goes through seo-release.",
    "ru": "Шаблонная работа для каталогов и матриц услуг/гео: паспорта типов страниц, белый список фасет и правила индексации по остаткам, коммерческая цепочка исследования, иерархия услуг и Difference Map для гео-страниц, слой доказательств и пакетная генерация мета и alt. Критик выборочно проверяет результат, владелец утверждает пилотную когорту, а каждый выкат идёт через seo-release."
  },
  "examples": {
    "ru": [
      "Собери шаблоны категорий и карточек для каталога",
      "Построй матрицу гео-страниц услуги по location-registry",
      "Сгенерируй мета и alt для импорта в CMS"
    ],
    "en": [
      "Build the category and PDP templates for the catalog",
      "Build the geo-page matrix for a service from the location registry",
      "Generate meta and alt text for a CMS import"
    ]
  },
  "not_for": [
    "seo-cocoon: a topical cocoon of hand-planned articles, not template pages from an entity matrix",
    "seo-page: one flagship page written by hand",
    "seo-release: shipping without new templates",
    "mkt-direct-search-campaign: ad groups, not site pages"
  ],
  "status": "published",
  "tags": [
    "seo",
    "drmax"
  ],
  "inputs": {
    "mode": {
      "type": "catalog|service_geo|meta_alt|bofu_programmatic",
      "default": "catalog",
      "description": "catalog and PDP templates, service x geo matrix, batch meta/alt, or BOFU comparison/alternative/migration/integration pages through Content Factory"
    },
    "catalog_export_path": {
      "type": "string",
      "default": "",
      "note": "выгрузка каталога/CMS: атрибуты, остатки, цены"
    },
    "location_registry_path": {
      "type": "string",
      "default": ""
    },
    "demand_data_path": {
      "type": "string",
      "default": "",
      "note": "платные данные спроса только с согласия владельца"
    },
    "proofs_path": {
      "type": "string",
      "default": "",
      "note": "кейсы, отзывы, мастера - данные владельца"
    },
    "target": {
      "type": "string",
      "default": "",
      "note": "CMS или репозиторий, куда выкатываем"
    }
  },
  "outputs": {
    "status": "done|blocked",
    "passports_path": "string?",
    "facet_matrix_path": "string?",
    "geo_specs_path": "string?",
    "meta_import_path": "string?",
    "verdict_path": "string?",
    "release_report_path": "string?",
    "cf_batch_id": "string?"
  },
  "requires": {
    "plugins": [
      "lane-pilot"
    ],
    "skills": [
      "seo-agent",
      "seo-tools",
      "seo-page-templates",
      "seo-release-protocol",
      "seo-measurement-loop",
      "seo-programmatic-bofu",
      "drmax-latent-intent"
    ],
    "secrets": [
      "XMLSTOCK_KEY?"
    ]
  },
  "budget": {
    "max_minutes": 240,
    "max_usd": 12
  },
  "entry": "passports",
  "nodes": [
    {
      "id": "passports",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "skip_when": "$inputs.mode == 'meta_alt'",
      "skip_out": {
        "passports_path": ""
      },
      "title": {
        "en": "Page-type passports",
        "ru": "Паспорта типов страниц"
      },
      "prompt": "Commercial page-type registry with template passports: the category L1 layout and the PDP template with variants plus a raw-HTML validation spec. Return passports_path.",
      "out": {
        "passports_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 40
      },
      "profile": {
        "skills": [
          "seo-page-templates"
        ]
      }
    },
    {
      "id": "facets_stock",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "skip_when": "$inputs.mode != 'catalog'",
      "skip_out": {
        "facet_matrix_path": "",
        "indexation_rules_path": ""
      },
      "title": {
        "en": "Facet whitelist and stock indexation",
        "ru": "Белый список фасет и индексация по остаткам"
      },
      "prompt": "Whitelist SEO filters by demand and stock: the robots-meta and sitemap rules per stock band, and what to do with trafficless subcategories. Demand data only from the provided export. Return facet_matrix_path and indexation_rules_path.",
      "out": {
        "facet_matrix_path": "string",
        "indexation_rules_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 40
      },
      "profile": {
        "skills": [
          "seo-page-templates",
          "seo-tools"
        ]
      }
    },
    {
      "id": "commercial_chain",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "skip_when": "$inputs.mode != 'catalog'",
      "skip_out": {
        "chain_specs_path": ""
      },
      "title": {
        "en": "Commercial investigation chain",
        "ru": "Коммерческая цепочка"
      },
      "prompt": "Spec the commercial investigation chain: curated selections, brand nodes and comparison pages between category and SKU. Return chain_specs_path.",
      "out": {
        "chain_specs_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 30
      },
      "profile": {
        "skills": [
          "seo-page-templates"
        ]
      }
    },
    {
      "id": "service_geo",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "skip_when": "$inputs.mode != 'service_geo'",
      "skip_out": {
        "geo_specs_path": ""
      },
      "title": {
        "en": "Service hierarchy and geo pages",
        "ru": "Иерархия услуг и гео-страницы"
      },
      "prompt": "Main service and sub-service hierarchy from the location registry: the eligibility gate and Difference Map for geo pages, layered Data-Shift builds, and branch pages with LocalBusiness @graph plus sitemap-locations. Return geo_specs_path.",
      "out": {
        "geo_specs_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 40
      },
      "profile": {
        "skills": [
          "seo-page-templates"
        ]
      }
    },
    {
      "id": "proof",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "skip_when": "$inputs.mode != 'service_geo'",
      "skip_out": {
        "proof_specs_path": ""
      },
      "title": {
        "en": "Proof layer",
        "ru": "Слой доказательств"
      },
      "prompt": "Tag schema and rendering rules for cases, reviews and Q&A from the owner-supplied records in {{$inputs.proofs_path}}; never invent a record. Return proof_specs_path.",
      "out": {
        "proof_specs_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 30
      },
      "profile": {
        "skills": [
          "seo-page-templates"
        ]
      }
    },
    {
      "id": "bofu_matrix",
      "type": "agent",
      "role": "specialist:seo-specialist",
      "skip_when": "$inputs.mode != 'bofu_programmatic'",
      "skip_out": {
        "matrix_path": "",
        "rows": 0
      },
      "profile": {
        "skills": [
          "seo-programmatic-bofu",
          "drmax-latent-intent",
          "seo-page-templates"
        ]
      },
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "title": {
        "en": "BOFU entity matrix",
        "ru": "Матрица BOFU-сущностей"
      },
      "prompt": "Build the BOFU entity matrix from the catalog and demand exports ({{$inputs.catalog_export_path}}, {{$inputs.demand_data_path}}): Comparison (X vs Y), Alternative to X, Migration from X, Integration with X, Role/Use-case. One row per page candidate with the target query, the parent page, the verified facts available from brandcore/fact registry, and the SERP top-10. No row without real demand. Return matrix_path and rows.",
      "out": {
        "matrix_path": "string",
        "rows": "int"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 40
      }
    },
    {
      "id": "info_gain",
      "type": "action",
      "action": "sp.run_script",
      "title": {
        "en": "Information-gain gate and cannibalization guard ($0)",
        "ru": "Гейт прироста информации и защита от каннибализации ($0)"
      },
      "skip_when": "$inputs.mode != 'bofu_programmatic'",
      "skip_out": {
        "passed": 0,
        "absorbed": 0,
        "report_path": ""
      },
      "skill": "seo-programmatic-bofu",
      "script": "cannibalization_guard.py",
      "args": {
        "matrix": "{{bofu_matrix.matrix_path}}",
        "serp_overlap_lt": 0.4,
        "min_unique_facts": 3
      },
      "timeoutSec": 120,
      "out": {
        "passed": "int",
        "absorbed": "int",
        "report_path": "string"
      }
    },
    {
      "id": "similarity",
      "type": "action",
      "action": "sp.run_script",
      "title": {
        "en": "Near-duplicate check ($0)",
        "ru": "Проверка почти-дублей ($0)"
      },
      "skip_when": "$inputs.mode != 'bofu_programmatic'",
      "skip_out": {
        "near_duplicates": 0,
        "report_path": ""
      },
      "skill": "seo-programmatic-bofu",
      "script": "offerist_similarity.py",
      "args": {
        "matrix": "{{info_gain.report_path}}",
        "threshold": 0.72
      },
      "timeoutSec": 120,
      "out": {
        "near_duplicates": "int",
        "report_path": "string"
      }
    },
    {
      "id": "meta_alt",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "title": {
        "en": "Batch meta and alt",
        "ru": "Пакетные мета и alt"
      },
      "prompt": "CMS meta formulas with null fallbacks, batch LLM meta with a pre-import audit, slot-based gallery alt and the vision-LLM media audit. Return meta_import_path and the release_items list of spec/import paths this run produced.",
      "out": {
        "meta_import_path": "string",
        "release_items": "string[]"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 40
      },
      "profile": {
        "skills": [
          "seo-page-templates"
        ]
      },
      "skip_when": "$inputs.mode == 'bofu_programmatic'",
      "skip_out": {
        "meta_import_path": "",
        "release_items": []
      }
    },
    {
      "id": "critic",
      "produces": [
        {
          "kind": "verdict",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "auditor",
      "title": {
        "en": "Pilot sample verdict",
        "ru": "Вердикт по пилотной выборке"
      },
      "prompt": "Sample 20 generated pages or meta records per template: uniqueness, geo differentiation, null-variable leaks, protected-page locks. Verdict status pass | rework; findings carry severity critical | high | medium | low | info. Return status, verdict_path, pilot_items. In bofu_programmatic mode also check: every page passed the information-gain gate ({{info_gain.passed}} passed, {{info_gain.absorbed}} absorbed into parents), near-duplicates are 0 ({{similarity.near_duplicates}}), no doorway or scaled thin content (DrMax canon), and the first wave is at most 15 URLs. Verify modular block-engine pre-flight (references/modular-seo-block-engine-and-60pt-audit.md): DoD D1–D10 green on one URL per page type, shingle overlap of block text < 0.6 (Hero/CTA/Contacts excluded), and express audit score >= 70 with zero critical ERR.",
      "out": {
        "status": "pass|rework",
        "verdict_path": "string",
        "pilot_items": "string[]"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 30
      },
      "profile": {
        "skills": [
          "seo-page-templates",
          "seo-measurement-loop"
        ]
      }
    },
    {
      "id": "approve",
      "type": "human",
      "role": "owner",
      "title": {
        "en": "Approve specs and pilot",
        "ru": "Утверждение спецификаций и пилота"
      },
      "prompt": "Approve the template specs and the pilot cohort with the critic verdict in front of you. approve sends the pilot to seo-release; anything else stops the run.",
      "out": {
        "answer": "string",
        "answer_kind": "approve|decline|timeout"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 1440
      }
    },
    {
      "id": "rollout",
      "type": "subworkflow",
      "workflow": "seo-release",
      "title": {
        "en": "Cohort rollout",
        "ru": "Выкат когорты"
      },
      "with": {
        "mode": "template_cohort",
        "items": "{{critic.pilot_items}}",
        "target": "{{$inputs.target}}"
      },
      "out": {
        "status": "string",
        "release_report_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 240
      },
      "profile": {
        "skills": [
          "seo-release-protocol"
        ]
      },
      "skip_when": "$inputs.mode == 'bofu_programmatic'",
      "skip_out": {
        "status": "skipped",
        "release_report_path": ""
      }
    },
    {
      "id": "cf_handoff",
      "type": "action",
      "action": "sp.run_script",
      "title": {
        "en": "Build the lp.cf-batch/1 pilot (<= 15 URLs) ($0)",
        "ru": "Собрать пилот lp.cf-batch/1 (<= 15 URL) ($0)"
      },
      "skip_when": "$inputs.mode != 'bofu_programmatic'",
      "skip_out": {
        "batch_path": "",
        "pilot_size": 0,
        "wave": 0,
        "orders": []
      },
      "skill": "seo-programmatic-bofu",
      "script": "cf_batch_handoff.py",
      "args": {
        "passed": "{{info_gain.report_path}}",
        "similarity": "{{similarity.report_path}}",
        "pilot_max": 15,
        "next_wave_min_indexation_14d": 0.65
      },
      "timeoutSec": 60,
      "out": {
        "batch_path": "string",
        "pilot_size": "int",
        "wave": "int",
        "orders": "ActionOrder[]"
      }
    },
    {
      "id": "cf_commit",
      "type": "action",
      "action": "sp.commit_memory",
      "title": {
        "en": "Batch order + 21-day indexation lock",
        "ru": "Приказ на пачку + 21-дневный замок индексации"
      },
      "skip_when": "$inputs.mode != 'bofu_programmatic'",
      "skip_out": {
        "intents": 0,
        "batch_id": ""
      },
      "phase": "intents",
      "domain": "seo",
      "orders": "{{cf_handoff.orders}}",
      "ownerAnswer": "{{approve.answer_kind}}",
      "out": {
        "intents": "int",
        "batch_id": "string"
      }
    },
    {
      "id": "cf_drain",
      "type": "action",
      "action": "sp.dispatch_tasks",
      "title": {
        "en": "Submit to Content Factory (bb cf, idempotent)",
        "ru": "Отправить в Контент завод (bb cf, идемпотентно)"
      },
      "skip_when": "$inputs.mode != 'bofu_programmatic'",
      "skip_out": {
        "dispatched_count": 0,
        "dispatched_ids": []
      },
      "domain": "seo",
      "sourceGraph": "seo-template-scale",
      "out": {
        "dispatched_count": "int",
        "dispatched_ids": "string[]"
      }
    },
    {
      "id": "package",
      "type": "action",
      "action": "fs.write",
      "path": ".agents/seo/template-scale/{{run_id}}/",
      "files": [
        "template-passports.md",
        "facet-matrix.json",
        "geo-specs.md",
        "meta-import.json",
        "pilot-verdict.md"
      ],
      "note": "Write the template-scale report package",
      "out": {
        "package_path": "string"
      }
    },
    {
      "id": "done",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "done",
        "passports_path": "passports.passports_path",
        "facet_matrix_path": "facets_stock.facet_matrix_path",
        "geo_specs_path": "service_geo.geo_specs_path",
        "meta_import_path": "meta_alt.meta_import_path",
        "verdict_path": "critic.verdict_path",
        "release_report_path": "rollout.release_report_path",
        "cf_batch_id": "cf_commit.batch_id"
      }
    },
    {
      "id": "blocked",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "blocked"
      }
    }
  ],
  "edges": [
    {
      "from": "passports",
      "to": "facets_stock",
      "pass": "artifact"
    },
    {
      "from": "facets_stock",
      "to": "commercial_chain",
      "pass": "artifact"
    },
    {
      "from": "commercial_chain",
      "to": "service_geo",
      "pass": "artifact"
    },
    {
      "from": "service_geo",
      "to": "proof",
      "pass": "artifact"
    },
    {
      "from": "meta_alt",
      "to": "critic",
      "pass": "artifact"
    },
    {
      "from": "critic",
      "to": "approve",
      "pass": "artifact"
    },
    {
      "from": "approve",
      "to": "rollout",
      "pass": "artifact",
      "when": "approve.answer_kind == 'approve'"
    },
    {
      "from": "approve",
      "to": "blocked",
      "pass": "artifact"
    },
    {
      "from": "package",
      "to": "done",
      "pass": "artifact"
    },
    {
      "from": "proof",
      "to": "bofu_matrix",
      "pass": "artifact"
    },
    {
      "from": "bofu_matrix",
      "to": "info_gain",
      "pass": "artifact"
    },
    {
      "from": "info_gain",
      "to": "similarity",
      "pass": "artifact"
    },
    {
      "from": "similarity",
      "to": "meta_alt",
      "pass": "artifact"
    },
    {
      "from": "rollout",
      "to": "cf_handoff",
      "pass": "artifact"
    },
    {
      "from": "cf_handoff",
      "to": "cf_commit",
      "pass": "artifact"
    },
    {
      "from": "cf_commit",
      "to": "cf_drain",
      "pass": "artifact"
    },
    {
      "from": "cf_drain",
      "to": "package",
      "pass": "artifact"
    }
  ],
  "test": {
    "id": "stpl-1",
    "sim": {
      "input": {
        "mode": "catalog",
        "catalog_export_path": ".agents/seo/shop/catalog-export.json",
        "target": "cms:shop"
      },
      "stubs": {
        "passports": {
          "passports_path": "template-passports.md"
        },
        "facets_stock": {
          "facet_matrix_path": "facet-matrix.json",
          "indexation_rules_path": "indexation-rules.md"
        },
        "commercial_chain": {
          "chain_specs_path": "chain-specs.md"
        },
        "meta_alt": {
          "meta_import_path": "meta-import.json",
          "release_items": [
            "meta-import.json"
          ]
        },
        "critic": {
          "status": "pass",
          "verdict_path": "pilot-verdict.md",
          "pilot_items": [
            "meta-import.json"
          ]
        },
        "rollout": {
          "status": "done",
          "release_report_path": ".agents/seo/release/r1/release-report.md"
        },
        "package": {
          "package_path": ".agents/seo/template-scale/r1/"
        }
      },
      "expect_path": [
        "passports",
        "facets_stock",
        "commercial_chain",
        "service_geo",
        "proof",
        "bofu_matrix",
        "info_gain",
        "similarity",
        "meta_alt",
        "critic",
        "approve",
        "rollout",
        "cf_handoff",
        "cf_commit",
        "cf_drain",
        "package",
        "done"
      ],
      "expect_outputs": [
        "status == 'done'"
      ],
      "human_answers": {
        "approve": {
          "answer_kind": "approve",
          "answer": "approve"
        }
      },
      "expect_output": {
        "status": "done"
      },
      "variant_bofu_pilot": {
        "input": {
          "mode": "bofu_programmatic"
        },
        "human_answers": {
          "approve": {
            "answer_kind": "approve",
            "answer": "approve"
          }
        },
        "stubs": {
          "bofu_matrix": {
            "matrix_path": "bofu-matrix.json",
            "rows": 48
          },
          "info_gain": {
            "passed": 15,
            "absorbed": 21,
            "report_path": "info-gain.json"
          },
          "similarity": {
            "near_duplicates": 0,
            "report_path": "similarity.json"
          },
          "critic": {
            "status": "pass",
            "verdict_path": "pilot-verdict.md",
            "pilot_items": [
              "bofu-matrix.json"
            ]
          },
          "cf_handoff": {
            "batch_path": ".agents/seo/batches/cfb_9f1c.json",
            "pilot_size": 15,
            "wave": 1,
            "orders": []
          },
          "cf_commit": {
            "intents": 1,
            "batch_id": "cfb_9f1c"
          },
          "cf_drain": {
            "dispatched_count": 1,
            "dispatched_ids": [
              "cfb_9f1c"
            ]
          }
        },
