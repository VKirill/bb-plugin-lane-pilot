{
  "id": "security-audit",
  "name": {
    "en": "Security audit (read-only)",
    "ru": "Аудит безопасности (только чтение)"
  },
  "description": {
    "en": "Tiered read-only audit - OWASP Top 10, dependencies, secrets, CI/CD, and on the deep tier STRIDE and git history. Report with severity matrix and file:line. Secrets are reported by location, never by value.",
    "ru": "Ярусный аудит только на чтение - OWASP Top 10, зависимости, секреты, CI/CD, а на глубоком ярусе STRIDE и история git. Отчёт с матрицей критичности и file:line. Секреты указываются по расположению, не по значению."
  },
  "examples": {
    "ru": [
      "Проверь проект на уязвимости, ничего не меняй",
      "Проведи аудит безопасности авторизации и работы с токенами",
      "Поищи в репозитории утёкшие секреты и опасные зависимости",
      "Сделай глубокий аудит безопасности перед релизом"
    ],
    "en": [
      "Scan the project for vulnerabilities, change nothing",
      "Audit the security of authorization and token handling",
      "Look for leaked secrets and risky dependencies in the repository",
      "Do a deep security audit before release"
    ]
  },
  "not_for": [
    "code-review",
    "quality-loop"
  ],
  "status": "published",
  "inputs": {
    "scope": {
      "type": "string"
    },
    "tier": {
      "type": "quick|standard|deep",
      "default": "standard"
    },
    "phase_id": {
      "type": "string",
      "default": "",
      "note": "a phase whose .agents/phases/<id>/SECURITY.md threat register is verified against the code; without it the audit is the plain one"
    }
  },
  "outputs": {
    "status": "done|blocked",
    "findings": "Finding[]",
    "severity_distribution": "any",
    "tier": "string",
    "report_path": "string",
    "proposed_workflow": "string"
  },
  "quality_mode": {
    "default": "standard",
    "effect": "ярус: quick - quick, standard - standard, full - deep"
  },
  "requires": {
    "plugins": [
      "lane-pilot"
    ],
    "skills": [
      "cybersecurity-audit"
    ],
    "project": {
      "git": true
    }
  },
  "budget": {
    "max_minutes": 90
  },
  "entry": "recon",
  "nodes": [
    {
      "id": "recon",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "analyst",
      "src": "maestro-flow:odyssey-security.md",
      "prompt": "Read-only reconnaissance - stack, entry points, authentication, data flows, secrets locations. No entry points found means BLOCKED.",
      "out": {
        "entry_points": "string[]",
        "stack": "string[]",
        "auth": "string",
        "found_entry_points": "bool"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 20
      }
    },
    {
      "id": "scan",
      "type": "parallel",
      "for_each": {
        "by": "$inputs.tier",
        "quick": [
          "owasp",
          "secrets"
        ],
        "standard": [
          "owasp",
          "secrets",
          "dependencies",
          "ci_cd"
        ],
        "deep": [
          "owasp",
          "secrets",
          "dependencies",
          "ci_cd",
          "stride",
          "git_history"
        ]
      },
      "child": {
        "produces": [
          {
            "kind": "findings",
            "version": 1
          }
        ],
        "type": "agent",
        "role": "code-critic",
        "session": "new",
        "src": "maestro-flow:odyssey-security.md",
        "prompt": "Scan phase {{item}}. OWASP A01-A10 per entry point; dependencies by the package manager's audit (an unavailable audit is a warning, not a failure); secrets by LOCATION only, never print a value; STRIDE per trust boundary; git history for committed secrets. Do not lower an OWASP severity without a stated reason; a false positive is closed only with counter-evidence. Every finding: file:line, severity (critical|high|medium|low|info), remediation.",
        "out": {
          "phase": "string",
          "findings": "Finding[]",
          "warnings": "string[]"
        }
      },
      "join": {
        "policy": "all",
        "out": {
          "findings": "Finding[]",
          "warnings": "string[]",
          "critical_count": "int",
          "high_count": "int"
        },
        "uses": "reduce.security-audit.scan"
      },
      "concurrency": 5
    },
    {
      "id": "threat_model",
      "type": "agent",
      "role": "code-critic",
      "session": "new",
      "title": {
        "en": "Verify the phase threat register",
        "ru": "Проверить реестр угроз этапа"
      },
      "skip_when": "!$inputs.phase_id",
      "skip_out": {
        "findings": [],
        "verification": ""
      },
      "produces": [
        {
          "kind": "findings",
          "version": 1
        }
      ],
      "prompt": "Read .agents/phases/{{$inputs.phase_id}}/SECURITY.md. No threat register there means an empty findings list. Check each named threat against the code: verdict mitigated|partial|missing with file:line; a missing threat is a finding of severity high; every finding has file:line, severity (critical|high|medium|low|info) and remediation. Return the per-threat table under '## Verified against the code' as raw Markdown in verification; the code-owned writer appends it to SECURITY.md. This read-only helper does not write files.",
      "out": {
        "findings": "Finding[]",
        "verification": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 20
      }
    },
    {
      "id": "report",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "analyst",
      "prompt": "Build the severity matrix CRITICAL/HIGH/MEDIUM/LOW from inputs.scan_findings and the findings in the consumed threat_model output. Include file:line, impact and remediation per finding; group by root cause across both sources. Use inputs.scan_critical_count and inputs.scan_high_count as the scan totals, not totals for the threat register. Preserve inputs.scan_warnings and identify scan phases or checks that could not run; an unavailable check is not a clean result. Secrets remain locations only, never values. Return the complete raw Markdown report text in document; the code-owned writer persists it. This read-only helper does not write files.",
      "out": {
        "document": "string",
        "severity_distribution": "any"
      },
      "guards": {
        "maxVisits": 1
      },
      "consumes": [
        {
          "kind": "findings",
          "version": 1,
          "from": "threat_model"
        }
      ]
    },
    {
      "id": "write_threat_model",
      "type": "action",
      "action": "fs.write",
      "skip_when": "!$inputs.phase_id || !threat_model.verification",
      "skip_out": {
        "security_path": ""
      },
      "path": ".agents/phases/{{$inputs.phase_id}}/SECURITY.md",
      "mode": "append",
      "contents": "{{threat_model.verification}}",
      "out": {
        "security_path": "string"
      }
    },
    {
      "id": "write_report",
      "type": "action",
      "action": "fs.write",
      "path": ".agents/planning/SECURITY-AUDIT.md",
      "contents": "{{report.document}}",
      "out": {
        "report_path": "string"
      }
    },
    {
      "id": "offer",
      "type": "action",
      "action": "lp.propose_workflow",
      "workflow": "review-fix",
      "inputs": {
        "findings": "{{scan.findings}}"
      }
    },
    {
      "id": "done",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "done",
        "findings": "scan.findings",
        "severity_distribution": "report.severity_distribution",
        "tier": "$inputs.tier",
        "report_path": "write_report.report_path"
      }
    },
    {
      "id": "done_offer",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "done",
        "findings": "scan.findings",
        "severity_distribution": "report.severity_distribution",
        "tier": "$inputs.tier",
        "report_path": "write_report.report_path",
        "proposed_workflow": "review-fix"
      }
    },
    {
      "id": "blocked",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "blocked"
      }
    },
    {
      "id": "goal_check",
      "type": "action",
      "action": "deliverable.validate",
      "title": {
        "en": "Check the goal was met",
        "ru": "Проверить, что цель достигнута"
      },
      "rule": "validateDeliverable on the artifact the run produced: the deliverable/validator/brief inputs name what to check; a fail means the goal is not met",
      "out": {
        "ok": "bool",
        "verdict": "pass|rework|fail",
        "reason": "string",
        "details": "object"
      }
    }
  ],
  "edges": [
    {
      "from": "recon",
      "to": "blocked",
      "pass": "artifact",
      "when": "!recon.found_entry_points"
    },
    {
      "from": "recon",
      "to": "scan",
      "pass": "artifact"
    },
    {
      "from": "scan",
      "to": "threat_model",
      "pass": "artifact"
    },
    {
      "from": "threat_model",
      "to": "write_threat_model",
      "pass": "artifact",
      "with": {}
    },
    {
      "from": "write_threat_model",
      "to": "report",
      "pass": "artifact",
      "with": {
        "scan_findings": "scan.findings",
        "scan_warnings": "scan.warnings",
        "scan_critical_count": "scan.critical_count",
        "scan_high_count": "scan.high_count"
      }
    },
    {
      "from": "report",
      "to": "write_report",
      "pass": "artifact",
      "with": {}
    },
    {
      "from": "write_report",
      "to": "offer",
      "pass": "artifact",
      "when": "scan.critical_count + scan.high_count > 0"
    },
    {
      "from": "write_report",
      "to": "goal_check",
      "pass": "artifact",
      "with": {
        "path": "write_report.report_path"
      }
    },
    {
      "from": "offer",
      "to": "done_offer",
      "pass": "artifact"
    },
    {
      "from": "goal_check",
      "to": "done",
      "when": "goal_check.ok != false"
    },
    {
      "from": "goal_check",
      "to": "blocked"
    }
  ],
  "test": {
    "id": "sa-1",
    "sim": {
      "input": {
        "scope": ".",
        "tier": "quick"
      },
      "stubs": {
        "recon": {
          "found_entry_points": true
        },
        "scan": {
          "findings": [
            {
              "severity": "high",
              "file": "src/auth.ts",
              "line": 9,
              "evidence": "token compared with =="
            }
          ],
          "high_count": 1,
          "critical_count": 0
        }
      },
      "expect_path": [
        "recon",
        "scan",
        "threat_model",
        "write_threat_model",
        "report",
        "write_report",
        "offer",
        "done_offer"
      ],
      "expect_outputs": [
        "status == 'done'",
        "findings.length >= 1",
        "no secret values in output"
      ]
    },
    "live": "песочница с подложенным фальшивым ключом в .env.example: находка указывает место, значения в отчёте нет"
  },
  "goal_check": "validate"
}
