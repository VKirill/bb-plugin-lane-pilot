{
  "id": "project-start",
  "name": {
    "en": "Project start (value map first)",
    "ru": "Старт проекта (сначала карта ценности)"
  },
  "description": {
    "en": "Starts work on a project: what the tree itself counts, a value map before any question (who it is for, what they get, how we know), a preview of the stack, the tests and the memory it already has, the infra profile written by the one writer that refuses secrets, a question round for what is still missing, research into stack, features, architecture and pitfalls, the requirements, then a recap with next steps, PROJECT.md and the roadmap skeleton. An install that already has the map, the roadmap and the profile only gets pointed at resume-project.",
    "ru": "Начинает работу над проектом: что считает само дерево, карта ценности до любых вопросов (для кого, что получают, как узнаем), обзор стека, тестов и уже накопленной памяти, профиль инфраструктуры через единственного писателя, который отказывает секретам, круг вопросов о том, чего ещё нет, исследование стека, функций, архитектуры и подводных камней, требования, затем итог со следующими шагами, PROJECT.md и каркасом дорожной карты. Установка, где карта, дорожная карта и профиль уже есть, получает только указание на resume-project."
  },
  "examples": {
    "ru": [
      "Начни работу над новым проектом",
      "Разберись в проекте с нуля и предложи план",
      "Сделай карту ценности проекта",
      "Подготовь старт: стек, тесты, память, инфраструктура"
    ],
    "en": [
      "Start work on a new project",
      "Get to know the project from scratch and propose a plan",
      "Build the project's value map",
      "Prepare the start: stack, tests, memory, infra"
    ]
  },
  "not_for": [
    "about-site",
    "resume"
  ],
  "status": "published",
  "inputs": {
    "project_cwd": {
      "type": "string"
    }
  },
  "outputs": {
    "status": "done|resumed|refused",
    "value_map": "string",
    "next_steps": "string[]",
    "refused": "string[]"
  },
  "quality_mode": {
    "default": "standard",
    "effect": "quick - без исследования"
  },
  "requires": {
    "plugins": [
      "lane-pilot"
    ]
  },
  "budget": {
    "max_minutes": 90
  },
  "entry": "probe",
  "nodes": [
    {
      "id": "probe",
      "type": "action",
      "action": "lp.state_probe",
      "title": {
        "en": "What already exists",
        "ru": "Что уже есть"
      },
      "out": {
        "has_passport": "bool",
        "open_tasks": "int",
        "plan_exists": "bool",
        "has_ui": "bool",
        "has_value_map": "bool",
        "has_roadmap": "bool",
        "has_profile": "bool"
      }
    },
    {
      "id": "tree",
      "type": "action",
      "action": "lp.tree_counts",
      "title": {
        "en": "What the tree counts",
        "ru": "Что считает дерево"
      },
      "out": {
        "sources": "int",
        "tests": "int",
        "docs": "int",
        "planning": "int",
        "commits": "int"
      }
    },
    {
      "id": "value_map",
      "type": "agent",
      "role": "analyst",
      "title": {
        "en": "Value map",
        "ru": "Карта ценности"
      },
      "skip_when": "probe.has_value_map",
      "skip_out": {
        "value_map": ""
      },
      "prompt": "Value map builder, before asking anything. Open .agents/planning/VALUE-MAP.md with these five lines counted from the tree itself, verbatim: sources {{tree.sources}}, tests {{tree.tests}}, docs {{tree.docs}}, planning artifacts {{tree.planning}}, commits {{tree.commits}}. Then from README, the passport (project-onboard), the site and the code — who the product is for, the job they hire it for, what they get, how we would know it works.",
      "out": {
        "value_map": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 25
      },
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ]
    },
    {
      "id": "preview",
      "type": "agent",
      "role": "analyst",
      "title": {
        "en": "Stack, tests, memory preview",
        "ru": "Стек, тесты, память"
      },
      "prompt": "Stack and tests: languages, frameworks, the test command and whether it is green. Memory preview: lane_pilot_memory context (what the hub corpus already knows), the memory graph of notes by area. Infra profile: hosts, start, deploy, logs — return it as the JSON object `profile` (key: value); you never run the writer yourself, the next step is the one profile writer and it refuses secrets.",
      "out": {
        "stack": "any",
        "memory": "any",
        "profile": "any"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 25
      },
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "consumes": [
        {
          "kind": "report",
          "version": 1,
          "from": "value_map"
        }
      ]
    },
    {
      "id": "profile_write",
      "type": "action",
      "action": "lp.profile_write",
      "title": {
        "en": "The one profile writer",
        "ru": "Единственный писатель профиля"
      },
      "params": {
        "profile": "{{preview.profile}}"
      },
      "out": {
        "refused": "string[]",
        "set": "string[]"
      }
    },
    {
      "id": "ask",
      "type": "human",
      "role": "owner",
      "title": {
        "en": "What is still missing",
        "ru": "Чего ещё не хватает"
      },
      "skip_when": "probe.has_profile",
      "skip_out": {
        "answer": "",
        "answer_kind": "answered"
      },
      "prompt": "Ask only for the fields still missing, at most five questions: audience, constraints, stack, money, deadline. No answer is a timeout — the run proceeds with the stated assumptions.",
      "out": {
        "answer": "string",
        "answer_kind": "answered|timeout"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 240
      }
    },
    {
      "id": "research",
      "type": "agent",
      "role": "specialist:tavily",
      "title": {
        "en": "Research before the roadmap",
        "ru": "Исследование до дорожной карты"
      },
      "applicable_modes": [
        "standard",
        "full"
      ],
      "skip_out": {
        "research_notes": ""
      },
      "prompt": "Research competitors and conventions for what the project is, from the value map and the owner's answers. Write .agents/planning/research/STACK.md, FEATURES.md, ARCHITECTURE.md and PITFALLS.md — each with its sources and what the roadmap should take from it.",
      "out": {
        "research_notes": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 25
      },
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ]
    },
    {
      "id": "requirements",
      "type": "agent",
      "role": "planner",
      "title": {
        "en": "Requirements",
        "ru": "Требования"
      },
      "prompt": "From the goal, the value map, the answers and the research: 3-7 requirements with ids into .agents/planning/REQUIREMENTS.md, the way new-milestone writes them.",
      "out": {
        "requirements": "string[]"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 25
      },
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ]
    },
    {
      "id": "recap",
      "type": "agent",
      "role": "planner",
      "title": {
        "en": "Recap and next steps",
        "ru": "Итог и шаги"
      },
      "skip_when": "probe.has_roadmap",
      "skip_out": {
        "next_steps": []
      },
      "prompt": "Working style and risk from the owner's anamnesis. Write .agents/planning/PROJECT.md from VALUE-MAP.md: Vision, Value and Limits — the no-gos and the risks the anamnesis names. Read .agents/planning/research/STACK.md, FEATURES.md, ARCHITECTURE.md and PITFALLS.md before the roadmap. Recap in five lines, three next steps, and the roadmap skeleton built from the requirements (lane-plan template fill ROADMAP, STATE; phases with lane-plan phase add).",
      "out": {
        "next_steps": "string[]"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 25
      },
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "consumes": [
        {
          "kind": "report",
          "version": 1,
          "from": "value_map"
        },
        {
          "kind": "report",
          "version": 1,
          "from": "preview"
        },
        {
          "kind": "report",
          "version": 1,
          "from": "requirements"
        }
      ]
    },
    {
      "id": "done",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "done",
        "value_map": "value_map.value_map",
        "next_steps": "recap.next_steps",
        "refused": "[]"
      }
    },
    {
      "id": "resumed",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "resumed",
        "value_map": "''",
        "next_steps": "['the project is already started — continue with resume-project']",
        "refused": "[]"
      }
    },
    {
      "id": "refused",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "refused",
        "value_map": "''",
        "next_steps": "[]",
        "refused": "profile_write.refused"
      }
    }
  ],
  "edges": [
    {
      "from": "probe",
      "to": "resumed",
      "when": "probe.has_value_map && probe.has_roadmap && probe.has_profile"
    },
    {
      "from": "probe",
      "to": "tree"
    },
    {
      "from": "tree",
      "to": "value_map",
      "pass": "artifact"
    },
    {
      "from": "value_map",
      "to": "preview",
      "pass": "artifact"
    },
    {
      "from": "preview",
      "to": "profile_write",
      "pass": "artifact"
    },
    {
      "from": "profile_write",
      "to": "refused",
      "when": "profile_write.refused.length > 0"
    },
    {
      "from": "profile_write",
      "to": "ask",
      "pass": "artifact"
    },
    {
      "from": "ask",
      "to": "research",
      "pass": "artifact"
    },
    {
      "from": "research",
      "to": "requirements",
      "pass": "artifact"
    },
    {
      "from": "requirements",
      "to": "recap",
      "pass": "artifact"
    },
    {
      "from": "recap",
      "to": "done",
      "pass": "artifact"
    }
  ],
  "test": {
    "id": "ps-1",
    "sim": {
      "input": {},
      "stubs": {
        "lp.state_probe": {
          "has_value_map": false,
          "has_roadmap": false,
          "has_profile": false
        },
        "value_map": {
          "value_map": "v"
        },
        "preview": {
          "stack": {},
          "memory": {},
          "profile": {}
        },
        "lp.profile_write": {
          "refused": [],
          "set": []
        },
        "research": {
          "research_notes": "n"
        },
        "requirements": {
          "requirements": ["REQ-1"]
        },
        "recap": {
          "next_steps": [
            "a",
            "b",
            "c"
          ]
        }
      },
      "humans": {
        "ask": {
          "answer_kind": "answered"
        }
      },
      "expect_path": [
        "probe",
        "tree",
        "value_map",
        "preview",
        "profile_write",
        "ask",
        "research",
        "requirements",
        "recap",
        "done"
      ],
      "expect_outputs": [
        "status == 'done'",
        "next_steps.length == 3"
      ]
    }
  },
  "goal_check": "artifact"
}
