              }
            ],
            "summary": "CR оплаты -22% два окна подряд (z -4.1); тест h-12 созрел",
            "needs_owner_go": false
          },
          "commit_intents": {
            "intents": 2
          },
          "drain_outbox": {
            "dispatched_count": 2,
            "dispatched_ids": [
              "wfrun_cro_1",
              "wfrun_exp_eval_1"
            ]
          },
          "receipt": {
            "final_status": "alerted",
            "alerts": 1,
            "report_path": ".agents/marketing/pulse/2026-11-11.md",
            "dispatched_count": 2
          }
        },
        "expect_path": [
          "load_state",
          "alerts",
          "forecast",
          "breaker",
          "breaker_apply",
          "triage",
          "classify",
          "audit",
          "owner_go",
          "commit_intents",
          "drain_outbox",
          "receipt",
          "done"
        ],
        "expect_output": {
          "status": "alerted",
          "alerts": 1,
          "dispatched_count": 2
        }
      },
      "variant_tracking_outage": {
        "stubs": {
          "alerts": {
            "freshness_ok": false,
            "anomaly_count": 0,
            "anomalies_json": "[]",
            "matured_locks": 0,
            "readiness_json": "{}",
            "new_cursor_json": "{}",
            "breaker_signals_json": "{\"hits_drop\":0.93,\"spend\":12}"
          },
          "breaker": {
            "fired": true,
            "trigger_codes": [
