{
  "id": "seo-cocoon",
  "name": {
    "en": "Semantic cocoon (Cocoon Engine X4)",
    "ru": "Семантический кокон (Cocoon Engine X4)"
  },
  "description": {
    "en": "Turns a research package into a cocoon architecture: topic boundaries, an entity graph, page decisions (H2 or its own URL), roles, canonical parents, the internal link graph, a mutable-fact registry and link acceptors; then a GIST brief per page of the frozen batch, a cocoon audit and a frozen export. Delivers files and a handoff; changes no site.",
    "ru": "Превращает исследовательский пакет в архитектуру кокона: границы темы, граф сущностей, решения по страницам (H2 или свой URL), роли, канонические родители, граф внутренних ссылок, реестр изменяемых фактов и акцепторы ссылок; затем GIST-бриф на каждую страницу замороженного батча, аудит кокона и замороженный экспорт. Отдаёт файлы и передачу; сайт не меняет."
  },
  "examples": {
    "ru": [
      "Собери семантический кокон для сайта про окна ПВХ в Москве",
      "Построй структуру раздела и брифы страниц по методу X4",
      "Проведи аудит кластера статей про йогу",
      "Нужен кокон 4.0 для интернет-магазина кофемашин",
      "Сделай исследование аудитории и архитектуру страниц для блога о путешествиях",
      "Разложи тему «ипотека для самозанятых» в структуру страниц с брифами"
    ],
    "en": [
      "Build a semantic cocoon for a PVC windows site in Moscow",
      "Build the section structure and page briefs with the X4 method",
      "Audit the cluster of articles about yoga",
      "I need a cocoon 4.0 for a coffee machine online store",
      "Do audience research and page architecture for a travel blog",
      "Lay the topic 'mortgage for the self-employed' out into a page structure with briefs"
    ]
  },
  "not_for": [
    "writing briefs for pages of an already designed cocoon (seo-brief)",
    "web-research",
    "insights-post"
  ],
  "status": "tested",
  "live_success": {
    "output": "status",
    "in": [
      "done"
    ]
  },
  "tags": [
    "seo",
    "content",
    "drmax"
  ],
  "inputs": {
    "topic": {
      "type": "string",
      "required": true
    },
    "geo": {
      "type": "string",
      "default": ""
    },
    "language": {
      "type": "string",
      "default": "ru"
    },
    "site_goal": {
      "type": "string",
      "note": "тип сайта и цель: интернет-магазин / услуги / блог / медиа",
      "default": ""
    },
    "site_url": {
      "type": "string"
    },
    "project_passport_path": {
      "type": "string",
      "default": ""
    },
    "mode": {
      "type": "new_section|existing_section",
      "default": "new_section"
    },
    "material": {
      "type": "string[]",
      "note": "пути к имеющимся данным: семантика, тексты, выгрузки"
    },
    "research_package_path": {
      "type": "string",
      "default": "",
      "note": "готовый пакет seo-research; без него исследование запускается"
    },
    "slug": {
      "type": "string"
    },
    "use_seo_tools": {
      "type": "bool",
      "default": false,
      "note": "платные Mutagen/xmlstock; только при согласии"
    },
    "max_pages": {
      "type": "int",
      "default": 30
    }
  },
  "outputs": {
    "status": "done|partial|blocked",
    "clusters": "Cluster[]",
    "page_count": "int",
    "briefs_dir": "string",
    "audit_status": "pass|rework|block",
    "folder": "string",
    "handoff_path": "string"
  },
  "quality_mode": {
    "default": "standard",
    "effect": "quick - без аудита; full - независимое подтверждение выводов вторым агентом"
  },
  "requires": {
    "plugins": [
      "lane-pilot"
    ],
    "skills": [
      "cocoon-chainsmith",
      "cocoon-pilot",
      "drmax-cocoon-engine-x4",
      "reddit-mapper",
      "topical-graph-architect",
      "gist-content-logic",
      "tavily",
      "seo-tools",
      "alphaxiv",
      "seo-evidence-contract"
    ],
    "secrets": [
      "TAVILY_API_KEY",
      "MUTAGEN_API_KEY (только при use_seo_tools)"
    ],
    "machines": [
      "project host"
    ]
  },
  "budget": {
    "max_minutes": 360,
    "max_usd": 15,
    "max_fan_out": 30
  },
  "entry": "ask_brief",
  "nodes": [
    {
      "id": "ask_brief",
      "type": "human",
      "role": "owner",
      "skip_when": "$inputs.geo != '' && $inputs.site_goal != ''",
      "skip_out": {
        "answer": "",
        "answer_kind": "given"
      },
      "title": {
        "en": "Brief",
        "ru": "Бриф"
      },
      "src": "cocoon-pilot SKILL",
      "prompt": "At most 3 questions in one form - topic scope and geography, language, site goal (type, audience, what the site sells/answers) and which material exists. Default the rest; do not ask permission for routine steps.",
      "out": {
        "answer": "string",
        "answer_kind": "given|answered|timeout"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 240
      }
    },
    {
      "id": "chainsmith",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "profile": {
        "skills": [
          "cocoon-chainsmith"
        ]
      },
      "title": {
        "en": "Plan the command chain",
        "ru": "Спланировать цепочку команд"
      },
      "prompt": "Cocoon Chainsmith v3: fill the 9 YAML variables and emit a verified CP-Navigator command sequence for Cocoon Engine X4 (verify the commands against the X4 bundle). Plan only - do not run research here.",
      "out": {
        "vars": "any",
        "commands": "string[]",
        "ok": "bool"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 15
      }
    },
    {
      "id": "research",
      "type": "subworkflow",
      "workflow": "seo-research",
      "skip_when": "$inputs.research_package_path != ''",
      "skip_out": {
        "status": "done",
        "package_path": "{{$inputs.research_package_path}}"
      },
      "title": {
        "en": "Research package",
        "ru": "Исследовательский пакет"
      },
      "with": {
        "topic": "{{$inputs.topic}}",
        "slug": "{{slug}}",
        "mode": "{{$inputs.mode}}",
        "project_passport_path": "{{$inputs.project_passport_path}}",
        "material": "{{$inputs.material}}",
        "use_seo_tools": "{{$inputs.use_seo_tools}}"
      },
      "out": {
        "status": "string",
        "package_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 240
      }
    },
    {
      "id": "boundaries",
      "type": "agent",
      "role": "specialist:seo-specialist",
      "profile": {
        "skills": [
          "drmax-cocoon-engine-x4"
        ]
      },
      "title": {
        "en": "Topic boundaries",
        "ru": "Границы темы"
      },
      "prompt": "Boundary spec over the research package {{research.package_path}}: core, support, comparison and adjacent topics, exclusions and negative intents with fallbacks; the source-backed entity graph stays separate from the task map. Return boundaries_path and entity_graph_path.",
      "out": {
        "boundaries_path": "string",
        "entity_graph_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 30
      },
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ]
    },
    {
      "id": "architecture",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "profile": {
        "skills": [
          "topical-graph-architect",
          "drmax-cocoon-engine-x4"
        ]
      },
      "title": {
        "en": "Page architecture",
        "ru": "Архитектура страниц"
      },
      "prompt": "TGA v4: entity to intent to pages, not keyword silos. Read .agents/seo/ppc-bridge-latest.json, .agents/marketing/campaigns/direct-*/bridge.json (if present) for paid-converting queries lacking organic top-5, and .agents/research/INDEX.md. Pick page types from SERP, resolve H2 vs URL via granularity/absorption/new-URL gates; set roles, structural home, hub-and-spoke links (diverse anchors, zero exact-match spam), and hreflang parity if >1 locale. Output Page Inventory, Link Graph, Entity Map, fact_registry and acceptors (<= max_pages; rest phase 2).",
      "out": {
        "clusters": "Cluster[]",
        "pages": "Page[]",
        "links": "Link[]",
        "page_count": "int",
        "fact_registry_path": "string",
        "acceptors_path": "string",
        "architecture_path": "string",
        "phase2": "string[]"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 45
      }
    },
    {
      "id": "page_map",
      "type": "agent",
      "role": "specialist:seo-specialist",
      "title": {
        "en": "Final page map",
        "ru": "Финальная карта страниц"
      },
      "prompt": "Versioned Final Page Map: observed state, candidates, absorbed topics and rejections, prioritized with dependencies and maintenance owners; propose the locked batch (<= max_pages) for the owner. Return page_map_path, batch and locked_count.",
      "out": {
        "page_map_path": "string",
        "batch": "Page[]",
        "locked_count": "int"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 25
      },
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ]
    },
    {
      "id": "scope_freeze",
      "type": "human",
      "role": "owner",
      "title": {
        "en": "Freeze the batch",
        "ru": "Заморозка батча"
      },
      "prompt": "Approve and freeze the batch: mandatory, selected optional, deferred and excluded pages, with notes on what each deferral affects. An empty answer freezes the proposed batch as is.",
      "out": {
        "answer": "string",
        "answer_kind": "approved|edited|timeout"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 240
      }
    },
    {
      "id": "briefs",
      "type": "parallel",
      "for_each": "page_map.batch",
      "title": {
        "en": "GIST brief per page",
        "ru": "GIST-бриф на страницу"
      },
      "child": {
        "type": "subworkflow",
        "workflow": "seo-brief",
        "with": {
          "slug": "{{item.slug}}",
          "intent": "{{item.intent}}",
          "entity": "{{item.entity}}",
          "parent": "{{item.parent}}",
          "research_package_path": "{{research.package_path}}",
          "fact_registry_path": "{{architecture.fact_registry_path}}"
        },
        "out": {
          "status": "string",
          "brief_path": "string"
        }
      },
      "join": {
        "policy": "all",
        "out": {
          "brief_paths": "string[]",
          "ok_count": "int"
        },
        "uses": "reduce.seo-cocoon.briefs"
      },
      "concurrency": 5
    },
    {
      "id": "audit",
      "produces": [
        {
          "kind": "verdict",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "plan-critic",
      "session": "new",
      "applicable_modes": [
        "standard",
        "full"
      ],
      "skip_out": {
        "status": "pass",
        "findings": "[]",
        "orphan_count": 0,
        "cannibal_count": 0
      },
      "title": {
        "en": "Cocoon audit",
        "ru": "Аудит кокона"
      },
      "prompt": "Verdict on the whole cocoon from the files only: vector overlap and cannibalization, functional duplicates, architectural home vs rel=canonical, drift and the three-filter pruning (a list of support pages to spawn), and the provenance and claim bounds of every map row. Status pass | rework | block; findings cite the page slug and the passage, severity one of critical, high, medium, low, info.",
      "out": {
        "status": "pass|rework|block",
        "findings": "Finding[]",
        "orphan_count": "int",
        "cannibal_count": "int"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 25
      }
    },
    {
      "id": "package",
      "type": "action",
      "action": "fs.write",
      "path": ".agents/seo/{{slug}}/",
      "files": [
        "research.md",
        "architecture.json",
        "page_map.json",
        "fact_registry.json",
        "acceptors.json",
        "briefs/*.md",
        "audit.md",
        "handoff.md"
      ],
      "note": "Freeze the manifest, run the readiness gates and export by tier; handoff.md separates actual evidence, hypotheses, proposed changes and publication readiness; code changes for the site go in a block 'для PM'",
      "out": {
        "folder": "string",
        "handoff_path": "string"
      }
    },
    {
      "id": "done",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "done",
        "clusters": "architecture.clusters",
        "page_count": "architecture.page_count",
        "briefs_dir": "package.folder",
        "audit_status": "audit.status",
        "folder": "package.folder",
        "handoff_path": "package.handoff_path"
      }
    },
    {
      "id": "partial",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "partial",
        "clusters": "architecture.clusters",
        "page_count": "architecture.page_count",
        "audit_status": "audit.status",
        "folder": "package.folder",
        "handoff_path": "package.handoff_path"
      }
    },
    {
      "id": "blocked",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "blocked"
      }
    }
  ],
  "edges": [
    {
      "from": "ask_brief",
      "to": "chainsmith",
      "pass": "artifact"
    },
    {
      "from": "chainsmith",
      "to": "research",
      "pass": "artifact",
      "when": "chainsmith.ok"
    },
    {
      "from": "chainsmith",
      "to": "blocked",
      "pass": "artifact"
    },
    {
      "from": "research",
      "to": "boundaries",
      "pass": "artifact"
    },
    {
      "from": "boundaries",
      "to": "architecture",
      "pass": "artifact"
    },
    {
      "from": "architecture",
      "to": "page_map",
      "pass": "artifact"
    },
    {
      "from": "page_map",
      "to": "scope_freeze",
      "pass": "artifact"
    },
    {
      "from": "scope_freeze",
      "to": "briefs",
      "pass": "artifact"
    },
    {
      "from": "briefs",
      "to": "audit",
      "pass": "artifact"
    },
    {
      "from": "audit",
      "to": "architecture",
      "pass": "same-session",
      "when": "audit.status == 'rework' && visits('audit') < 2",
      "label": "fix architecture"
    },
    {
      "from": "audit",
      "to": "package",
      "pass": "artifact"
    },
    {
      "from": "package",
      "to": "done",
      "pass": "artifact",
      "when": "audit.status in ['pass']"
    },
    {
      "from": "package",
      "to": "partial",
      "pass": "artifact"
    }
  ],
  "test": {
    "id": "sc-1",
    "sim": {
      "input": {
        "topic": "кофемашины для дома",
        "geo": "RU",
        "language": "ru",
        "site_goal": "интернет-магазин",
        "use_seo_tools": false,
        "max_pages": 12
      },
      "stubs": {
        "chainsmith": {
          "ok": true
        },
        "seo-research": {
          "status": "done",
          "package_path": ".agents/seo/research/kofemashiny"
        },
        "boundaries": {
          "boundaries_path": "boundaries.md",
          "entity_graph_path": "entities.json"
        },
        "architecture": {
          "page_count": 10,
          "clusters": [
            {
              "name": "выбор"
            },
            {
              "name": "уход"
            }
          ],
          "pages": [
            {
              "slug": "page-0",
              "intent": "buy"
            },
            {
              "slug": "page-1",
              "intent": "buy"
            }
          ],
          "fact_registry_path": "fact_registry.json",
          "acceptors_path": "acceptors.json",
          "architecture_path": "architecture.json"
        },
        "page_map": {
          "page_map_path": "page_map.json",
          "locked_count": 2,
          "batch": [
            {
              "slug": "page-0",
              "intent": "buy",
              "entity": "e0",
              "parent": "root"
            },
            {
              "slug": "page-1",
              "intent": "buy",
              "entity": "e1",
              "parent": "root"
            }
          ]
        },
        "seo-brief": {
          "status": "done",
          "brief_path": "briefs/page-0.md"
        },
        "audit": [
          {
            "status": "rework",
            "cannibal_count": 1
          },
          {
            "status": "pass"
          }
        ],
        "package": {
          "folder": ".agents/seo/kofemashiny",
          "handoff_path": ".agents/seo/kofemashiny/handoff.md"
        }
      },
      "expect_path": [
        "ask_brief",
        "chainsmith",
        "research",
        "boundaries",
        "architecture",
        "page_map",
        "scope_freeze",
        "briefs",
        "audit",
        "architecture",
        "page_map",
        "scope_freeze",
        "briefs",
        "audit",
        "package",
        "done"
      ],
      "expect_outputs": [
        "status == 'done'",
        "page_count <= 12",
        "audit_status == 'pass'",
        "files exist: handoff.md, architecture.json"
      ]
    },
    "live": "небольшая тема (до 8 страниц), без платных API; handoff разделяет доказательства и гипотезы; сайт не тронут",
    "note": "Tested on stubs: every outside action answers from a stub. Not live yet: the specialist runs the DrMax cocoon engine; paid SEO tools only with the owner's consent. See `live` for the acceptance run."
  },
  "goal_check": "artifact"
}
