{
  "id": "reels",
  "name": {
    "en": "Reels / Video Presentation",
    "ru": "Рилсы / Видео-презентация"
  },
  "description": {
    "en": "Turns a supplied long video or link into finished vertical clips (transcribe, select coherent excerpts, edit plan, reframe, captions, render, verify), or makes a short code-rendered animated film, video presentation, or business motion film from a subject in a chosen style.",
    "ru": "Превращает присланное длинное видео или ссылку в готовые вертикальные клипы (расшифровка, отбор законченных фрагментов, план монтажа, кадрирование, субтитры, рендер, проверка) или создаёт короткий анимационный ролик, видео-презентацию или бизнес-моушн фильм по теме в выбранном стиле."
  },
  "examples": {
    "ru": [
      "Нарежь это интервью на рилсы",
      "Сделай три шортса из видео по ссылке с ютуба",
      "Найди хайлайты в записи вебинара и смонтируй вертикальные клипы с субтитрами",
      "Сделай короткий нарисованный мультфильм про то, как работает кэш",
      "Озвученный ролик с мелом на доске про налоговый вычет, вертикальный",
      "Сделай презентационный ролик для продукта",
      "Сделай промо-видео для бизнеса в стиле business motion",
      "Подготовь видео-презентацию сервиса со слайдами и озвучкой",
      "Из подкаста вытащи самые сильные моменты в формате Reels"
    ],
    "en": [
      "Cut this interview into reels",
      "Make three shorts from the YouTube video at this link",
      "Find highlights in the webinar recording and edit vertical clips with captions",
      "Make a short hand-drawn animated film about how a cache works",
      "A narrated chalkboard-style explainer reel about the tax deduction, vertical",
      "Make a business motion presentation video for our product",
      "Create a short SaaS launch film or explainer video",
      "Produce a video presentation with voice-over and kinetic visuals",
      "Pull the strongest moments out of the podcast as Reels"
    ]
  },
  "not_for": [
    "x-to-telegram-digest",
    "insights-post"
  ],
  "status": "tested",
  "live_success": {
    "output": "status",
    "in": [
      "done"
    ]
  },
  "tags": [
    "video",
    "social"
  ],
  "inputs": {
    "source": {
      "type": "string",
      "note": "путь к файлу или ссылка; пусто - режим фильма",
      "default": ""
    },
    "subject": {
      "type": "string",
      "note": "тема фильма, если нет source",
      "default": ""
    },
    "count": {
      "type": "int",
      "default": 3
    },
    "duration_s": {
      "type": "int[]",
      "default": [
        30,
        60
      ]
    },
    "language": {
      "type": "string",
      "note": "по умолчанию язык оригинала"
    },
    "style": {
      "type": "string",
      "default": "",
      "note": "house|chalk|threejs|watercolor|paper-cutout|business-motion; only for a film or presentation; empty - ask"
    },
    "publish_text": {
      "type": "bool",
      "default": true
    }
  },
  "outputs": {
    "status": "done|partial|blocked",
    "clips": "string[]",
    "folder": "string",
    "film_path": "string",
    "captions_ok": "bool",
    "bad_files": "string[]",
    "issues": "string[]"
  },
  "quality_mode": {
    "default": "standard",
    "effect": "full - одобрение списка клипов владельцем перед монтажом и вторая проверка звука; quick - без текста публикации"
  },
  "requires": {
    "plugins": [
      "lane-pilot"
    ],
    "skills": [
      "video-to-reels",
      "procedural-film",
      "business-motion-film",
      "copywriter",
      "vechkasov-voice"
    ],
    "secrets": [],
    "machines": [
      "media machine with ffmpeg, yt-dlp, a Whisper implementation (and diarization if multiple speakers are needed); check on the host before the job"
    ],
    "tools": [
      "ffmpeg",
      "yt-dlp",
      "whisper|whisper-cli|whisper-cpp|faster-whisper|mlx_whisper|whisperx"
    ]
  },
  "budget": {
    "max_minutes": 240,
    "max_usd": 8
  },
  "entry": "ingest",
  "nodes": [
    {
      "id": "ingest",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "errand",
      "title": {
        "en": "Acquire and inspect",
        "ru": "Получить и осмотреть"
      },
      "skip_when": "$inputs.source == ''",
      "skip_out": {
        "ok": false,
        "folder": "",
        "reason": "no_source"
      },
      "src": "video-to-reels step 1",
      "prompt": "Create .bb/chats/reels/{{run_id}}/<date>-<short-name>/ with the documented hierarchy (never the toolkit install dir and never tracked repository folders outside .bb/chats/). Use the local file or download the one URL with yt-dlp (never a playlist) into that .bb/chats/reels/{{run_id}}/<date>-<short-name>/ folder. Probe duration, streams, resolution, orientation, frame rate. Check the tools needed (ffmpeg, whisper, yt-dlp) on this host and say what is missing.",
      "out": {
        "ok": "bool",
        "video_path": "string",
        "folder": "string",
        "duration_s": "int",
        "missing_tools": "string[]",
        "reason": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 30
      }
    },
    {
      "id": "transcribe",
      "consumes": [
        {
          "kind": "report",
          "version": 1,
          "from": "ingest"
        }
      ],
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "errand",
      "src": "video-to-reels step 2",
      "prompt": "Inside {{ingest.folder}} (under .bb/chats/reels/{{run_id}}/), extract audio and run Whisper with word timestamps to structured JSON; keep the untouched machine transcript, corrections separate and tied to timestamps; chunk with overlap and restore absolute offsets if needed. Diarize only when speakers must be attributed; labels are anonymous voices, not names. Never write outside .bb/chats/.",
      "out": {
        "ok": "bool",
        "transcript_path": "string",
        "speakers": "int"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 60
      }
    },
    {
      "id": "select",
      "consumes": [
        {
          "kind": "report",
          "version": 1,
          "from": "transcribe"
        }
      ],
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "analyst",
      "profile": {
        "skills": [
          "video-to-reels"
        ]
      },
      "src": "video-to-reels step 3",
      "prompt": "Read the full transcript ({{transcribe.transcript_path}}) and context around each candidate; write {{ingest.folder}}/selection.md and scoring.md (under .bb/chats/reels/{{run_id}}/, never outside .bb/chats/) - source ranges, opening idea, payoff, why it stands alone, context risks, why others were rejected. Up to `count` clips of duration_s. Keep negations, caveats, conditions, names and the actual question when an answer depends on them; prefer one continuous complete excerpt before stitching distant sentences. Never present paraphrases as the speaker's words.",
      "out": {
        "clips": "ClipRange[]",
        "clip_count": "int",
        "selection_path": "string"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 30
      }
    },
    {
      "id": "approve_clips",
      "type": "human",
      "role": "owner",
      "applicable_modes": [
        "full"
      ],
      "skip_out": {
        "answer_kind": "ok"
      },
      "title": {
        "en": "Approve the clip list",
        "ru": "Одобрить список клипов"
      },
      "prompt": "Show each clip: range, hook line, payoff; options - go, change (say which), abort.",
      "out": {
        "answer": "string",
        "answer_kind": "ok|change|abort|timeout"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 240
      }
    },
    {
      "id": "edit_plan",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "analyst",
      "src": "video-to-reels step 4",
      "prompt": "Write {{ingest.folder}}/edit-plan.json (under .bb/chats/reels/{{run_id}}/, never outside .bb/chats/) - source duration, named clips, ordered source ranges (exact seconds), layout (single-speaker crop only when inspected frames support it; split or fitted layouts for interviews, screens, slides), captions, visual insert cues (each with a real asset, output interval, provenance). Cuts fall between words with room for breaths.",
      "out": {
        "edit_plan_path": "string"
      },
      "guards": {
        "maxVisits": 3,
        "timeoutMin": 25
      }
    },
    {
      "id": "prepare",
      "type": "action",
      "action": "shell.skill_script",
      "skill": "video-to-reels",
      "script": "scripts/prepare_timeline.py",
      "args": "--plan {{edit_plan.edit_plan_path}} --transcript {{transcribe.transcript_path}} --out prepared",
      "out": {
        "ok": "bool",
        "errors": "string[]"
      }
    },
    {
      "id": "render",
      "type": "parallel",
      "for_each": "select.clips",
      "child": {
        "produces": [
          {
            "kind": "report",
            "version": 1
          }
        ],
        "type": "agent",
        "role": "errand",
        "prompt": "Render clip {{item.id}} with FFmpeg (or a working Remotion composition for motion captions): first a short preview to check crop, Cyrillic fonts, caption positions and audio, then the full render. Output into {{ingest.folder}} under .bb/chats/reels/{{run_id}}/ (never outside .bb/chats/); do not replace shared tooling. Report `file` as the path relative to the project checkout root (for example .bb/chats/reels/{{run_id}}/<job>/clip.mp4), never absolute and never relative to the job folder alone.",
        "out": {
          "clip_id": "string",
          "file": "string",
          "duration_s": "int",
          "ok": "bool"
        }
      },
      "join": {
        "policy": "all",
        "out": {
          "files": "string[]",
          "ok_count": "int",
          "failed_ids": "string[]"
        },
        "uses": "reduce.reels.render"
      },
      "concurrency": 3
    },
    {
      "id": "verify",
      "type": "parallel",
      "for_each": "render.files",
      "child": {
        "produces": [
          {
            "kind": "report",
            "version": 1
          }
        ],
        "type": "agent",
        "role": "auditor",
        "prompt": "Verify the rendered clip: duration matches the timeline within tolerance, audio and video present, the file decodes; beginning and ending complete, cuts remove no words or reverse meaning; captions match the audible words and stay in sync across cuts (check names and numbers against source audio); faces/slides and captions stay visible; no black or frozen frames, stretched pictures or clipped text; dialogue intelligible, inserts end on time. Inspect sampled frames including cut and insert boundaries; if listening is unavailable say so - signal statistics do not prove perceptual quality.",
        "out": {
          "clip_file": "string",
          "ok": "bool",
          "issues": "string[]"
        }
      },
      "join": {
        "policy": "all",
        "out": {
          "ok_count": "int",
          "good_files": "string[]",
          "bad_files": "string[]",
          "issues": "string[]"
        },
        "uses": "reduce.reels.verify"
      },
      "concurrency": 3
    },
    {
      "id": "media",
      "type": "parallel",
      "for_each": "verify.good_files",
      "child": {
        "type": "action",
        "action": "deliverable.validate",
        "params": {
          "target": "{{item}}",
          "validator": "video"
        },
        "out": {
          "ok": "bool",
          "verdict": "string",
          "reason": "string",
          "details": "object"
        }
      },
      "join": {
        "policy": "all",
        "out": {
          "ok_count": "int",
          "good_files": "string[]",
          "bad_files": "string[]",
          "issues": "string[]"
        },
        "uses": "reduce.reels.verify"
      },
      "concurrency": 3
    },
    {
      "id": "publish_text",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:copy-lead",
      "profile": {
        "skills": [
          "vechkasov-voice",
          "copywriter"
        ]
      },
      "skip_when": "!$inputs.publish_text || $mode == 'quick'",
      "skip_out": {
        "captions": "[]"
      },
      "src": "video-to-reels publishing.md",
      "prompt": "Per clip: publication caption in the author's voice, 2-3 source-based giveaway ideas when justified, a short comment codeword, and a complete take-away as Markdown. Only claims the speaker made.",
      "out": {
        "captions": "Caption[]"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 15
      }
    },
    {
      "id": "style_pick",
      "type": "human",
      "role": "owner",
      "title": {
        "en": "Choose a film style",
        "ru": "Выбрать стиль фильма"
      },
      "skip_when": "$inputs.style != ''",
      "skip_out": {
        "answer": "$inputs.style",
        "answer_kind": "given"
      },
      "prompt": "Show the style gallery - house (inked paper plates on a beat grid), chalk (white sheet with word-by-word subtitles for a narrated voice-over), threejs (3D/WebGL scenes), watercolor (p5.brush painterly), paper-cutout (torn-paper collage), business-motion (commercial launch film, HTML/GSAP/Three.js presentation). Ask which look to use.",
      "out": {
        "answer": "string",
        "answer_kind": "given|chosen|timeout"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 240
      }
    },
    {
      "id": "script",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "analyst",
      "profile": {
        "skills": [
          "procedural-film"
        ]
      },
      "prompt": "Short script and storyboard for subject `{{$inputs.subject}}` in chosen style `{{style_pick.answer}}`: 30-60 seconds, vertical, one idea, voice-over lines with timing. Save script artifacts only under .bb/chats/reels/{{run_id}}/film/ (never outside .bb/chats/). No claims you cannot support.",
      "out": {
        "script_path": "string",
        "scene_count": "int"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 25
      }
    },
    {
      "id": "build_film",
      "consumes": [
        {
          "kind": "report",
          "version": 1,
          "from": "script"
        },
        {
          "kind": "report",
          "version": 1,
          "from": "verify_film",
          "required": false
        }
      ],
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "errand",
      "profile": {
        "skills": [
          "procedural-film",
          "business-motion-film"
        ]
      },
      "prompt": "Follow chosen style `{{style_pick.answer}}` (styles/{{style_pick.answer}}/...) from the procedural-film or business-motion-film skill for subject `{{$inputs.subject}}` and script `{{script.script_path}}`: setup, scenes, motion graphics, voice-over and word subtitles where the style has them, render with code only. Write all build and output files only under .bb/chats/reels/{{run_id}}/films/<slug>/film.mp4 (never outside .bb/chats/) and report `film_path` relative to the checkout root.",
      "out": {
        "film_path": "string",
        "ok": "bool"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 90
      }
    },
    {
      "id": "verify_film",
      "consumes": [
        {
          "kind": "report",
          "version": 1,
          "from": "build_film"
        }
      ],
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "auditor",
      "prompt": "Check duration, vertical format, audio present, subtitles in sync with the voice, no clipped text; report what you could not check.",
      "out": {
        "ok": "bool",
        "issues": "string[]"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 20
      }
    },
    {
      "id": "deliver",
      "type": "action",
      "action": "fs.write",
      "path": "reels/{{date}}-{{slug}}-{{run_id}}/delivery/",
      "contents": {
        "delivery.md": "# Delivery — {{date}}\n\nRun: {{run_id}}\nClips selected: {{select.clip_count}}\nRendered: {{render.files}}\nAgent verify: {{verify.ok_count}} ok, bad {{verify.bad_files}}\nMedia verify (ffprobe): {{media.ok_count}} ok, bad {{media.bad_files}}\nIssues: {{media.issues}}\n"
      },
      "out": {
        "folder": "string"
      }
    },
    {
      "id": "deliver_film",
      "type": "action",
      "action": "fs.write",
      "path": "reels/{{date}}-{{slug}}-{{run_id}}/delivery/",
      "contents": {
        "delivery.md": "# Delivery — {{date}}\n\nRun: {{run_id}}\nFilm: {{build_film.film_path}}\nVerified: {{verify_film.ok}}\nIssues: {{verify_film.issues}}\n"
      },
      "out": {
        "folder": "string"
      }
    },
    {
      "id": "done",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "done",
        "clips": "media.good_files",
        "folder": "deliver.folder",
        "captions_ok": "media.bad_files.length == 0"
      }
    },
    {
      "id": "done_film",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "done",
        "film_path": "build_film.film_path",
        "folder": "deliver_film.folder"
      }
    },
    {
      "id": "partial",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "partial",
        "clips": "[]",
        "bad_files": "verify.bad_files",
        "issues": "verify.issues",
        "film_path": "build_film.film_path"
      }
    },
    {
      "id": "partial_media",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "partial",
        "clips": "media.good_files",
        "bad_files": "media.bad_files",
        "issues": "media.issues"
      }
    },
    {
      "id": "blocked",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "blocked"
      }
    },
    {
      "id": "goal_check_film",
      "type": "action",
      "action": "deliverable.validate",
      "params": {
        "target": "{{build_film.film_path}}",
        "validator": "video"
      },
      "title": {
        "en": "Check the film file",
        "ru": "Проверить файл фильма"
      },
      "out": {
        "ok": "bool",
        "verdict": "pass|rework|fail",
        "reason": "string",
        "details": "object"
      }
    },
    {
      "id": "goal_check",
      "type": "action",
      "action": "deliverable.validate",
      "title": {
        "en": "Check the goal was met",
        "ru": "Проверить, что цель достигнута"
      },
      "rule": "validateDeliverable on the artifact the run produced: the deliverable/validator/brief inputs name what to check; a fail means the goal is not met",
      "out": {
        "ok": "bool",
        "verdict": "pass|rework|fail",
        "reason": "string",
        "details": "object"
      }
    }
  ],
  "edges": [
    {
      "from": "ingest",
      "to": "style_pick",
      "pass": "artifact",
      "when": "$inputs.source == '' && $inputs.subject != ''"
    },
    {
      "from": "ingest",
      "to": "blocked",
      "pass": "artifact",
      "when": "!ingest.ok"
    },
    {
      "from": "ingest",
      "to": "transcribe",
      "pass": "artifact"
    },
    {
      "from": "transcribe",
      "to": "select",
      "pass": "artifact",
      "when": "transcribe.ok"
    },
    {
      "from": "transcribe",
      "to": "blocked",
      "pass": "artifact"
    },
    {
      "from": "select",
      "to": "approve_clips",
      "pass": "artifact",
      "when": "select.clip_count > 0"
    },
    {
      "from": "select",
      "to": "blocked",
      "pass": "artifact"
    },
    {
      "from": "approve_clips",
      "to": "select",
      "pass": "same-session",
      "when": "approve_clips.answer_kind == 'change'"
    },
    {
      "from": "approve_clips",
      "to": "edit_plan",
      "pass": "artifact",
      "when": "approve_clips.answer_kind == 'ok'"
    },
    {
      "from": "approve_clips",
      "to": "blocked",
      "pass": "artifact"
    },
    {
      "from": "edit_plan",
      "to": "prepare",
      "pass": "artifact"
    },
    {
      "from": "prepare",
      "to": "edit_plan",
      "pass": "same-session",
      "when": "!prepare.ok && visits('prepare') < 3",
      "label": "timeline invalid"
    },
    {
      "from": "prepare",
      "to": "blocked",
      "pass": "artifact",
      "when": "!prepare.ok"
    },
    {
      "from": "prepare",
      "to": "render",
      "pass": "artifact"
    },
    {
      "from": "render",
      "to": "verify",
      "pass": "artifact",
      "when": "render.ok_count > 0 && render.failed_ids.length == 0"
    },
    {
      "from": "render",
      "to": "blocked",
      "pass": "artifact"
    },
    {
      "from": "verify",
      "to": "render",
      "pass": "artifact",
      "when": "verify.bad_files.length > 0 && visits('verify') < 2",
      "label": "re-render faulty clips"
    },
    {
      "from": "verify",
      "to": "media",
      "pass": "artifact",
      "when": "verify.bad_files.length == 0 && verify.ok_count > 0"
    },
    {
      "from": "verify",
      "to": "partial",
      "pass": "artifact"
    },
    {
      "from": "media",
      "to": "render",
      "pass": "artifact",
      "when": "media.bad_files.length > 0 && visits('media') < 2",
      "label": "re-render failed media checks"
    },
    {
      "from": "media",
      "to": "publish_text",
      "pass": "artifact",
      "when": "media.bad_files.length == 0 && media.ok_count > 0"
    },
    {
      "from": "media",
      "to": "partial_media",
      "pass": "artifact"
    },
    {
      "from": "publish_text",
      "to": "deliver",
      "pass": "artifact"
    },
    {
