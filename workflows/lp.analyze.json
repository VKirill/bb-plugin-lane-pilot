{
  "id": "lp.analyze",
  "internal": true,
  "name": {
    "en": "Analyze",
    "ru": "Анализ"
  },
  "description": {
    "en": "Read-only analysis of the area with locked/free/deferred decisions, risks, scope verdict and confidence.",
    "ru": "Анализ области только на чтение - решения locked/free/deferred, риски, вердикт по объёму и уверенность."
  },
  "inputs": {
    "goal": {
      "type": "string",
      "required": true
    },
    "scope": {
      "type": "string"
    },
    "depth": {
      "type": "quick|standard|deep",
      "default": "standard"
    },
    "upstream": {
      "type": "string"
    },
    "ask_owner": {
      "type": "bool",
      "default": false,
      "note": "the owner picks which gray areas (open questions and free decisions) get discussed now; unset means all"
    },
    "owner_card": {
      "type": "string",
      "default": "",
      "note": "the owner's anamnesis card; a developer profile in it runs an advisor per chosen area"
    }
  },
  "outputs": {
    "decisions": "Decision[]",
    "risks": "Risk[]",
    "scope_verdict": "small|medium|large|unknown",
    "recommendation": "go|go_with_conditions|no_go",
    "confidence": "int",
    "open_questions": "string[]",
    "residual_risks": "string[]",
    "anchors": "Anchor[]",
    "appetite": "string",
    "no_gos": "string[]",
    "stack": {
      "type": "array",
      "required": false
    },
    "features": {
      "type": "array",
      "required": false
    },
    "pitfalls": {
      "type": "array",
      "required": false
    },
    "chosen": {
      "type": "json",
      "required": false
    },
    "deferred_by_owner": {
      "type": "array",
      "required": false
    },
    "advice": {
      "type": "array",
      "required": false
    }
  },
  "entry": "gather",
  "budget": {
    "max_minutes": 40
  },
  "nodes": [
    {
      "id": "gather",
      "consumes": [
        {
          "kind": "analysis",
          "version": 1,
          "from": "assess"
        }
      ],
      "produces": [
        {
          "kind": "summary",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "analyst",
      "title": {
        "en": "Map the area",
        "ru": "Карта области"
      },
      "src": "maestro-flow:workflows/analyze.md",
      "prompt": "Read-only. Map the area the goal touches in three layers: L1 modules, L2 call chains of 3-5 key files, L3 code anchors (20-50 lines each).\nRead project conventions (AGENTS.md, DESIGN.md for UI) and any upstream report in `upstream`. Write nothing into the repository.\nEvery statement carries file:line; a claim about code you did not open is not a finding.\nAlso report the stack (languages, frameworks, versions, the test command) and the features the area already does, each with file:line.\n",
      "out": {
        "anchors": "Anchor[]",
        "modules": "string[]",
        "conventions": "string[]",
        "summary": "string",
        "stack": {
          "type": "array",
          "required": false
        },
        "features": {
          "type": "array",
          "required": false
        }
      },
      "guards": {
        "maxVisits": 3,
        "timeoutMin": 20
      }
    },
    {
      "id": "assess",
      "consumes": [
        {
          "kind": "summary",
          "version": 1,
          "from": "gather"
        }
      ],
      "produces": [
        {
          "kind": "analysis",
          "version": 1
        }
      ],
      "gates": [
        "assess.confidence >= 0 && assess.confidence <= 100"
      ],
      "type": "agent",
      "role": "analyst",
      "title": {
        "en": "Assess and decide",
        "ru": "Оценка и решения"
      },
      "src": "maestro-flow:workflows/analyze.md",
      "prompt": "Score feasibility, impact, risk, complexity, dependencies 1-5, each citing evidence from `gather` (a manual guess does not count).\nClassify every decision as locked (binding for the plan), free (planner's choice) or deferred (excluded). Do a pressure pass: state the strongest argument against the goal, then answer it.\nscope_verdict large = 3+ independent subsystems or hard sequential dependencies. confidence 0-100 from depth of findings, strength of evidence, breadth of coverage.\nIf confidence rose by less than 5 points over two rounds set stalled=true and stop; put what is still unknown into residual_risks.\nBefore any solution, state the appetite: how much this phase may take (time or size), and the no-gos: what it will not do («none» is an answer).\nName each risk with its kind: value, usability, feasibility or viability, and security beside them when there is one.\nBeside the risks, list the pitfalls known for this kind of work in this stack.\n",
      "out": {
        "decisions": "Decision[]",
        "risks": "Risk[]",
        "scores_min": "int",
        "scope_verdict": "small|medium|large|unknown",
        "recommendation": "go|go_with_conditions|no_go",
        "confidence": "int",
        "stalled": "bool",
        "pressure_pass": "bool",
        "open_questions": "string[]",
        "residual_risks": "string[]",
        "appetite": "string",
        "no_gos": "string[]",
        "pitfalls": {
          "type": "array",
          "required": false
        }
      },
      "guards": {
        "maxVisits": 3,
        "timeoutMin": 20
      }
    },
    {
      "id": "second_opinion",
      "consumes": [
        {
          "kind": "analysis",
          "version": 1,
          "from": "assess"
        }
      ],
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "council",
      "title": {
        "en": "Independent second opinion",
        "ru": "Независимое второе мнение"
      },
      "applicable_modes": [
        "full"
      ],
      "skip_out": {
        "consensus": "[]",
        "conflicts": "[]",
        "consensus_level": 100
      },
      "src": "maestro-flow:workflows/collab.md",
      "prompt": "Three seats answer the same question independently (technical, architectural, product). Do not show seats each other's output.\nClassify results: CONSENSUS (2+ agree), CONFLICT, UNIQUE. consensus_level = consensus/total*100; below 40 report a warning.\n",
      "out": {
        "consensus": "string[]",
        "conflicts": "string[]",
        "unique": "string[]",
        "consensus_level": "int"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 30
      }
    },
    {
      "id": "done",
      "type": "action",
      "action": "emit",
      "map": {
        "decisions": "assess.decisions",
        "risks": "assess.risks",
        "scope_verdict": "assess.scope_verdict",
        "recommendation": "assess.recommendation",
        "confidence": "assess.confidence",
        "open_questions": "assess.open_questions",
        "residual_risks": "assess.residual_risks",
        "anchors": "gather.anchors",
        "appetite": "assess.appetite",
        "no_gos": "assess.no_gos",
        "stack": "gather.stack",
        "features": "gather.features",
        "pitfalls": "assess.pitfalls",
        "chosen": "choose.chosen",
        "deferred_by_owner": "choose.deferred",
        "advice": "advise.advice"
      }
    },
    {
      "id": "choose",
      "type": "human",
      "role": "owner",
      "title": {
        "en": "Pick the gray areas",
        "ru": "Выбор серых зон"
      },
      "skip_when": "!$inputs.ask_owner || assess.open_questions.length == 0",
      "skip_out": {
        "chosen": "all",
        "answer_kind": "all",
        "deferred": []
      },
      "prompt": "List assess.open_questions and the free decisions as gray areas; the owner picks which ones are settled now (the rest are deferred). A timeout counts as all chosen.",
      "out": {
        "chosen": "any",
        "answer_kind": "chosen|all|timeout",
        "deferred": "string[]"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 240
      }
    },
    {
      "id": "advise",
      "type": "parallel",
      "for_each": "assess.open_questions where choose.chosen == 'all' || item in choose.chosen",
      "max_fan_out": 6,
      "title": {
        "en": "Advisor per area",
        "ru": "Советчик на зону"
      },
      "skip_when": "$inputs.owner_card == ''",
      "skip_out": {
        "advice": []
      },
      "child": {
        "type": "agent",
        "role": "analyst",
        "prompt": "Advisor for one gray area only ({{item}}), for a developer with the profile of `owner_card`: two or three options with cost, risk, fit, a recommended pick, and file:line evidence.",
        "out": {
          "area": "string",
          "options": "any",
          "pick": "string",
          "advice": "Option[]"
        },
        "produces": [
          {
            "kind": "report",
            "version": 1
          }
        ]
      },
      "join": {
        "policy": "all",
        "out": {
          "advice": "Option[]"
        }
      }
    }
  ],
  "edges": [
    {
      "from": "gather",
      "to": "assess",
      "pass": "same-session"
    },
    {
      "from": "assess",
      "to": "gather",
      "pass": "same-session",
      "when": "assess.confidence < 60 && !assess.stalled && $inputs.depth != 'quick' && visits('assess') < 3",
      "label": "deeper"
    },
    {
      "from": "assess",
      "to": "second_opinion",
      "pass": "artifact",
      "when": "$mode == 'full' && visits('second_opinion') == 0",
      "label": "second opinion"
    },
    {
      "from": "assess",
      "to": "choose",
      "pass": "artifact"
    },
    {
      "from": "second_opinion",
      "to": "choose",
      "pass": "artifact"
    },
    {
      "from": "choose",
      "to": "advise",
      "pass": "artifact"
    },
    {
      "from": "advise",
      "to": "done",
      "pass": "artifact"
    }
  ],
  "status": "published",
  "goal_check": "artifact"
}