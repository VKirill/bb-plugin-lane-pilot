{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./*"]
    },
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["server.ts", "host.ts", "app.tsx", "i18n.ts", "src", "tests", "components", "lib"]
}
