{
  "schemaVersion": 1,
  "id": "lp.after-accept",
  "startedBy": "merge",
  "name": {
    "en": "After acceptance",
    "ru": "После приёмки"
  },
  "description": {
    "en": "What Lane Pilot does once a task is accepted: the memory maintainer keeps what the task taught, and the project-life maintainer updates PROGRESS and the plans, side by side. A failure of either leaves the accepted task as it is.",
    "ru": "Что Lane Pilot делает после приёмки задачи: хранитель памяти записывает то, чему задача научила, а хранитель жизни проекта обновляет PROGRESS и планы, рядом друг с другом. Сбой любого из них не трогает принятую задачу."
  },
  "not_for": [
    "anything a person asks for: Lane Pilot starts this itself when a task is merged"
  ],
  "inputs": [
    { "name": "run_id", "type": "string" },
    { "name": "task_id", "type": "string" },
    { "name": "pm_thread_id", "type": "string" }
  ],
  "outputs": [
    { "name": "memory_state", "type": "string" },
    { "name": "life_state", "type": "string" }
  ],
  "status": "published",
  "version": 1,
  "guards": {
    "maxSteps": 10,
    "maxFanOut": 2
  },
  "triggers": [
    { "type": "manual" }
  ],
  "scope": {
    "level": "builtin"
  },
  "nodes": [
    { "id": "split", "type": "parallel", "label": "Side by side" },
    {
      "id": "memory",
      "type": "agent",
      "label": "Memory maintenance",
      "role": "memory-maintainer",
      "uses": "lp.memory-maintenance",
      "produces": [{ "kind": "report", "version": 1 }],
      "proof": { "kind": "receipt", "check": "the stage receipt memory-maintenance holds the verdict of the maintainer thread and the records it stored" },
      "output": [
        { "name": "state", "type": "string" },
        { "name": "reason", "type": "string", "required": false }
      ]
    },
    {
      "id": "life",
      "type": "agent",
      "label": "Project life",
      "role": "project-life",
      "uses": "lp.project-life",
      "produces": [{ "kind": "report", "version": 1 }],
      "proof": { "kind": "receipt", "check": "the stage receipt project-life holds the verdict of the maintainer thread and the files it wrote" },
      "output": [
        { "name": "state", "type": "string" },
        { "name": "reason", "type": "string", "required": false }
      ]
    },
    {
      "id": "gather",
      "type": "join",
      "parallel": "split",
      "label": "Both done",
      "uses": "lp.after-accept.join",
      "output": [
        { "name": "memory_state", "type": "string" },
        { "name": "life_state", "type": "string" }
      ]
    },
    {
      "id": "done",
      "type": "action",
      "action": "emit",
      "map": {
        "memory_state": "gather.memory_state",
        "life_state": "gather.life_state"
      }
    }
  ],
  "edges": [
    { "from": "start", "to": "split" },
    { "from": "split", "to": "memory" },
    { "from": "split", "to": "life" },
    { "from": "memory", "to": "gather", "with": { "memory_state": "memory.state" } },
    { "from": "life", "to": "gather", "with": { "life_state": "life.state" } },
    { "from": "gather", "to": "done" }
  ]
}
