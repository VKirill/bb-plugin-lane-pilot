{
  "id": "ship",
  "name": {
    "en": "Ship a phase (PR)",
    "ru": "Отгрузка фазы (PR)"
  },
  "description": {
    "en": "Turns a verified phase into a pull request: checks the verification passed and the full gate marker, lists untriaged vendor updates, pushes the branch, writes the PR body from the phase book and opens it, records the shipment and runs the post-ship hooks.",
    "ru": "Превращает проверенную фазу в pull request: проверяет, что проверка пройдена и есть метка полных ворот, перечисляет неразобранные обновления зависимостей, пушит ветку, пишет описание PR по книге фазы и открывает его, записывает отгрузку и запускает хуки после отгрузки."
  },
  "examples": {
    "ru": [
      "Отгрузи фазу пулл-реквестом",
      "Сделай PR из работы этой фазы",
      "Подготовь PR с описанием по книге фазы",
      "Запушь ветку и открой PR"
    ],
    "en": [
      "Ship the phase as a pull request",
      "Make a PR from this phase's work",
      "Prepare a PR with the body from the phase book",
      "Push the branch and open the PR"
    ]
  },
  "not_for": [
    "deploy",
    "milestone-close"
  ],
  "status": "published",
  "inputs": {
    "phase_id": {
      "type": "string",
      "required": true
    },
    "base": {
      "type": "string",
      "default": "main"
    },
    "head": {
      "type": "string",
      "default": "",
      "note": "the head being shipped; the full-gate check (setting ship.full_gate = on) compares the gate run with it, and without it skips that comparison"
    },
    "review": {
      "type": "bool",
      "default": false,
      "note": "run the configured external code-review before the push when true"
    }
  },
  "outputs": {
    "status": "shipped|held",
    "pr_url": "string",
    "held_by": "string[]",
    "hooks_failed": "string[]"
  },
  "quality_mode": {
    "default": "standard"
  },
  "requires": {
    "plugins": [
      "lane-pilot"
    ]
  },
  "budget": {
    "max_minutes": 60
  },
  "entry": "gate",
  "nodes": [
    {
      "id": "gate",
      "type": "action",
      "action": "lp.integration_gate_status",
      "title": {
        "en": "Full-gate marker",
        "ru": "Метка полных ворот"
      },
      "out": {
        "ok": "bool",
        "failing": "string[]"
      }
    },
    {
      "id": "preflight",
      "type": "agent",
      "role": "auditor",
      "title": {
        "en": "Ready to ship?",
        "ru": "Готово к отгрузке?"
      },
      "prompt": "Verification passed? (lane_pilot_phase status: acceptance lines all hold). Full-gate marker: the integration gate ran green on the head being shipped. Untriaged vendor updates: dependency bumps in the diff without a note. Return held_by with every missing item.",
      "out": {
        "ready": "bool",
        "held_by": "string[]"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 25
      },
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ]
    },
    {
      "id": "review",
      "type": "subworkflow",
      "workflow": "code-review",
      "title": {
        "en": "Optional external review",
        "ru": "Необязательное ревью"
      },
      "skip_when": "!$inputs.review",
      "skip_out": {
        "status": "pass"
      },
      "with": {
        "range": "{{$inputs.base}}..HEAD"
      },
      "guards": {
        "maxVisits": 1
      }
    },
    {
      "id": "open_pr",
      "type": "agent",
      "role": "errand",
      "title": {
        "en": "Push and open the PR",
        "ru": "Пуш и PR"
      },
      "prompt": "Push the phase branch (git push -u origin HEAD), write the PR body from the phase's SUMMARY.md and BOOK.md (what, why, how it was verified, receipts), open it with gh pr create and record the shipment in .agents/deploys.log.",
      "out": {
        "pr_url": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 25
      },
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "consumes": [
        {
          "kind": "report",
          "version": 1,
          "from": "preflight"
        }
      ]
    },
    {
      "id": "hooks",
      "type": "action",
      "action": "lp.post_ship_hooks",
      "title": {
        "en": "Post-ship hook files",
        "ru": "Файлы хуков после отгрузки"
      },
      "out": {
        "count": "int",
        "files": "string[]"
      }
    },
    {
      "id": "post_ship",
      "type": "agent",
      "role": "errand",
      "title": {
        "en": "Post-ship hooks",
        "ru": "Хуки после отгрузки"
      },
      "skip_when": "hooks.count == 0",
      "skip_out": {
        "hooks_run": [],
        "hooks_failed": []
      },
      "prompt": "Run `lane-plan render-hooks post-ship` and execute each hook it lists, in order. A failed hook does not undo the ship: return hooks_run and hooks_failed, a failed hook is listed, never retried blindly.",
      "out": {
        "hooks_run": "string[]",
        "hooks_failed": "string[]"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 25
      },
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "consumes": [
        {
          "kind": "report",
          "version": 1,
          "from": "open_pr"
        }
      ]
    },
    {
      "id": "shipped",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "shipped",
        "pr_url": "open_pr.pr_url",
        "held_by": "[]",
        "hooks_failed": "post_ship.hooks_failed"
      }
    },
    {
      "id": "held",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "held",
        "pr_url": "''",
        "held_by": "preflight.held_by",
        "hooks_failed": "[]"
      }
    },
    {
      "id": "held_gate",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "held",
        "pr_url": "''",
        "held_by": "gate.failing",
        "hooks_failed": "[]"
      }
    },
    {
      "id": "goal_check",
      "type": "action",
      "action": "deliverable.validate",
      "title": {
        "en": "Check the goal was met",
        "ru": "Проверить, что цель достигнута"
      },
      "rule": "validateDeliverable on the artifact the run produced: the deliverable/validator/brief inputs name what to check; a fail means the goal is not met",
      "out": {
        "ok": "bool",
        "verdict": "pass|rework|fail",
        "reason": "string",
        "details": "object"
      }
    },
    {
      "id": "held_review",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "held",
        "pr_url": "''",
        "held_by": "['external review asked for rework or blocked the ship']",
        "hooks_failed": "[]"
      }
    }
  ],
  "edges": [
    {
      "from": "gate",
      "to": "preflight",
      "pass": "artifact",
      "when": "gate.ok"
    },
    {
      "from": "gate",
      "to": "held_gate"
    },
    {
      "from": "preflight",
      "to": "held",
      "pass": "artifact",
      "when": "!preflight.ready"
    },
    {
      "from": "preflight",
      "to": "review",
      "pass": "artifact"
    },
    {
      "from": "review",
      "to": "held_review",
      "pass": "artifact",
      "when": "review.status == 'rework' || review.status == 'block'"
    },
    {
      "from": "review",
      "to": "open_pr",
      "pass": "artifact"
    },
    {
      "from": "open_pr",
      "to": "hooks",
      "pass": "artifact"
    },
    {
      "from": "hooks",
      "to": "post_ship",
      "pass": "artifact"
    },
    {
      "from": "post_ship",
      "to": "goal_check",
      "pass": "artifact"
    },
    {
      "from": "goal_check",
      "to": "shipped",
      "when": "goal_check.ok != false"
    },
    {
      "from": "goal_check",
      "to": "held"
    }
  ],
  "test": {
    "id": "sh-1",
    "sim": {
      "input": {
        "phase_id": "ph_sample01"
      },
      "stubs": {
        "preflight": {
          "ready": true,
          "held_by": []
        },
        "open_pr": {
          "pr_url": "https://example/pr/1"
        },
        "lp.post_ship_hooks": {
          "count": 1,
          "files": [
            ".agents/planning/hooks/post-ship.md"
          ]
        },
        "post_ship": {
          "hooks_run": [],
          "hooks_failed": []
        }
      },
      "expect_path": [
        "gate",
        "preflight",
        "review",
        "open_pr",
        "hooks",
        "post_ship",
        "goal_check",
        "shipped"
      ],
      "expect_outputs": [
        "status == 'shipped'"
      ]
    }
  },
  "goal_check": "validate"
}