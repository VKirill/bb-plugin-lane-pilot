{
  "schemaVersion": 1,
  "id": "lp-task-pipeline",
  "startedBy": "lane_pilot_dispatch_writer",
  "name": "Task pipeline",
  "description": {
    "en": "The Lane Pilot task pipeline: the PM read, the plan critique (by quality mode), the specialist risk review, the ownership base, then the code task in its own worktree with checks, code critique and merge.",
    "ru": "Конвейер задачи Lane Pilot: чтение PM, критика плана (по режиму качества), проверка рисков специалистом, база владения, затем кодовая задача в своём worktree с проверками, критикой кода и слиянием."
  },
  "examples": {
    "en": [
      "dispatch a code task to a writer",
      "implement this change in the project"
    ],
    "ru": [
      "отправь задачу писателю",
      "сделай эту правку в проекте"
    ]
  },
  "inputs": [
    {
      "name": "taskId",
      "type": "string"
    },
    {
      "name": "attemptId",
      "type": "string"
    },
    {
      "name": "baseRef",
      "type": "string",
      "required": false,
      "description": "The PM's baseRef, kept so a dispatch a reload interrupted starts again the same."
    }
  ],
  "outputs": [
    {
      "name": "reply",
      "type": "json",
      "description": "What the dispatch tool answers the PM with."
    },
    {
      "name": "browser_qa",
      "type": "json",
      "required": false,
      "description": "The reply of the browser check the task's graph ran after acceptance; absent when the task carries no qa_cases and qa_url."
    }
  ],
  "requires": {
    "plugins": [],
    "machines": [],
    "env": [],
    "browserSession": false
  },
  "status": "published",
  "version": 2,
  "guards": {
    "maxSteps": 20,
    "maxFanOut": 1,
    "maxSubworkflowDepth": 3
  },
  "triggers": [
    {
      "type": "chat"
    }
  ],
  "scope": {
    "level": "builtin"
  },
  "nodes": [
    {
      "id": "worth-check",
      "type": "jev",
      "label": "Advisory critics worth it?",
      "judgment": "critique.worth",
      "state": {
        "task_title": "$task.title",
        "contract": "$task.contract"
      },
      "output": [
        {
          "name": "decision",
          "type": "string",
          "required": false
        },
        {
          "name": "value",
          "type": "json",
          "required": false
        },
        {
          "name": "escalated",
          "type": "boolean",
          "required": false
        },
        {
          "name": "skip_pm_read",
          "type": "boolean",
          "required": false
        },
        {
          "name": "skip_plan_critique",
          "type": "boolean",
          "required": false
        },
        {
          "name": "skip_specialist_review",
          "type": "boolean",
          "required": false
        }
      ],
      "proof": {
        "kind": "gate",
        "check": "the critique.worth judgment answers which advisory critics this task spawns; an unsure or absent answer keeps every critic (the fallback runs all)"
      }
    },
    {
      "id": "pm-read",
      "produces": [
        {
          "kind": "summary",
          "version": 1
        }
      ],
      "type": "agent",
      "label": "PM read",
      "role": "pm-reader",
      "uses": "lp.pm-read",
      "proof": {
        "kind": "advisory",
        "reason": "a model's summary of the read_first excerpts; it only hands context to the critics and decides nothing",
        "form": "parsePmReadResult: one JSON object with a non-blank summary (a blank or unreadable answer fails the stage)"
      },
      "output": [
        {
          "name": "state",
          "type": "enum",
          "values": [
            "passed",
            "skipped",
            "failed"
          ]
        },
        {
          "name": "summary",
          "type": "string"
        },
        {
          "name": "reason",
          "type": "string",
          "required": false
        }
      ],
      "skip_when": "worth-check.skip_pm_read == true",
      "skip_out": {
        "state": "skipped",
        "summary": "''",
        "reason": "'jev advisory read not worth it'"
      }
    },
    {
      "id": "quality-mode",
      "type": "decision",
      "label": "Quality mode",
      "uses": "lp.quality-mode",
      "proof": {
        "kind": "gate",
        "check": "resolveQualityMode reads the task, then the project setting: a closed enum quick, standard or full"
      },
      "output": [
        {
          "name": "mode",
          "type": "enum",
          "values": [
            "quick",
            "standard",
            "full"
          ]
        }
      ]
    },
    {
      "id": "plan-critique",
      "produces": [
        {
          "kind": "gate-decision",
          "version": 1
        }
      ],
      "type": "agent",
      "label": "Plan critique",
      "role": "plan-critic",
      "uses": "lp.plan-critique",
      "proof": {
        "kind": "advisory",
        "reason": "a model's verdict on the plan: it never accepts a task, and in plan_critique.mode gate (the default, SMA p2_checker) its refusal stops the attempt before the writer",
        "form": "parseCritique: verdict schema; a critical or high finding counts only with a file, a line and quoted evidence, and a file the critic's input names"
      },
      "output": [
        {
          "name": "allowed",
          "type": "boolean"
        },
        {
          "name": "reason",
          "type": "string",
          "required": false
        }
      ],
      "skip_when": "worth-check.skip_plan_critique == true",
      "skip_out": {
        "allowed": true,
        "reason": "'jev plan critique not worth it'"
      }
    },
    {
      "id": "plan-critique-quick",
      "produces": [
        {
          "kind": "gate-decision",
          "version": 1
        }
      ],
      "type": "agent",
      "label": "Plan critique (quick: skipped by its own receipt)",
      "role": "plan-critic",
      "uses": "lp.plan-critique",
      "proof": {
        "kind": "advisory",
        "reason": "a model's verdict on the plan: it never accepts a task, and in plan_critique.mode gate (the default, SMA p2_checker) its refusal stops the attempt before the writer",
        "form": "parseCritique: verdict schema; a critical or high finding counts only with a file, a line and quoted evidence, and a file the critic's input names"
      },
      "output": [
        {
          "name": "allowed",
          "type": "boolean"
        },
        {
          "name": "reason",
          "type": "string",
          "required": false
        }
      ],
      "skip_when": "worth-check.skip_plan_critique == true",
      "skip_out": {
        "allowed": true,
        "reason": "'jev plan critique not worth it'"
      }
    },
    {
      "id": "block-plan-critique",
      "type": "action",
      "label": "Block: plan critique",
      "uses": "lp.block-plan-critique",
      "proof": {
        "kind": "receipt",
        "check": "the blocked plan-critique receipt is stored with its reason and the reply to the PM is built from it"
      },
      "output": [
        {
          "name": "reply",
          "type": "json"
        }
      ]
    },
    {
      "id": "specialist-review",
      "consumes": [
        {
          "kind": "gate-decision",
          "version": 1,
          "from": "plan-critique-quick"
        },
        {
          "kind": "gate-decision",
          "version": 1,
          "from": "plan-critique"
        }
      ],
      "produces": [
        {
          "kind": "gate-decision",
          "version": 1
        }
      ],
      "type": "agent",
      "label": "Specialist review",
      "role": "specialist-reviewer",
      "uses": "lp.specialist-review",
      "proof": {
        "kind": "advisory",
        "reason": "a model's risk opinion on the plan",
        "form": "parseSpecialistResult: verdict schema; a high or critical risk counts only with a file, a line and quoted evidence, and a file the reviewer's input names"
      },
      "output": [
        {
          "name": "allowed",
          "type": "boolean"
        },
        {
          "name": "reason",
          "type": "string",
          "required": false
        }
      ],
      "skip_when": "worth-check.skip_plan_critique == true || worth-check.skip_specialist_review == true",
      "skip_out": {
        "allowed": true,
        "reason": "'jev specialist review not worth it'"
      }
    },
    {
      "id": "block-specialist",
      "type": "action",
      "label": "Block: specialist review",
      "uses": "lp.block-specialist",
      "proof": {
        "kind": "receipt",
        "check": "the blocked specialist-review receipt is stored with its reason and the reply to the PM is built from it"
      },
      "output": [
        {
          "name": "reply",
          "type": "json"
        }
      ]
    },
    {
      "id": "ownership-base",
      "type": "action",
      "label": "Ownership base",
      "uses": "lp.ownership-base",
      "proof": {
        "kind": "receipt",
        "check": "the run gate decision and the ownership base preflight are stored in the run-gate receipt; the repository must report a readable base commit"
      },
      "output": [
        {
          "name": "ok",
          "type": "boolean"
        },
        {
          "name": "live",
          "type": "boolean"
        },
        {
          "name": "kind",
          "type": "enum",
          "values": [
            "unavailable",
            "persist_failed"
          ],
          "required": false
        },
        {
          "name": "reason",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "id": "block-ownership",
      "type": "action",
      "label": "Block: ownership base",
      "uses": "lp.block-ownership",
      "proof": {
        "kind": "receipt",
        "check": "the blocked run-gate receipt is stored with its reason and the reply to the PM is built from it"
      },
      "output": [
        {
          "name": "reply",
          "type": "json"
        }
      ]
    },
    {
      "id": "task-folder",
      "type": "action",
      "label": "Task folder",
      "uses": "lp.task-folder",
      "proof": {
        "kind": "file",
        "check": "the task folder exists on the writer's machine before the writer starts"
      },
      "output": [
        {
          "name": "ok",
          "type": "boolean"
        }
      ]
    },
    {
      "id": "writer",
      "produces": [
        {
          "kind": "dispatch-reply",
          "version": 1
        }
      ],
      "type": "lp-task",
      "label": "Code task",
      "uses": "lp-task",
      "stage_proof": {
        "writer-agent": {
          "kind": "gate",
          "check": "gates owns-paths and validate: the changed files are inside owns_paths and expected_outputs exist with content"
        },
        "verification": {
          "kind": "command",
          "check": "every verification[].command exits 0 in the sandbox (gate verification passed)"
        },
        "code-critique": {
          "kind": "advisory",
          "reason": "a model's review of the candidate",
          "form": "parseCodeCritique: verdict schema; a critical or high finding counts only when its file is among the candidate's files and its line exists in it"
        },
        "plan-fact": {
          "kind": "file",
          "check": "blindPlanFact checks each acceptance row of the writer's plan-fact table against the candidate: the cited file is among the changed files, the cited lines overlap a changed hunk, the cited command is a verification[] command that exited 0; the writer's prose is never read"
        },
        "acceptance-receipt": {
          "kind": "schema",
          "check": "the acceptance-v2 receipt validates against lane-stack/schemas/acceptance-v2.schema.json (validateAcceptanceV2)"
        }
      },
      "stages": [
        "writer-agent",
        "verification",
        "code-critique",
        "plan-fact",
        "acceptance-receipt"
      ],
      "output": [
        {
          "name": "reply",
          "type": "json"
        }
      ]
    },
    {
      "id": "inside-writer",
      "type": "note",
      "text": "Inside the code task (locked): workspace and worktree, the writer session and its turns, owns-paths and verification checks, repair rounds, code critique, merge intent and merge, integration gate, acceptance receipt, retries and fallbacks, memory and project-life after acceptance."
    },
    {
      "id": "qa-gate",
      "type": "decision",
      "label": "Browser check due",
      "uses": "lp.qa-gate",
      "proof": {
        "kind": "gate",
        "check": "the task is accepted with a passed acceptance receipt and its contract carries qa_cases and qa_url; a task without them, or one that did not end accepted, goes on without a check"
      },
      "output": [
        {
          "name": "run",
          "type": "boolean"
        },
        {
          "name": "run_id",
          "type": "string",
          "required": false
        },
        {
          "name": "task_id",
          "type": "string",
          "required": false
        },
        {
          "name": "url",
          "type": "string",
          "required": false
        },
        {
          "name": "cases",
          "type": "array",
          "required": false
        },
        {
          "name": "env_class",
          "type": "string",
          "required": false
        },
        {
          "name": "dev_server",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "id": "browser-qa",
      "type": "subworkflow",
      "label": "Browser check",
      "workflow": "lp.browser-qa",
      "inputs": {
        "run_id": "qa-gate.run_id",
        "task_id": "qa-gate.task_id",
        "url": "qa-gate.url",
        "cases": "qa-gate.cases",
        "env_class": "qa-gate.env_class",
        "dev_server": "qa-gate.dev_server"
      },
      "proof": {
        "kind": "receipt",
        "check": "the browser-qa stage receipt of the task holds the verdict of the check thread; a failed one leaves the task not done"
      },
      "output": [
        {
          "name": "state",
          "type": "string"
        },
        {
          "name": "reply",
          "type": "json"
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "worth-check"
    },
    {
      "from": "worth-check",
      "to": "pm-read"
    },
    {
      "from": "pm-read",
      "to": "quality-mode",
      "label": "passed, skipped or failed (the summary decides nothing)"
    },
    {
      "from": "quality-mode",
      "to": "plan-critique-quick",
      "label": "quick",
      "when": {
        "field": "mode",
        "op": "eq",
        "value": "quick"
      },
      "with": {
        "pmReadContext": "pm-read.summary"
      }
    },
    {
      "from": "quality-mode",
      "to": "plan-critique",
      "label": "standard or full",
      "with": {
        "pmReadContext": "pm-read.summary"
      }
    },
    {
      "from": "plan-critique-quick",
      "to": "block-plan-critique",
      "label": "not allowed",
      "when": {
        "field": "allowed",
        "op": "eq",
        "value": false
      },
      "with": {
        "reason": "plan-critique-quick.reason"
      }
    },
    {
      "from": "plan-critique-quick",
      "to": "specialist-review",
      "label": "allowed"
    },
    {
      "from": "plan-critique",
      "to": "block-plan-critique",
      "label": "not allowed",
      "when": {
        "field": "allowed",
        "op": "eq",
        "value": false
      },
      "with": {
        "reason": "plan-critique.reason"
      }
    },
    {
      "from": "plan-critique",
      "to": "specialist-review",
      "label": "allowed"
    },
    {
      "from": "specialist-review",
      "to": "block-specialist",
      "label": "not allowed",
      "when": {
        "field": "allowed",
        "op": "eq",
        "value": false
      },
      "with": {
        "reason": "specialist-review.reason"
      }
    },
    {
      "from": "specialist-review",
      "to": "ownership-base",
      "label": "allowed"
    },
    {
      "from": "ownership-base",
      "to": "block-ownership",
      "label": "unavailable",
      "when": {
        "field": "ok",
        "op": "eq",
        "value": false
      },
      "with": {
        "kind": "ownership-base.kind",
        "reason": "ownership-base.reason"
      }
    },
    {
      "from": "ownership-base",
      "to": "task-folder",
      "label": "ready",
      "with": {
        "live": "ownership-base.live"
      }
    },
    {
      "from": "task-folder",
      "to": "writer",
      "with": {
        "live": "ownership-base.live",
        "pmReadContext": "pm-read.summary"
      }
    },
    {
      "from": "writer",
      "to": "qa-gate"
    },
    {
      "from": "qa-gate",
      "to": "end",
      "label": "no browser check",
      "when": {
        "field": "run",
        "op": "eq",
        "value": false
      },
      "with": {
        "reply": "writer.reply"
      }
    },
    {
      "from": "qa-gate",
      "to": "browser-qa",
      "label": "qa_cases and qa_url"
    },
    {
      "from": "browser-qa",
      "to": "end",
      "with": {
        "reply": "writer.reply",
        "browser_qa": "browser-qa.reply"
      }
    },
    {
      "from": "block-plan-critique",
      "to": "end",
      "with": {
        "reply": "block-plan-critique.reply"
      }
    },
    {
      "from": "block-specialist",
      "to": "end",
      "with": {
        "reply": "block-specialist.reply"
      }
    },
    {
      "from": "block-ownership",
      "to": "end",
      "with": {
        "reply": "block-ownership.reply"
      }
    }
  ]
}