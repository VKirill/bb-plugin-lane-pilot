{
  "id": "eval-review",
  "name": {
    "en": "AI eval review",
    "ru": "Аудит ИИ-оценки"
  },
  "description": {
    "en": "Audits the evaluation of an AI feature: is the gold set independent of the prompt, does the metric track the user goal, can the model game it, is there leakage; writes EVAL-REVIEW.md with a verdict.",
    "ru": "Проверяет оценку ИИ-функции: независим ли золотой набор от промпта, отражает ли метрика цель пользователя, может ли модель её обмануть, нет ли утечки; пишет EVAL-REVIEW.md с вердиктом."
  },
  "examples": {
    "ru": [
      "Проверь, честно ли мы оцениваем генерацию",
      "Сделай аудит ИИ-оценки этой фазы",
      "Не подогнан ли золотой набор под промпт?",
      "Напиши EVAL-REVIEW.md"
    ],
    "en": [
      "Review how we evaluate the generation",
      "Audit the AI eval of this phase",
      "Is the gold set tuned to the prompt?",
      "Write EVAL-REVIEW.md"
    ]
  },
  "not_for": [
    "code-review"
  ],
  "status": "published",
  "inputs": {
    "phase_id": {
      "type": "string"
    },
    "eval_path": {
      "type": "string"
    }
  },
  "outputs": {
    "status": "sound|flawed",
    "findings": "Finding[]",
    "review_path": "string",
    "proposed_workflow": "string?"
  },
  "quality_mode": {
    "default": "standard"
  },
  "requires": {
    "plugins": [
      "lane-pilot"
    ]
  },
  "budget": {
    "max_minutes": 60
  },
  "entry": "review",
  "nodes": [
    {
      "id": "review",
      "type": "agent",
      "role": "auditor",
      "title": {
        "en": "Eval audit",
        "ru": "Аудит оценки"
      },
      "prompt": "Read the AI-SPEC.md, the gold set and the scoring code. First, for each dimension the AI-SPEC.md evaluation section lists, mark it covered, partial or missing with evidence (file:line or a sample) — a table in EVAL-REVIEW.md; any missing dimension makes the verdict flawed. Then answer each question of the EVAL-REVIEW template with evidence: gold set written before the prompt was tuned, metric tied to the user goal, gaming (a trivial output scoring high), leakage (test items in the prompt or few-shots), threshold justified. Return the complete raw Markdown of EVAL-REVIEW.md in document; the code-owned writer persists it to .agents/phases/<id>/. This read-only helper does not write files.",
      "out": {
        "findings": "Finding[]",
        "coverage": "any",
        "flawed": "bool",
        "document": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 25
      },
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ]
    },
    {
      "id": "sound",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "sound",
        "findings": "review.findings",
        "review_path": "write_review.review_path"
      }
    },
    {
      "id": "offer",
      "type": "action",
      "action": "lp.propose_workflow",
      "workflow": "todo-add",
      "inputs": {
        "title": "Fix AI eval flaws ({{$inputs.phase_id}})",
        "thought": "Resolve flawed evaluation findings in {{write_review.review_path}}"
      }
    },
    {
      "id": "flawed",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "flawed",
        "findings": "review.findings",
        "review_path": "write_review.review_path",
        "proposed_workflow": "'todo-add'"
      }
    },
    {
      "id": "goal_check",
      "type": "action",
      "action": "deliverable.validate",
      "title": {
        "en": "Check the goal was met",
        "ru": "Проверить, что цель достигнута"
      },
      "rule": "validateDeliverable on the artifact the run produced: the deliverable/validator/brief inputs name what to check; a fail means the goal is not met",
      "out": {
        "ok": "bool",
        "verdict": "pass|rework|fail",
        "reason": "string",
        "details": "object"
      }
    },
    {
      "id": "doc_path",
      "type": "action",
      "action": "lp.doc_path",
      "title": {
        "en": "Resolve the document path",
        "ru": "Путь документа"
      },
      "params": {
        "phase_id": "{{$inputs.phase_id}}",
        "doc": "EVAL-REVIEW.md"
      },
      "out": {
        "path": "string"
      }
    },
    {
      "id": "write_review",
      "type": "action",
      "action": "fs.write",
      "out": {
        "review_path": "string"
      },
      "title": {
        "en": "Write the eval review",
        "ru": "Записать ревью оценки"
      },
      "params": {
        "path": "{{doc_path.path}}",
        "contents": "{{review.document}}"
      }
    }
  ],
  "edges": [
    {
      "from": "doc_path",
      "to": "write_review",
      "pass": "artifact"
    },
    {
      "from": "review",
      "to": "doc_path",
      "pass": "artifact"
    },
    {
      "from": "write_review",
      "to": "offer",
      "pass": "artifact",
      "when": "review.flawed"
    },
    {
      "from": "offer",
      "to": "flawed",
      "pass": "artifact"
    },
    {
      "from": "write_review",
      "to": "goal_check",
      "pass": "artifact",
      "with": {
        "path": "write_review.review_path"
      }
    },
    {
      "from": "goal_check",
      "to": "sound",
      "when": "goal_check.ok != false"
    },
    {
      "from": "goal_check",
      "to": "flawed"
    }
  ],
  "test": {
    "id": "er-1",
    "sim": {
      "input": {
        "phase_id": "ph_sample01"
      },
      "stubs": {
        "review": {
          "findings": [],
          "coverage": {},
          "flawed": false,
          "document": "# EVAL\n"
        },
        "doc_path": {
          "path": ".agents/phases/ph_sample01/EVAL-REVIEW.md"
        }
      },
      "expect_path": [
        "review",
        "doc_path",
        "write_review",
        "goal_check",
        "sound"
      ],
      "expect_outputs": [
        "status == 'sound'"
      ]
    }
  },
  "goal_check": "validate"
}
