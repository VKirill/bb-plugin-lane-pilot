{
  "id": "test-gen",
  "name": {
    "en": "Generate tests",
    "ru": "Дописать тесты"
  },
  "description": {
    "en": "Writes missing tests for named gaps in the test paths only, runs them layer by layer, classifies failures (test/code/env defect) and iterates up to three times. Never edits source code or existing tests. The tests are the whole task, for code that already exists; tests that come with a new feature belong to that feature's workflow.",
    "ru": "Пишет недостающие тесты по названным пробелам только в тестовых путях, прогоняет по слоям, классифицирует провалы (дефект теста / кода / окружения) и итерирует до трёх раз. Исходники и существующие тесты не трогает. Тесты - вся задача, для уже существующего кода; тесты к новой функции идут в её графе."
  },
  "category": "qa",
  "examples": {
    "ru": [
      "Допиши тесты на модуль расчёта скидок",
      "Покрой тестами обработчики вебхуков",
      "Добавь недостающие юнит-тесты для сервиса пользователей",
      "Закрой пробелы в покрытии, которые нашёл ревью",
      "Напиши юнит-тесты для парсера дат, сам код не трогай",
      "Нужны интеграционные тесты на сервис заказов, остальное оставь как есть"
    ],
    "en": [
      "Write the missing tests for the discount calculation module",
      "Cover the webhook handlers with tests",
      "Add the missing unit tests for the users service",
      "Close the coverage gaps the review found",
      "Write unit tests for the date parser, leave the code alone",
      "I need integration tests for the orders service, nothing else"
    ]
  },
  "not_for": [
    "quality-loop",
    "refactor",
    "analyze-plan-execute"
  ],
  "status": "published",
  "inputs": {
    "scope": {
      "type": "string"
    },
    "gaps": {
      "type": "Gap[]",
      "default": []
    },
    "goal": {
      "type": "string"
    },
    "quality_mode": {
      "type": "quick|standard|full",
      "default": "standard"
    },
    "phase_id": {
      "type": "string",
      "default": "",
      "note": "a finished phase; its summaries and decisions derive the gaps when gaps are not given"
    }
  },
  "outputs": {
    "status": "done|partial|blocked|not_run",
    "tests_added": "int?",
    "pass_rate": "int",
    "failures": "Failure[]",
    "code_defects": "Finding[]",
    "env_issues": "string[]",
    "measurement_reason": "string?"
  },
  "quality_mode": {
    "default": "standard",
    "effect": "quick - слой L1; standard - L0-L2; full - L0-L3"
  },
  "requires": {
    "plugins": [
      "lane-pilot"
    ],
    "machines": [
      "project writer host"
    ],
    "project": {
      "git": true,
      "test_framework": "required"
    }
  },
  "budget": {
    "max_minutes": 120,
    "max_fan_out": 3
  },
  "entry": "derive",
  "nodes": [
    {
      "id": "derive",
      "type": "agent",
      "role": "analyst",
      "title": {
        "en": "Derive the gaps",
        "ru": "Вывести пробелы"
      },
      "skip_when": "$inputs.gaps.length > 0 || !$inputs.phase_id",
      "skip_out": {
        "gaps": []
      },
      "prompt": "Read .agents/phases/<phase_id>/SUMMARY.md, BOOK.md decisions and the plan promises. List the promises and decisions that have no test as gaps[] (file, layer, priority).",
      "out": {
        "gaps": "Gap[]"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 20
      },
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ]
    },
    {
      "id": "confirm",
      "type": "human",
      "role": "owner",
      "title": {
        "en": "Write tests for these?",
        "ru": "Писать тесты на это?"
      },
      "skip_when": "$inputs.gaps.length > 0 || !$inputs.phase_id",
      "skip_out": {
        "answer": "",
        "answer_kind": "not_run"
      },
      "prompt": "Show the gaps derived from the phase; the owner agrees or strikes lines. A timeout blocks the run.",
      "out": {
        "answer": "string",
        "answer_kind": "agree|strike|timeout|not_run"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 240
      }
    },
    {
      "id": "baseline",
      "type": "action",
      "action": "lp.test_inventory_baseline",
      "out": {
        "status": "measured|unavailable|unsupported",
        "reason": "string",
        "receipt": "object?"
      },
      "guards": {
        "maxVisits": 1
      }
    },
    {
      "id": "write_tests",
      "produces": [
        {
          "kind": "task-result",
          "version": 1
        }
      ],
      "type": "lp-task",
      "title": {
        "en": "Write tests",
        "ru": "Написать тесты"
      },
      "contract_template": "add tests for the confirmed gaps (gaps, else derived_gaps restricted by owner_answer and owner_answer_kind; a strike excludes the named gaps, never silently restore them); owns_paths only test directories and fixtures; never_touch source files and existing tests; acceptance - new tests run; a test expected to fail because of a confirmed bug is marked expected_fail with the bug in its name",
      "quality_mode": "standard",
      "out": {
        "state": "accepted|failed|blocked|needs_human|cancelled",
        "files": "string[]",
        "merge_commit": "string"
      },
      "guards": {
        "maxAttempts": 2
      }
    },
    {
      "id": "run",
      "type": "action",
      "action": "lp.project_checks",
      "mode": "full",
      "layers": [
        "L0",
        "L1",
        "L2"
      ],
      "title": {
        "en": "Run layers fail-fast",
        "ru": "Прогон слоёв fail-fast"
      },
      "out": {
        "ok": "bool",
        "tests_passed": "int",
        "tests_failed": "int",
        "pass_rate": "int",
        "failures": "Failure[]",
        "no_framework": "bool"
      }
    },
    {
      "id": "inventory",
      "type": "action",
      "action": "lp.test_inventory_after",
      "out": {
        "status": "measured|unavailable|unsupported",
        "reason": "string",
        "tests_added": "int?",
        "receipt": "object?",
        "runner_ok": "bool?"
      }
    },
    {
      "id": "classify",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "triager",
      "prompt": "Apply FAILURE_TRIAGE_METHOD to each entry in inputs.failures from the latest check run, using inputs.pass_rate, inputs.tests_passed and inputs.tests_failed for its summary. Per failure: test_defect (fix the test), code_defect (confirmed bug - do not retry, do not edit sources), env_issue (blocked). A critical failure in a layer stops the next layer. In doubt - code_defect. Strategy: rounds 1-2 conservative; more than 80% pass with similar failures - broader; a regression - surgical rollback; stuck 3 rounds - reflect.",
      "out": {
        "test_defects": "Failure[]",
        "code_defects": "Finding[]",
        "env_issues": "string[]",
        "test_defect_count": "int",
        "converged": "bool"
      },
      "guards": {
        "maxVisits": 3,
        "timeoutMin": 20
      },
      "consumes": [
        {
          "kind": "task-result",
          "version": 1,
          "from": "write_tests"
        }
      ]
    },
    {
      "id": "fix_tests",
      "consumes": [
        {
          "kind": "report",
          "version": 1,
          "from": "classify"
        }
      ],
      "produces": [
        {
          "kind": "task-result",
          "version": 1
        }
      ],
      "type": "lp-task",
      "title": {
        "en": "Fix the tests",
        "ru": "Поправить тесты"
      },
      "contract_template": "fix only the listed test_defects within added_files, the test files this workflow added; owns_paths only those files",
      "quality_mode": "quick",
      "out": {
        "state": "accepted|failed|blocked|needs_human|cancelled",
        "merge_commit": "string"
      },
      "guards": {
        "maxAttempts": 1
      }
    },
    {
      "id": "done",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "done",
        "tests_added": "inventory.tests_added",
        "pass_rate": "run.pass_rate",
        "failures": "run.failures",
        "code_defects": "classify.code_defects",
        "env_issues": "classify.env_issues"
      }
    },
    {
      "id": "partial",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "partial",
        "tests_added": "inventory.tests_added",
        "pass_rate": "run.pass_rate",
        "failures": "run.failures",
        "code_defects": "classify.code_defects",
        "env_issues": "classify.env_issues"
      }
    },
    {
      "id": "blocked",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "blocked"
      }
    },
    {
      "id": "baseline_blocked",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "blocked",
        "measurement_reason": "baseline.reason"
      }
    },
    {
      "id": "inventory_blocked",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "blocked",
        "measurement_reason": "inventory.reason"
      }
    }
  ],
  "edges": [
    {
      "from": "derive",
      "to": "confirm",
      "pass": "artifact"
    },
    {
      "from": "confirm",
      "to": "blocked",
      "when": "confirm.answer_kind == 'timeout'"
    },
    {
      "from": "confirm",
      "to": "baseline",
      "pass": "artifact"
    },
    {
      "from": "baseline",
      "to": "baseline_blocked",
      "when": "baseline.status != 'measured'"
    },
    {
      "from": "baseline",
      "to": "write_tests",
      "pass": "artifact",
      "with": {
        "derived_gaps": "derive.gaps",
        "owner_answer": "confirm.answer",
        "owner_answer_kind": "confirm.answer_kind"
      }
    },
    {
      "from": "write_tests",
      "to": "run",
      "pass": "artifact",
      "when": "write_tests.state == 'accepted'"
    },
    {
      "from": "write_tests",
      "to": "blocked",
      "pass": "artifact"
    },
    {
      "from": "run",
      "to": "inventory",
      "pass": "artifact"
    },
    {
      "from": "inventory",
      "to": "inventory_blocked",
      "when": "inventory.status != 'measured'"
    },
    {
      "from": "inventory",
      "to": "inventory_blocked",
      "when": "run.ok && !inventory.runner_ok"
    },
    {
      "from": "inventory",
      "to": "blocked",
      "pass": "artifact",
      "when": "run.no_framework"
    },
    {
      "from": "inventory",
      "to": "done",
      "pass": "artifact",
      "when": "run.ok"
    },
    {
      "from": "inventory",
      "to": "classify",
      "pass": "artifact",
      "with": {
        "failures": "run.failures",
        "pass_rate": "run.pass_rate",
        "tests_passed": "run.tests_passed",
        "tests_failed": "run.tests_failed"
      }
    },
    {
      "from": "classify",
      "to": "done",
      "pass": "artifact",
      "when": "classify.converged && classify.test_defects.length == 0"
    },
    {
      "from": "classify",
      "to": "fix_tests",
      "pass": "artifact",
      "when": "classify.test_defects.length > 0 && visits('classify') < 3",
      "with": {
        "test_defects": "classify.test_defects",
        "added_files": "write_tests.files"
      }
    },
    {
      "from": "classify",
      "to": "partial",
      "pass": "artifact"
    },
    {
      "from": "fix_tests",
      "to": "run",
      "pass": "artifact",
      "when": "fix_tests.state == 'accepted'"
    },
    {
      "from": "fix_tests",
      "to": "blocked",
      "pass": "artifact"
    }
  ],
  "test": {
    "id": "tg-1",
    "sim": {
      "input": {
        "scope": "src/discount.ts",
        "gaps": [
          {
            "file": "src/discount.ts",
            "layer": "L1",
            "priority": "high"
          }
        ]
      },
      "stubs": {
        "write_tests": {
          "state": "accepted"
        },
        "run": {
          "ok": false,
          "failures": [
            {
              "id": "AF-1"
            }
          ],
          "pass_rate": 80
        },
        "classify": {
          "converged": true,
          "test_defects": [],
          "code_defects": [
            {
              "severity": "high",
              "file": "src/discount.ts",
              "line": 14
            }
          ]
        },
        "derive": {
          "gaps": []
        },
        "baseline": {
          "status": "measured",
          "reason": ""
        },
        "inventory": {
          "status": "measured",
          "reason": "",
          "tests_added": 5,
          "runner_ok": true
        }
      },
      "expect_path": [
        "derive",
        "confirm",
        "baseline",
        "write_tests",
        "run",
        "inventory",
        "classify",
        "done"
      ],
      "expect_outputs": [
        "status == 'done'",
        "tests_added == 5",
        "code_defects.length == 1"
      ]
    },
    "live": "песочница: функция с известным багом скидки; тест на баг помечен expected_fail, исходники не изменены"
  }
}
