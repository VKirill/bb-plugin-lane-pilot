{
  "id": "validate-phase",
  "name": {
    "en": "Validate a phase (check coverage)",
    "ru": "Проверка покрытия фазы"
  },
  "description": {
    "en": "Audits whether every promise and requirement of a phase has a check that would fail without the work, samples the checks against a broken copy, and writes VALIDATION.md with the gaps.",
    "ru": "Проверяет, у каждого ли обещания и требования фазы есть проверка, которая упала бы без работы, пробует проверки на испорченной копии и пишет VALIDATION.md с пробелами."
  },
  "examples": {
    "ru": [
      "Проверь покрытие фазы проверками",
      "Хватает ли тестов на обещания этой фазы?",
      "Сделай VALIDATION.md для фазы",
      "Найди обещания без настоящей проверки"
    ],
    "en": [
      "Check the phase's check coverage",
      "Are the phase promises really tested?",
      "Write VALIDATION.md for the phase",
      "Find promises without a real check"
    ]
  },
  "not_for": [
    "code-review",
    "test-gen"
  ],
  "status": "published",
  "inputs": {
    "phase_id": {
      "type": "string",
      "required": true
    }
  },
  "outputs": {
    "status": "done|gaps",
    "gaps": "string[]",
    "validation_path": "string"
  },
  "quality_mode": {
    "default": "standard"
  },
  "requires": {
    "plugins": [
      "lane-pilot"
    ]
  },
  "budget": {
    "max_minutes": 60
  },
  "entry": "audit",
  "nodes": [
    {
      "id": "audit",
      "type": "agent",
      "role": "auditor",
      "title": {
        "en": "Coverage audit",
        "ru": "Аудит покрытия"
      },
      "prompt": "Read the phase's SPEC.md, PLAN.md and the task contracts (lane_pilot_phase status). For each promise and requirement: which check proves it, would that check fail without the work (mutate one line in a throwaway copy and run it), is it existence-only. Return the complete raw Markdown of VALIDATION.md (the VALIDATION template's table with one row per promise and the gaps) in document; the code-owned writer persists it to .agents/phases/<id>/. This read-only helper does not write files.",
      "out": {
        "gaps": "string[]",
        "document": "string",
        "sampled": "int"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 25
      },
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ]
    },
    {
      "id": "done",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "done",
        "gaps": "[]",
        "validation_path": "write_validation.validation_path"
      }
    },
    {
      "id": "gaps",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "gaps",
        "gaps": "audit.gaps",
        "validation_path": "write_validation.validation_path"
      }
    },
    {
      "id": "goal_check",
      "type": "action",
      "action": "deliverable.validate",
      "title": {
        "en": "Check the goal was met",
        "ru": "Проверить, что цель достигнута"
      },
      "rule": "validateDeliverable on the artifact the run produced: the deliverable/validator/brief inputs name what to check; a fail means the goal is not met",
      "out": {
        "ok": "bool",
        "verdict": "pass|rework|fail",
        "reason": "string",
        "details": "object"
      }
    },
    {
      "id": "doc_path",
      "type": "action",
      "action": "lp.doc_path",
      "title": {
        "en": "Resolve the document path",
        "ru": "Путь документа"
      },
      "params": {
        "phase_id": "{{$inputs.phase_id}}",
        "doc": "VALIDATION.md"
      },
      "out": {
        "path": "string"
      }
    },
    {
      "id": "write_validation",
      "type": "action",
      "action": "fs.write",
      "out": {
        "validation_path": "string"
      },
      "title": {
        "en": "Write the validation report",
        "ru": "Записать отчёт валидации"
      },
      "params": {
        "path": "{{doc_path.path}}",
        "contents": "{{audit.document}}"
      }
    }
  ],
  "edges": [
    {
      "from": "doc_path",
      "to": "write_validation",
      "pass": "artifact"
    },
    {
      "from": "audit",
      "to": "doc_path",
      "pass": "artifact"
    },
    {
      "from": "write_validation",
      "to": "gaps",
      "pass": "artifact",
      "when": "audit.gaps.length > 0"
    },
    {
      "from": "write_validation",
      "to": "goal_check",
      "pass": "artifact",
      "with": {
        "path": "write_validation.validation_path"
      }
    },
    {
      "from": "goal_check",
      "to": "done",
      "when": "goal_check.ok != false"
    },
    {
      "from": "goal_check",
      "to": "gaps"
    }
  ],
  "test": {
    "id": "vp-1",
    "sim": {
      "input": {
        "phase_id": "ph_sample01"
      },
      "stubs": {
        "audit": {
          "gaps": [],
          "document": "# VALIDATION\n",
          "sampled": 3
        },
        "doc_path": {
          "path": ".agents/phases/ph_sample01/VALIDATION.md"
        }
      },
      "expect_path": [
        "audit",
        "doc_path",
        "write_validation",
        "goal_check",
        "done"
      ],
      "expect_outputs": [
        "status == 'done'"
      ]
    }
  },
  "goal_check": "validate"
}
