{
  "id": "new-milestone",
  "name": {
    "en": "New milestone",
    "ru": "Новый этап"
  },
  "description": {
    "en": "Starts the next milestone: its goals, the requirements it delivers (REQUIREMENTS.md rows), and the roadmap phases that get there (lp.phase_add), after the previous milestone is archived.",
    "ru": "Начинает следующий этап: его цели, требования (строки REQUIREMENTS.md) и фазы дорожной карты, которые к ним ведут (lp.phase_add), после архивации прошлого этапа."
  },
  "category": "planning",
  "examples": {
    "ru": [
      "Начни новый этап проекта",
      "Спланируй следующий майлстоун",
      "Какие фазы нужны для версии 2?",
      "Новый этап: цели и фазы"
    ],
    "en": [
      "Start a new milestone",
      "Plan the next milestone",
      "Which phases do we need for v2?",
      "New milestone: goals and phases"
    ]
  },
  "not_for": [
    "milestone-close",
    "roadmap-driven"
  ],
  "status": "published",
  "inputs": {
    "goal": {
      "type": "string",
      "required": true
    }
  },
  "outputs": {
    "status": "done",
    "phases": "string[]"
  },
  "quality_mode": {
    "default": "standard"
  },
  "requires": {
    "plugins": [
      "lane-pilot"
    ]
  },
  "budget": {
    "max_minutes": 60
  },
  "entry": "archive",
  "nodes": [
    {
      "id": "archive",
      "type": "action",
      "action": "lp.milestone_archive",
      "title": {
        "en": "Archive the previous milestone",
        "ru": "Архив прошлого этапа"
      },
      "out": {
        "folder": "string",
        "files": "string[]",
        "kept": "bool"
      }
    },
    {
      "id": "frame",
      "type": "agent",
      "role": "planner",
      "title": {
        "en": "Milestone frame",
        "ru": "Рамка этапа"
      },
      "prompt": "From the goal: 3-7 requirements with ids — return the raw Markdown requirements block in document (the code-owned writer appends it to .agents/planning/REQUIREMENTS.md) and the phases in order in phases, each a vertical slice (see templates/planning/references/mvp-stories.md); the code-owned writer registers them as roadmap rows (lp.phase_add). This read-only helper does not write files and runs no external CLI commands.",
      "out": {
        "phases": "string[]",
        "document": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 25
      },
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ]
    },
    {
      "id": "done",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "done",
        "phases": "frame.phases"
      }
    },
    {
      "id": "write_requirements",
      "type": "action",
      "action": "fs.write",
      "path": ".agents/planning/REQUIREMENTS.md",
      "contents": "{{frame.document}}",
      "out": {
        "requirements_path": "string"
      },
      "mode": "append",
      "title": {
        "en": "Append the requirements",
        "ru": "Дописать требования"
      },
      "skip_when": "!frame.document",
      "skip_out": {
        "requirements_path": ""
      }
    },
    {
      "id": "add_phases",
      "type": "action",
      "action": "lp.phase_add",
      "title": {
        "en": "Register the milestone phases",
        "ru": "Зарегистрировать фазы этапа"
      },
      "params": {
        "goal": "{{$inputs.goal}}"
      },
      "reads": [
        "frame.phases"
      ],
      "out": {
        "added": "string[]",
        "count": "int"
      },
      "skip_when": "!frame.phases.length"
    }
  ],
  "edges": [
    {
      "from": "archive",
      "to": "frame",
      "pass": "artifact"
    },
    {
      "from": "frame",
      "to": "write_requirements",
      "pass": "artifact"
    },
    {
      "from": "write_requirements",
      "to": "add_phases",
      "pass": "artifact"
    },
    {
      "from": "add_phases",
      "to": "done"
    }
  ],
  "test": {
    "id": "nm-1",
    "sim": {
      "input": {
        "goal": "v2 billing"
      },
      "stubs": {
        "frame": {
          "phases": [
            "1 billing",
            "2 invoices"
          ],
          "document": "- REQ-a\n"
        },
        "add_phases": {
          "added": [],
          "count": 2
        }
      },
      "expect_path": [
        "archive",
        "frame",
        "write_requirements",
        "add_phases",
        "done"
      ],
      "expect_outputs": [
        "status == 'done'",
        "phases.length == 2"
      ]
    }
  },
  "goal_check": "artifact"
}
