{
  "id": "site-creation",
  "name": {
    "en": "Universal website creation lifecycle",
    "ru": "Универсальное создание сайта с референсами"
  },
  "description": {
    "en": "End-to-end website creation for any niche: smart intake and optional brief questions, competitor reference discovery when none are given, structured copywriting, visual concepts with owner approval saved to process state, isolated worktree implementation, and browser verification at 375 and 1280 px.",
    "ru": "Полный цикл создания сайта под любую нишу: умный разбор входа и при необходимости уточнение брифа, поиск референсов и анализ конкурентов (если референсы не переданы), структура и тексты, визуальные концепты с утверждением владельца и записью в process-state, сборка в изолированном worktree и проверка в браузере на 375 и 1280 px."
  },
  "examples": {
    "ru": [
      "Создай сайт с нуля под тематику стоматологической клиники, собери референсы конкурентов и проверь в браузере",
      "Нужно разработать сайт для сервиса доставки здорового питания с подбором референсов и дизайн-концептом",
      "Сделай новый сайт под нишу архитектурного бюро: структура, тексты, концепт и сборка",
      "Создай сайт для студии детейлинга, если данных не хватает — задай вопросы и покажи концепты"
    ],
    "en": [
      "Create a new website from scratch for a specialty coffee roastery, discover competitor references and verify in browser",
      "Build a website for a B2B SaaS product with copywriting, visual direction approval and worktree build",
      "Develop a website for an architecture studio with reference research and responsive 375/1280 QA"
    ]
  },
  "not_for": [
    "about-site",
    "ui-audit"
  ],
  "status": "published",
  "category": {
    "id": "websites",
    "label": {
      "en": "Websites & Design",
      "ru": "Сайты и дизайн"
    }
  },
  "tags": [
    "website",
    "site",
    "design",
    "copywriting",
    "code"
  ],
  "triggers": [
    "chat",
    "manual"
  ],
  "inputs": {
    "goal": {
      "type": "string",
      "required": true
    },
    "niche": {
      "type": "string",
      "default": ""
    },
    "references": {
      "type": "string",
      "default": ""
    },
    "facts_source": {
      "type": "string",
      "default": ""
    },
    "locale": {
      "type": "string",
      "default": "ru"
    },
    "quality_mode": {
      "type": "quick|standard|full",
      "default": "standard"
    }
  },
  "outputs": {
    "status": "done|blocked|aborted",
    "site_summary": "string",
    "baseline_path": "string",
    "merge_commit": "string"
  },
  "quality_mode": {
    "default": "standard",
    "effect": "Browser verification at 375 and 1280 px always runs; full adds deeper concept variants and copy polish."
  },
  "requires": {
    "plugins": [
      "lane-pilot"
    ],
    "skills": [
      "ru-text",
      "karpathy-guidelines",
      "impeccable-ui",
      "design-taste",
      "web-design"
    ],
    "machines": [
      "project writer host",
      "browser machine"
    ],
    "project": {
      "git": true
    }
  },
  "budget": {
    "max_minutes": 480
  },
  "nodes": [
    {
      "id": "smart_intake",
      "type": "agent",
      "role": "planner",
      "produces": [
        {
          "kind": "plan",
          "version": 1
        }
      ],
      "title": {
        "en": "Analyze goal, brief completeness and references",
        "ru": "Анализ цели, полноты брифа и референсов"
      },
      "prompt": "Analyze the website creation request: goal=<data>{{$inputs.goal}}</data>, niche=<data>{{$inputs.niche}}</data>, references=<data>{{$inputs.references}}</data>, facts_source=<data>{{$inputs.facts_source}}</data>, locale={{$inputs.locale}}, quality_mode={{$inputs.quality_mode}}. Inspect existing project files if any (such as project passport, brand facts, or repository layout) without modifying code. Build a clear stage plan (`objective` and initial `tasks` with id and title). Set `needs_brief` to true only if essential details (target audience, core offer, or primary CTA) are missing and must be clarified with the owner; otherwise false. Set `has_references` to true if `references` already contains concrete URLs, visual directions, or competitor examples; otherwise false. Provide up to 4 concise clarifying `questions` when `needs_brief` is true (empty array otherwise).",
      "out": {
        "objective": "string",
        "tasks": "Task[]",
        "needs_brief": "bool",
        "has_references": "bool",
        "questions": "string[]"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 20
      }
    },
    {
      "id": "ask_brief",
      "type": "human",
      "role": "owner",
      "skip_when": "smart_intake.needs_brief == false",
      "skip_out": {
        "answer": "",
        "answer_kind": "answered"
      },
      "title": {
        "en": "Clarify website brief",
        "ru": "Уточнить бриф сайта"
      },
      "question": "Please answer the clarifying questions for the website brief (or select abort to cancel):\n{{smart_intake.questions}}",
      "options": [
        "answered",
        "abort"
      ],
      "onTimeout": "stop",
      "out": {
        "answer": "string",
        "answer_kind": "answered|abort|timeout"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 240
      }
    },
    {
      "id": "discover_references",
      "type": "agent",
      "role": "specialist:design-lead",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "skip_when": "smart_intake.has_references == true",
      "skip_out": {
        "handoff": "'Owner references provided'",
        "direction_pack": "owner-references"
      },
      "title": {
        "en": "Discover competitor references and visual directions",
        "ru": "Поиск референсов и анализ конкурентов"
      },
      "prompt": "Research competitor sites and niche design references for objective={{smart_intake.objective}}, niche=<data>{{$inputs.niche}}</data>, goal=<data>{{$inputs.goal}}</data>, owner_notes=<data>{{ask_brief.answer}}</data>. Analyze strong patterns in layout, hierarchy, trust signals, conversion paths, and typography for the niche. Save a structured reference pack to run artifacts (`direction_pack` path) and summarize key findings in `handoff`.",
      "out": {
        "handoff": "string",
        "direction_pack": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 30
      }
    },
    {
      "id": "copy_and_structure",
      "type": "agent",
      "role": "specialist:copy-lead",
      "profile": {
        "skills": [
          "ru-text",
          "karpathy-guidelines"
        ]
      },
      "consumes": [
        {
          "kind": "report",
          "version": 1,
          "from": "discover_references"
        }
      ],
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "title": {
        "en": "Website structure and copywriting",
        "ru": "Структура блоков и тексты сайта"
      },
      "prompt": "Design the information architecture, page sections, and website copy in locale={{$inputs.locale}} for objective={{smart_intake.objective}}. Ground all claims strictly in verified facts from facts_source=<data>{{$inputs.facts_source}}</data>, goal=<data>{{$inputs.goal}}</data>, owner_notes=<data>{{ask_brief.answer}}</data>, and direction_pack={{discover_references.direction_pack}} ({{discover_references.handoff}}). Never invent statistics, testimonials, or unverified claims. Write the structured section plan and copy into run artifacts (`sections_path`) and return a concise `handoff`.",
      "out": {
        "handoff": "string",
        "sections_path": "string"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 30
      }
    },
    {
      "id": "visual_concepts",
      "type": "agent",
      "role": "specialist:design-lead",
      "profile": {
        "skills": [
          "impeccable-ui",
          "design-taste",
          "web-design"
        ]
      },
      "consumes": [
        {
          "kind": "report",
          "version": 1,
          "from": "copy_and_structure"
        }
      ],
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "title": {
        "en": "Visual concepts and baseline prototype",
        "ru": "Визуальные концепты и дизайн-бейзлайн"
      },
      "prompt": "Create cohesive visual direction, design tokens (color, typography, spacing, component states, 375 and 1280 px responsive rules), and an interactive baseline prototype using sections={{copy_and_structure.sections_path}} ({{copy_and_structure.handoff}}) and references={{discover_references.direction_pack}}. If owner feedback was passed from a prior approval round, address every point without generic templates. Save the baseline artifact (`baseline_path`) and compute its 64-char hex SHA-256 (`baseline_sha256`), returning a concise `handoff`.",
      "out": {
        "handoff": "string",
        "baseline_path": "string",
        "baseline_sha256": "string"
      },
      "guards": {
        "maxVisits": 3,
        "timeoutMin": 35
      }
    },
    {
      "id": "approve_direction",
      "type": "human",
      "role": "owner",
      "title": {
        "en": "Approve visual direction",
        "ru": "Утвердить визуальное направление"
      },
      "question": "Review the proposed visual direction and baseline ({{visual_concepts.baseline_path}}):\n{{visual_concepts.handoff}}\nChoose approve to lock the design baseline and proceed to build, rework to refine the concepts, or abort to stop.",
      "options": [
        "approve",
        "rework",
        "abort"
      ],
      "onTimeout": "stop",
      "out": {
        "answer": "string",
        "answer_kind": "approve|rework|abort|timeout"
      },
      "guards": {
        "maxVisits": 3,
        "timeoutMin": 240
      }
    },
    {
      "id": "save_process_state",
      "type": "action",
      "action": "lp.save_process_state",
      "title": {
        "en": "Persist approved design baseline",
        "ru": "Сохранить утверждённый дизайн-бейзлайн"
      },
      "params": {
        "stage": "approved-design",
        "workflowId": "site-creation",
        "approvedDesignBaseline": {
          "path": "{{visual_concepts.baseline_path}}",
          "sha256": "{{visual_concepts.baseline_sha256}}"
        },
        "activeSkills": [
          "ru-text",
          "karpathy-guidelines",
          "impeccable-ui",
          "design-taste",
          "web-design"
        ]
      },
      "out": {
        "saved": "bool",
        "path": "string",
        "stage": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 5
      }
    },
    {
      "id": "build_site",
      "type": "lp-task",
      "consumes": [
        {
          "kind": "report",
          "version": 1,
          "from": "visual_concepts"
        }
      ],
      "produces": [
        {
          "kind": "task-result",
          "version": 1
        }
      ],
      "title": {
        "en": "Build website in isolated worktree",
        "ru": "Сборка сайта в изолированном worktree"
      },
      "contract_template": "implement the approved website structure, copy, and visual tokens from {{visual_concepts.baseline_path}} and {{copy_and_structure.sections_path}} in an isolated writer worktree; run project build and tests",
      "out": {
        "state": "accepted|failed|blocked|needs_human|cancelled",
        "merge_commit": "string"
      },
      "guards": {
        "maxAttempts": 2,
        "maxVisits": 2
      }
    },
    {
      "id": "verify_browser",
      "type": "agent",
      "role": "browser-qa",
      "produces": [
        {
          "kind": "qa-report",
          "version": 1
        }
      ],
      "title": {
        "en": "Verify site in browser (375 and 1280 px)",
        "ru": "Проверка сайта в браузере (375 и 1280 px)"
      },
      "prompt": "Verify the built website in a browser at 375 and 1280 px viewports: check first-screen clarity, layout, responsive sections, interactive controls, and console or network errors; save screenshots to run artifacts. Return status (pass, rework, or block), findings (each with severity critical, high, medium, low, or info), and screenshots.",
      "out": {
        "status": "pass|rework|block",
        "findings": "Finding[]",
        "screenshots": "string[]"
      },
      "guards": {
        "maxVisits": 2,
        "timeoutMin": 35
      }
    },
    {
      "id": "done",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "done",
        "site_summary": "visual_concepts.handoff",
        "baseline_path": "visual_concepts.baseline_path",
        "merge_commit": "build_site.merge_commit"
      }
    },
    {
      "id": "blocked",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "blocked",
        "site_summary": "'site creation blocked during build or browser verification'",
        "baseline_path": "visual_concepts.baseline_path",
        "merge_commit": "''"
      }
    },
    {
      "id": "aborted",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "aborted",
        "site_summary": "'site creation aborted by owner'",
        "baseline_path": "''",
        "merge_commit": "''"
      }
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "smart_intake"
    },
    {
      "from": "smart_intake",
      "to": "ask_brief"
    },
    {
      "from": "ask_brief",
      "to": "aborted",
      "when": "ask_brief.answer_kind in ['abort', 'timeout']"
    },
    {
      "from": "ask_brief",
      "to": "discover_references"
    },
    {
      "from": "discover_references",
      "to": "copy_and_structure"
    },
    {
      "from": "copy_and_structure",
      "to": "visual_concepts"
    },
    {
      "from": "visual_concepts",
      "to": "approve_direction"
    },
    {
      "from": "approve_direction",
      "to": "save_process_state",
      "when": "approve_direction.answer_kind == 'approve'"
    },
    {
      "from": "approve_direction",
      "to": "visual_concepts",
      "when": "approve_direction.answer_kind == 'rework' && visits('visual_concepts') < 3",
      "with": {
        "feedback": "approve_direction.answer"
      }
    },
    {
      "from": "approve_direction",
      "to": "aborted"
    },
    {
      "from": "save_process_state",
      "to": "build_site"
    },
    {
      "from": "build_site",
      "to": "verify_browser",
      "when": "build_site.state == 'accepted'"
    },
    {
      "from": "build_site",
      "to": "blocked"
    },
    {
      "from": "verify_browser",
      "to": "done",
      "when": "verify_browser.status == 'pass'"
    },
    {
      "from": "verify_browser",
      "to": "build_site",
      "when": "verify_browser.status == 'rework' && visits('build_site') < 2",
      "with": {
        "qa_findings": "verify_browser.findings"
      }
    },
    {
      "from": "verify_browser",
      "to": "blocked"
    }
  ],
  "test": {
    "id": "site-creation-1",
    "sim": {
      "input": {
        "goal": "Create a website for a dental clinic with competitor references",
        "niche": "dental clinic",
        "locale": "ru"
      },
      "stubs": {
        "smart_intake": {
          "objective": "Create dental clinic website",
          "tasks": [
            {
              "id": "t1",
              "title": "Build clinic website"
            }
          ],
          "needs_brief": false,
          "has_references": false,
          "questions": []
        },
        "discover_references": {
          "handoff": "Collected 3 dental clinic references",
          "direction_pack": ".agents/site/references.md"
        },
        "copy_and_structure": {
          "handoff": "Prepared website sections and RU copy",
          "sections_path": ".agents/site/sections.md"
        },
        "visual_concepts": {
          "handoff": "Clean clinical typography and warm accent tokens",
          "baseline_path": ".agents/site/baseline.html",
          "baseline_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "save_process_state": {
          "saved": true,
          "path": ".agents/pilot/process-state.json",
          "stage": "approved-design"
        },
        "build_site": {
          "state": "accepted",
          "merge_commit": "abc1234"
        },
        "verify_browser": {
          "status": "pass",
          "findings": [],
          "screenshots": [
            ".agents/site/375.png",
            ".agents/site/1280.png"
          ]
        }
      },
      "human_answers": {
        "approve_direction": "approve"
      },
      "expect_path": [
        "smart_intake",
        "ask_brief",
        "discover_references",
        "copy_and_structure",
        "visual_concepts",
        "approve_direction",
        "save_process_state",
        "build_site",
        "verify_browser",
        "done"
      ],
      "expect_output": {
        "status": "done",
        "baseline_path": ".agents/site/baseline.html",
        "merge_commit": "abc1234"
      },
      "variant_with_refs": {
        "input": {
          "goal": "Create a SaaS analytics website using provided references",
          "references": "https://example.com/ref-1",
          "locale": "en"
        },
        "stubs": {
          "smart_intake": {
            "objective": "Create SaaS analytics website",
            "tasks": [
              {
                "id": "t1",
                "title": "Build SaaS website"
              }
            ],
            "needs_brief": false,
            "has_references": true,
            "questions": []
          }
        },
        "expect_path": [
          "smart_intake",
          "ask_brief",
          "discover_references",
          "copy_and_structure",
          "visual_concepts",
          "approve_direction",
          "save_process_state",
          "build_site",
          "verify_browser",
          "done"
        ],
        "expect_output": {
          "status": "done"
        }
      },
      "variant_rework": {
        "stubs": {
          "build_site": [
            {
              "state": "accepted",
              "merge_commit": "abc1234"
            },
            {
              "state": "accepted",
              "merge_commit": "def5678"
            }
          ],
          "verify_browser": [
            {
              "status": "rework",
              "findings": [
                {
                  "severity": "high",
                  "title": "Mobile hero CTA wraps awkwardly at 375 px"
                }
              ],
              "screenshots": [
                ".agents/site/375-v1.png"
              ]
            },
            {
              "status": "pass",
              "findings": [],
              "screenshots": [
                ".agents/site/375-v2.png",
                ".agents/site/1280-v2.png"
              ]
            }
          ]
        },
        "expect_path": [
          "smart_intake",
          "ask_brief",
          "discover_references",
          "copy_and_structure",
          "visual_concepts",
          "approve_direction",
          "save_process_state",
          "build_site",
          "verify_browser",
          "build_site",
          "verify_browser",
          "done"
        ],
        "expect_output": {
          "status": "done",
          "merge_commit": "def5678"
        }
      },
      "variant_blocked": {
        "stubs": {
          "build_site": {
            "state": "blocked",
            "merge_commit": ""
          }
        },
        "expect_path": [
          "smart_intake",
          "ask_brief",
          "discover_references",
          "copy_and_structure",
          "visual_concepts",
          "approve_direction",
          "save_process_state",
          "build_site",
          "blocked"
        ],
        "expect_output": {
          "status": "blocked"
        }
      },
      "variant_abort": {
        "human_answers": {
          "approve_direction": "abort"
        },
        "expect_path": [
          "smart_intake",
          "ask_brief",
          "discover_references",
          "copy_and_structure",
          "visual_concepts",
          "approve_direction",
          "aborted"
        ],
        "expect_output": {
          "status": "aborted"
        }
      }
    },
    "live": "run site-creation on a sandbox project at 375 and 1280 px, verify process-state.json records approvedDesignBaseline, and check browser screenshots in artifacts"
  },
  "goal_check": "artifact"
}
