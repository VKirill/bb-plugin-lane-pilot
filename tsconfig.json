{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./*"],
      "elkjs/lib/elk.bundled.js": ["./src/ui/elk-shim.d.ts"]
    },
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": false
  },
  "include": ["server.ts", "host.ts", "app.tsx", "src", "tests", "packages"]
}
