{
  "id": "ui-audit",
  "name": {
    "en": "UI audit (evidence-based)",
    "ru": "Аудит интерфейса по доказательствам"
  },
  "description": {
    "en": "Audits a live UI in the browser on six dimensions (visual hierarchy, interaction states, accessibility, responsiveness, micro-interactions, edge cases) and returns scored findings with screenshots. Changes no project file except its review, .agents/ui/<slug>/UI-REVIEW.md (review_file=false: nothing).",
    "ru": "Аудит живого интерфейса в браузере по шести измерениям (иерархия, состояния, доступность, адаптив, микро-взаимодействия, пограничные случаи); возвращает оценённые находки со скриншотами. Не меняет файлы проекта, кроме своего ревью .agents/ui/<slug>/UI-REVIEW.md (review_file=false: ничего)."
  },
  "examples": {
    "ru": [
      "Проверь интерфейс личного кабинета на удобство и доступность",
      "Сделай аудит дизайна главной страницы на 375 и 1280",
      "Оцени состояния кнопок и форм в приложении, найди недочёты",
      "Проверь адаптив и контраст на странице тарифов"
    ],
    "en": [
      "Check the account area UI for usability and accessibility",
      "Audit the home page design at 375 and 1280",
      "Assess button and form states in the app and find the flaws",
      "Check responsiveness and contrast on the pricing page"
    ]
  },
  "not_for": [
    "impeccable-build",
    "code-review"
  ],
  "status": "published",
  "inputs": {
    "url": {
      "type": "string",
      "required": true
    },
    "flows": {
      "type": "string[]"
    },
    "quality_mode": {
      "type": "quick|standard|full",
      "default": "standard"
    },
    "review_file": {
      "type": "bool",
      "default": true,
      "note": "also score the six pillars 0-4 and write the review to .agents/ui/<slug>/UI-REVIEW.md (created or replaced at that exact path; false: no file is written)"
    }
  },
  "outputs": {
    "status": "done|blocked",
    "score_40": "int",
    "score_20": "int",
    "findings": "Finding[]",
    "screenshots": "string[]",
    "report_path": "string",
    "proposed_workflow": "string?"
  },
  "quality_mode": {
    "default": "standard",
    "effect": "quick - 1 вьюпорт и 3 измерения"
  },
  "requires": {
    "plugins": [
      "lane-pilot"
    ],
    "skills": [
      "impeccable-ui",
      "web-design",
      "ui-review"
    ],
    "machines": [
      "browser machine"
    ]
  },
  "budget": {
    "max_minutes": 60
  },
  "entry": "capture",
  "nodes": [
    {
      "id": "capture",
      "produces": [
        {
          "kind": "qa-report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "browser-qa",
      "prompt": "FRONTEND_VERIFY_METHOD: open the URL and the listed flows at 375 and 1280, exercise default/hover/focus/disabled/loading/empty/error states, save screenshots. Report what could not be exercised as blocked, never as passed. Severity is one of critical, high, medium, low, info.",
      "out": {
        "screenshots": "string[]",
        "states_seen": "string[]",
        "status": "pass|rework|block",
        "findings": "Finding[]"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 30
      }
    },
    {
      "id": "audit",
      "consumes": [
        {
          "kind": "qa-report",
          "version": 1,
          "from": "capture"
        }
      ],
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:design-lead",
      "session": "new",
      "src": "impeccable (Apache-2.0): critique, audit",
      "prompt": "Score from the captured evidence only: ten Nielsen heuristics 0-4 (total /40) and five technical dimensions /20 (accessibility, performance, theming, responsiveness, implementation integrity); P0-P3 per finding with a screenshot reference. Do not edit anything.",
      "out": {
        "score_40": "int",
        "score_20": "int",
        "findings": "Finding[]",
        "report_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 25
      }
    },
    {
      "id": "review_doc",
      "type": "agent",
      "role": "specialist:design-lead",
      "session": "new",
      "title": {
        "en": "Six pillars review file",
        "ru": "Файл ревью по шести измерениям"
      },
      "skip_when": "!$inputs.review_file",
      "skip_out": {
        "review_path": ""
      },
      "prompt": "From the audit's evidence only, score each of the six dimensions (visual hierarchy, interaction states, accessibility, responsiveness, micro-interactions, edge cases) 0-4 with the evidence for the score, and write the review to .agents/ui/<slug>/UI-REVIEW.md; the file is created or replaced at that exact path and nowhere else (no .new copy, no other file). Return the path as review_path. Do not edit anything else.",
      "out": {
        "review_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 15
      },
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ]
    },
    {
      "id": "done",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "done",
        "score_40": "audit.score_40",
        "score_20": "audit.score_20",
        "findings": "audit.findings",
        "screenshots": "capture.screenshots",
        "report_path": "audit.report_path"
      }
    },
    {
      "id": "blocked",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "blocked"
      }
    },
    {
      "id": "goal_check",
      "type": "action",
      "action": "deliverable.validate",
      "title": {
        "en": "Check the goal was met",
        "ru": "Проверить, что цель достигнута"
      },
      "rule": "validateDeliverable on the artifact the run produced: the deliverable/validator/brief inputs name what to check; a fail means the goal is not met",
      "out": {
        "ok": "bool",
        "verdict": "pass|rework|fail",
        "reason": "string",
        "details": "object"
      }
    },
    {
      "id": "offer",
      "type": "action",
      "action": "lp.propose_workflow",
      "workflow": "review-fix",
      "inputs": {
        "goal": "Fix UI audit findings",
        "findings": "{{audit.findings}}"
      }
    },
    {
      "id": "done_offer",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "done",
        "score_40": "audit.score_40",
        "score_20": "audit.score_20",
        "findings": "audit.findings",
        "screenshots": "capture.screenshots",
        "report_path": "audit.report_path",
        "proposed_workflow": "'review-fix'"
      }
    }
  ],
  "edges": [
    {
      "from": "capture",
      "to": "blocked",
      "pass": "artifact",
      "when": "capture.status == 'block'"
    },
    {
      "from": "capture",
      "to": "audit",
      "pass": "read-prior-session"
    },
    {
      "from": "audit",
      "to": "review_doc",
      "pass": "artifact"
    },
    {
      "from": "review_doc",
      "to": "goal_check",
      "pass": "artifact"
    },
    {
      "from": "goal_check",
      "to": "offer",
      "when": "goal_check.ok != false && audit.score_40 > 0 && audit.score_40 < 24"
    },
    {
      "from": "offer",
      "to": "done_offer"
    },
    {
      "from": "goal_check",
      "to": "done",
      "when": "goal_check.ok != false"
    },
    {
      "from": "goal_check",
      "to": "blocked"
    }
  ],
  "test": {
    "id": "ua-1",
    "sim": {
      "input": {
        "url": "http://localhost:4173/pricing"
      },
      "stubs": {
        "capture": {
          "status": "pass",
          "screenshots": [
            "s375.png",
            "s1280.png"
          ]
        },
        "audit": {
          "score_40": 30,
          "score_20": 14,
          "findings": [
            {
              "severity": "medium",
              "file": "src/pricing.tsx",
              "line": 55,
              "evidence": "focus ring missing"
            }
          ]
        },
        "review_doc": {
          "review_path": ".agents/ui/pricing/UI-REVIEW.md"
        }
      },
      "expect_path": [
        "capture",
        "audit",
        "review_doc",
        "goal_check",
        "done"
      ],
      "expect_outputs": [
        "status == 'done'",
        "screenshots.length == 2"
      ]
    },
    "live": "локальный сервер песочницы; два скриншота и оценки"
  },
  "goal_check": "validate"
}
