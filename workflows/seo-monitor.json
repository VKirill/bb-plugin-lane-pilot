{
  "id": "seo-monitor",
  "name": {
    "en": "SEO monitor",
    "ru": "SEO-монитор"
  },
  "description": {
    "en": "The weekly loop over a live site: segmented GSC/analytics cohorts, robots and sitemap watch, CWV groups, anomaly buckets, a scored task queue, the monthly link-response review and the cadence checks. It routes each signal to the graph that would handle it and starts the follow-ups that are due; it applies no fixes itself.",
    "ru": "Еженедельный цикл по живому сайту: сегментированные когорты GSC/аналитики, надзор за robots и картами, группы CWV, корзины аномалий, оценённая очередь задач, месячный обзор отклика на ссылки и каденс-проверки. Маршрутизирует каждый сигнал к графу, который бы его обработал, и запускает положенные продолжения; сам ничего не исправляет."
  },
  "examples": {
    "ru": [
      "Проведи недельный SEO-мониторинг сайта",
      "Что изменилось в поиске за неделю и что в очереди",
      "Запусти монитор по паспорту проекта"
    ],
    "en": [
      "Run the weekly SEO monitor on the site",
      "What changed in search this week and what's queued",
      "Start the monitor from the project passport"
    ]
  },
  "not_for": [
    "seo-drop-diagnosis: the forensic diagnosis of one confirmed drop (the monitor only detects and routes it)",
    "mkt-pulse-monitor: paid-ads and product-funnel corridors, not search-console cohorts",
    "seo-project-intake: the first passport of a site",
    "seo-release: shipping changes to the live site",
    "seo-ai-visibility: the full AI citation matrix (the monitor runs only a small monthly AI watch)"
  ],
  "status": "published",
  "tags": [
    "seo",
    "drmax"
  ],
  "inputs": {
    "site_url": {
      "type": "string",
      "required": true
    },
    "project_passport_path": {
      "type": "string",
      "default": ""
    },
    "change_log_path": {
      "type": "string",
      "default": ""
    },
    "cohort_map_path": {
      "type": "string",
      "default": ""
    },
    "link_campaign": {
      "type": "bool",
      "default": false,
      "note": "идёт кампания по ссылкам - нужен месячный обзор"
    },
    "period": {
      "type": "weekly|monthly|quarterly",
      "default": "weekly",
      "note": "каденс этого прогона"
    },
    "release_items": {
      "type": "string[]",
      "note": "релизные элементы, если долг по проверке индексации наступил"
    }
  },
  "outputs": {
    "status": "done|partial|blocked",
    "report_path": "string?",
    "queue_path": "string?",
    "recommendations": "string[]?"
  },
  "requires": {
    "plugins": [
      "lane-pilot"
    ],
    "skills": [
      "google",
      "yandex",
      "seo-project-life",
      "seo-agent",
      "seo-measurement-loop",
      "seo-update-forensics",
      "seo-ai-visibility"
    ],
    "secrets": [
      "XMLSTOCK_KEY?"
    ],
    "browserSession": true
  },
  "budget": {
    "max_minutes": 120,
    "max_usd": 8
  },
  "entry": "pull",
  "nodes": [
    {
      "id": "pull",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "errand-browser",
      "profile": {
        "skills": [
          "google",
          "yandex",
          "seo-measurement-loop"
        ]
      },
      "title": {
        "en": "Pull the week",
        "ru": "Выгрузка недели"
      },
      "prompt": "Weekly exports in the owner's session: GSC, Yandex Webmaster and analytics joined by URL, brand vs non-brand split, page-class cohorts, the raw archive and the striking-distance list. Return pull_path and urls.",
      "out": {
        "pull_path": "string",
        "urls": "int"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 40
      }
    },
    {
      "id": "tech_watch",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "title": {
        "en": "Tech watch",
        "ru": "Технический надзор"
      },
      "prompt": "robots.txt hash vs last known, indexing rate per sitemap segment and lastmod credibility, CWV group status, manual actions and security issues for {{$inputs.site_url}}. Return watch_path and alerts.",
      "out": {
        "watch_path": "string",
        "alerts": "string[]"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 20
      }
    },
    {
      "id": "anomalies",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "profile": {
        "skills": [
          "seo-update-forensics",
          "seo-measurement-loop"
        ]
      },
      "title": {
        "en": "Anomaly buckets",
        "ru": "Корзины аномалий"
      },
      "prompt": "Page-role map and the A-D anomaly buckets, 28 days before vs after. Return anomalies_path and buckets.",
      "out": {
        "anomalies_path": "string",
        "buckets": "int"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 25
      }
    },
    {
      "id": "pulse_backtest",
      "type": "action",
      "action": "sp.run_script",
      "title": {
        "en": "Release backtest against control cohorts ($0)",
        "ru": "Бэктест релизов против контрольных когорт ($0)"
      },
      "skill": "seo-measurement-loop",
      "script": "pulse_02_backtest.py",
      "args": {
        "pull": "{{pull.pull_path}}",
        "change_log": "{{$inputs.change_log_path}}",
        "method": "diff_in_diff",
        "mark_confounded": true
      },
      "timeoutSec": 120,
      "out": {
        "backtest_path": "string",
        "wins": "int",
        "losses": "int",
        "confounded_windows": "int"
      }
    },
    {
      "id": "pulse_rules",
      "type": "action",
      "action": "sp.run_script",
      "title": {
        "en": "Drop rules: final days, Poisson z, holidays, demand control ($0)",
        "ru": "Правила просадки: финальные дни, z Пуассона, праздники, контроль спроса ($0)"
      },
      "skill": "seo-measurement-loop",
      "script": "pulse_rules.py",
      "args": {
        "pull": "{{pull.pull_path}}",
        "window": "today-10d..today-3d",
        "ratio_lt": 0.82,
        "min_baseline_clicks_7d": 150,
        "poisson_z_lt": -2.5,
        "calendar": "calendar-ru",
        "demand_control": {
          "impressions_ratio_lt": 0.82,
          "abs_pos_delta_lt": 0.5
        }
      },
      "timeoutSec": 60,
      "out": {
        "drop_signal": "bool",
        "seasonality": "bool",
        "striking_distance": "int",
        "rules_path": "string"
      }
    },
    {
      "id": "queue",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "profile": {
        "skills": [
          "seo-project-life",
          "seo-measurement-loop"
        ]
      },
      "title": {
        "en": "Task queue",
        "ru": "Очередь задач"
      },
      "prompt": "Score each signal into a task passport: sprint, reserve or frozen, the A/B/C queues with WIP limits, the idea archive and the stop-list. Return queue_path and queued.",
      "out": {
        "queue_path": "string",
        "queued": "int"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 20
      }
    },
    {
      "id": "links_review",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "skip_when": "$inputs.link_campaign == false || $inputs.period == 'weekly'",
      "skip_out": {
        "links_path": "",
        "verdicts": []
      },
      "title": {
        "en": "Link response review",
        "ru": "Обзор отклика на ссылки"
      },
      "prompt": "Only when a link campaign is active and the period is monthly or quarterly: how the cluster responded in GSC after each batch, plus the decision for each campaign. Return links_path and verdicts.",
      "out": {
        "links_path": "string",
        "verdicts": "string[]"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 20
      }
    },
    {
      "id": "cadence",
      "produces": [
        {
          "kind": "report",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "specialist:seo-specialist",
      "skip_when": "$inputs.period == 'weekly'",
      "skip_out": {
        "cadence_path": ""
      },
      "title": {
        "en": "Cadence plan",
        "ru": "Каденс-план"
      },
      "prompt": "First run of the month or quarter: the improvement loop and the quarterly structural and E-E-A-T plan; turn Bing AI Performance exports into a plan when available. Return cadence_path.",
      "out": {
        "cadence_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 25
      }
    },
    {
      "id": "ai_watch",
      "type": "action",
      "action": "sp.run_script",
      "title": {
        "en": "Monthly AI citation watch ($0 LLM)",
        "ru": "Месячный надзор за цитированием в AI ($0 LLM)"
      },
      "skip_when": "$inputs.period == 'weekly'",
      "skip_out": {
        "citation_share": 0,
        "citation_delta": 0,
        "watch_path": ""
      },
      "skill": "seo-ai-visibility",
      "script": "ai_vis_collect.py",
      "args": {
        "panel": ".agents/seo/ai-visibility/panel.json",
        "sample": 15,
        "engines": "alice,google_aio",
        "mode": "watch"
      },
      "secrets": [
        "XMLSTOCK_KEY?"
      ],
      "timeoutSec": 120,
      "out": {
        "citation_share": "number",
        "citation_delta": "number",
        "watch_path": "string"
      }
    },
    {
      "id": "route",
      "produces": [
        {
          "kind": "verdict",
          "version": 1
        }
      ],
      "type": "agent",
      "role": "plan-critic",
      "session": "new",
      "title": {
        "en": "Route the signals",
        "ru": "Маршрутизация сигналов"
      },
      "prompt": "Check the Search Status Dashboard and route each due signal. drop_due ONLY when pulse_rules.drop_signal is {{pulse_rules.drop_signal}} = true and pulse_rules.seasonality is false (rules in {{pulse_rules.rules_path}}; never from your own reading of GSC). CTR, stalled or stale page -> refresh_due; positions 8-20 ({{pulse_rules.striking_distance}} pages) -> structure_due; template or tech regression -> tech_due; release_due only when an index check is due; ai_visibility_due when ai_watch.citation_delta is below -0.03 ({{ai_watch.citation_delta}}). Backtest {{pulse_backtest.backtest_path}}: a confounded window is no evidence. A seo-template-scale pilot with indexation_rate_14d >= 0.65 and a non-negative backtest becomes the recommendation «next wave allowed». Wave-3 graphs (seo-trust, seo-linkbuilding, seo-template-scale) stay recommendations. Status pass | rework | block; severity one of critical, high, medium, low, info.",
      "out": {
        "status": "pass|rework|block",
        "signals": "string[]",
        "recommendations": "string[]",
        "drop_due": "bool",
        "refresh_due": "bool",
        "structure_due": "bool",
        "tech_due": "bool",
        "release_due": "bool",
        "ai_visibility_due": "bool"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 20
      }
    },
    {
      "id": "drop",
      "type": "subworkflow",
      "workflow": "seo-drop-diagnosis",
      "skip_when": "route.drop_due != true",
      "skip_out": {
        "status": "skipped",
        "diagnosis_path": ""
      },
      "title": {
        "en": "Drop diagnosis",
        "ru": "Диагноз просадки"
      },
      "with": {
        "site_url": "{{$inputs.site_url}}",
        "project_passport_path": "{{$inputs.project_passport_path}}"
      },
      "out": {
        "status": "string",
        "diagnosis_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 90
      }
    },
    {
      "id": "refresh",
      "type": "subworkflow",
      "workflow": "seo-page-refresh",
      "skip_when": "route.refresh_due != true",
      "skip_out": {
        "status": "skipped",
        "diagnosis_path": ""
      },
      "title": {
        "en": "Page refresh",
        "ru": "Обновление страниц"
      },
      "with": {
        "site_url": "{{$inputs.site_url}}",
        "url_list": "{{route.signals}}"
      },
      "out": {
        "status": "string",
        "diagnosis_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 120
      }
    },
    {
      "id": "structure",
      "type": "subworkflow",
      "workflow": "seo-structure-audit",
      "skip_when": "route.structure_due != true",
      "skip_out": {
        "status": "skipped",
        "report_path": ""
      },
      "title": {
        "en": "Structure link boost",
        "ru": "Линк-буст структуры"
      },
      "with": {
        "site_url": "{{$inputs.site_url}}",
        "mode": "link_boost",
        "project_passport_path": "{{$inputs.project_passport_path}}"
      },
      "out": {
        "status": "string",
        "report_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 90
      }
    },
    {
      "id": "tech",
      "type": "subworkflow",
      "workflow": "seo-tech-audit",
      "skip_when": "route.tech_due != true",
      "skip_out": {
        "status": "skipped",
        "backlog_path": ""
      },
      "title": {
        "en": "Tech audit",
        "ru": "Техаудит"
      },
      "with": {
        "site_url": "{{$inputs.site_url}}",
        "project_passport_path": "{{$inputs.project_passport_path}}"
      },
      "out": {
        "status": "string",
        "backlog_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 120
      }
    },
    {
      "id": "release_check",
      "type": "subworkflow",
      "workflow": "seo-release",
      "skip_when": "route.release_due != true",
      "skip_out": {
        "status": "done",
        "index_status_path": ""
      },
      "title": {
        "en": "Due index check",
        "ru": "Проверка индексации по сроку"
      },
      "with": {
        "mode": "index_check",
        "items": "{{$inputs.release_items}}"
      },
      "out": {
        "status": "string",
        "index_status_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 60
      }
    },
    {
      "id": "ai_vis",
      "type": "subworkflow",
      "workflow": "seo-ai-visibility",
      "skip_when": "route.ai_visibility_due != true",
      "skip_out": {
        "status": "skipped",
        "matrix_path": ""
      },
      "title": {
        "en": "AI visibility recheck",
        "ru": "Перепроверка видимости в AI"
      },
      "with": {
        "site_url": "{{$inputs.site_url}}",
        "mode": "recheck"
      },
      "out": {
        "status": "string",
        "matrix_path": "string"
      },
      "guards": {
        "maxVisits": 1,
        "timeoutMin": 120
      }
    },
    {
      "id": "report",
      "type": "action",
      "action": "fs.write",
      "path": ".agents/seo/monitor/{{date}}/",
      "files": [
        "weekly-report.md",
        "queue.json",
        "anomalies.json",
        "recommendations.md"
      ],
      "note": "weekly-report.md: changes, the scored queue, the follow-up graphs this run started (seo-drop-diagnosis, seo-page-refresh, seo-structure-audit, seo-tech-audit), wave-3 recommendations and the SEO Change Log update; backtest wins/losses, AI watch delta",
      "out": {
        "report_path": "string"
      }
    },
    {
      "id": "done",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "done",
        "report_path": "report.report_path",
        "queue_path": "queue.queue_path",
        "recommendations": "route.recommendations"
      }
    },
    {
      "id": "blocked",
      "type": "action",
      "action": "emit",
      "map": {
        "status": "blocked"
      }
    }
  ],
  "edges": [
    {
      "from": "pull",
      "to": "tech_watch",
      "pass": "artifact"
    },
    {
      "from": "tech_watch",
      "to": "anomalies",
      "pass": "artifact"
    },
    {
      "from": "queue",
      "to": "links_review",
      "pass": "artifact"
    },
    {
      "from": "links_review",
      "to": "cadence",
      "pass": "artifact"
    },
    {
      "from": "route",
      "to": "drop",
      "pass": "artifact",
      "when": "route.status != 'block'"
    },
    {
      "from": "route",
      "to": "blocked",
      "pass": "artifact"
    },
    {
      "from": "tech",
      "to": "release_check",
      "pass": "artifact"
    },
    {
      "from": "report",
      "to": "done",
      "pass": "artifact"
    },
    {
      "from": "drop",
      "to": "refresh",
      "pass": "artifact"
    },
    {
      "from": "refresh",
      "to": "structure",
      "pass": "artifact"
    },
    {
      "from": "structure",
      "to": "tech",
      "pass": "artifact"
    },
    {
      "from": "anomalies",
      "to": "pulse_backtest",
      "pass": "artifact"
    },
    {
      "from": "pulse_backtest",
      "to": "pulse_rules",
      "pass": "artifact"
    },
    {
      "from": "pulse_rules",
      "to": "queue",
      "pass": "artifact"
    },
    {
      "from": "cadence",
      "to": "ai_watch",
      "pass": "artifact"
    },
    {
      "from": "ai_watch",
      "to": "route",
      "pass": "artifact"
    },
    {
      "from": "release_check",
      "to": "ai_vis",
      "pass": "artifact"
    },
    {
      "from": "ai_vis",
      "to": "report",
      "pass": "artifact"
    }
  ],
  "test": {
    "id": "sm-1",
    "sim": {
      "input": {
        "site_url": "https://example.ru",
        "period": "weekly",
        "link_campaign": false
      },
      "stubs": {
        "pull": {
          "pull_path": "pull/",
          "urls": 320
        },
        "tech_watch": {
          "watch_path": "watch.md",
          "alerts": []
        },
        "anomalies": {
          "anomalies_path": "anomalies.json",
          "buckets": 2
        },
        "queue": {
          "queue_path": "queue.json",
          "queued": 5
        },
        "route": {
          "status": "pass",
          "signals": [],
          "recommendations": [
            "seo-trust: quarterly eeat"
          ],
          "drop_due": false,
          "refresh_due": false,
          "structure_due": false,
          "tech_due": false,
          "release_due": false,
          "ai_visibility_due": false
        },
        "report": {
          "report_path": ".agents/seo/monitor/2026-11-05/weekly-report.md"
        },
        "pulse_backtest": {
          "backtest_path": "backtest.json",
          "wins": 2,
          "losses": 0,
          "confounded_windows": 1
        },
        "pulse_rules": {
          "drop_signal": false,
          "seasonality": false,
          "striking_distance": 14,
          "rules_path": "rules.json"
        }
      },
      "expect_path": [
        "pull",
        "tech_watch",
        "anomalies",
        "pulse_backtest",
        "pulse_rules",
        "queue",
        "links_review",
        "cadence",
        "ai_watch",
        "route",
        "drop",
        "refresh",
        "structure",
        "tech",
        "release_check",
        "ai_vis",
        "report",
        "done"
      ],
      "expect_outputs": [
        "status == 'done'",
        "report_path != ''"
      ],
      "expect_output": {
        "status": "done"
      },
      "variant_seasonal_no_drop": {
        "input": {
          "period": "monthly"
        },
        "stubs": {
          "pulse_rules": {
            "drop_signal": false,
            "seasonality": true,
            "striking_distance": 9,
            "rules_path": "rules.json"
          },
          "ai_watch": {
            "citation_share": 0.12,
            "citation_delta": -0.05,
            "watch_path": "ai-watch.json"
          },
          "route": {
            "status": "pass",
            "signals": [],
            "recommendations": [],
            "drop_due": false,
            "refresh_due": false,
            "structure_due": false,
            "tech_due": false,
            "release_due": false,
            "ai_visibility_due": true
          },
          "ai_vis": {
            "status": "done",
            "matrix_path": ".agents/seo/ai-visibility-matrix.json"
          }
        },
        "expect_path": [
          "pull",
          "tech_watch",
          "anomalies",
          "pulse_backtest",
          "pulse_rules",
          "queue",
          "links_review",
          "cadence",
          "ai_watch",
          "route",
          "drop",
          "refresh",
          "structure",
          "tech",
          "release_check",
          "ai_vis",
          "report",
          "done"
        ],
        "expect_output": {
          "status": "done"
        }
      }
    },
    "live": "еженедельный прогон по живому сайту после seo-project-intake",
    "note": "Tested on stubs. The monitor starts each wave-2 graph only when route marks it due; wave-3 graphs stay recommendations."
  },
  "goal_check": "artifact"
}
